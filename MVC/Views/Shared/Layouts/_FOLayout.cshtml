@{
    Layout = null;
    var title = (ViewData["Title"] ?? "Dashboard").ToString();
    /* ── Detect current language from culture cookie ── */
    var currentLang = "en";
    var cultureCookie = Context.Request.Cookies[".AspNetCore.Culture"];
    if (!string.IsNullOrEmpty(cultureCookie)) {
        var match = System.Text.RegularExpressions.Regex.Match(cultureCookie, @"c=(\w+)");
        if (match.Success) currentLang = match.Groups[1].Value;
    }
}
<!DOCTYPE html>
<html lang="@currentLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title — FarmBridge FO</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdn-uicons.flaticon.com/2.6.0/uicons-regular-rounded/css/uicons-regular-rounded.css" />
    <link rel="stylesheet" href="https://cdn-uicons.flaticon.com/2.6.0/uicons-solid-rounded/css/uicons-solid-rounded.css" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://kendo.cdn.telerik.com/2023.1.117/styles/kendo.common.min.css" rel="stylesheet" />
    <link href="https://kendo.cdn.telerik.com/2023.1.117/styles/kendo.default.min.css" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/layouts/fo_layout.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>
<body data-role="FieldOfficer" data-title="@title">

    <!-- Sidebar -->
    <nav class="fo-sidebar" id="foSidebar">
        <div class="fo-sidebar-logo">
            <img src="/Logo/Logo_Without_Bg.png" alt="FarmBridge" />
            <span class="fo-sidebar-name"><span style="color: #1b5e19;">Farm</span><span style="color: #2b6f87;">Bridge</span></span>
        </div>
        <div class="fo-role-badge">Field Officer</div>
        <ul class="fo-nav" id="foNav"></ul>
        <div class="fo-sidebar-foot">
            <a href="/Auth/Logout" class="fo-nav-link fo-logout">
                <i class="fi fi-rr-exit"></i>
                <span data-i18n="nav_logout">Logout</span>
            </a>
        </div>
    </nav>

    <!-- Main -->
    <div class="fo-main" id="foMain">

        <!-- Topbar -->
        <header class="fo-topbar" id="foTopbar">
            <div class="fo-topbar-left">
                <button class="fo-menu-btn" id="foMenuBtn" onclick="toggleFoDrawer()" aria-label="Menu">
                    <i class="fi fi-rr-bars-staggered"></i>
                </button>
                <h1 class="fo-page-title" id="foPageTitle">@title</h1>
            </div>
            <div class="fo-topbar-right">
                <!-- Language Switcher -->
                <div class="fb-lang-switcher">
                    <button class="fo-action-btn fb-lang-btn" onclick="toggleLangDropdown(event)" aria-label="Language">
                        <i class="fi fi-rr-globe"></i>
                    </button>
                    <div class="fb-lang-dropdown">
                        <button class="fb-lang-option" data-lang="en" onclick="switchLang('en')">🇬🇧 English</button>
                        <button class="fb-lang-option" data-lang="hi" onclick="switchLang('hi')">🇮🇳 हिंदी</button>
                        <button class="fb-lang-option" data-lang="gu" onclick="switchLang('gu')">🇮🇳 ગુજરાતી</button>
                    </div>
                </div>
                <button class="fo-action-btn" id="foBellBtn" onclick="toggleFoNotif(event)" aria-label="Notifications">
                    <i class="fi fi-rr-bell"></i>
                    <span class="fo-dot" id="foBellDot" hidden></span>
                </button>
                <div class="fo-avatar" onclick="location.href='/FieldOfficer/Profile'" title="Profile">F</div>
            </div>
        </header>

        <!-- Content -->
        <main class="fo-content">
            @RenderBody()
        </main>
    </div>

    <!-- Mobile overlay -->
    <div class="fo-overlay" id="foOverlay" onclick="toggleFoDrawer()"></div>

    <!-- Mobile drawer -->
    <div class="fo-drawer" id="foDrawer">
        <div class="fo-drawer-head">
            <img src="/Logo/Logo_Without_Bg.png" alt="FarmBridge" />
            <span><span style="color: #1b5e19;">Farm</span><span style="color: #2b6f87;">Bridge</span></span>
            <button class="fo-drawer-close" onclick="toggleFoDrawer()"><i class="fi fi-rr-cross-small"></i></button>
        </div>
        <div class="fo-role-badge-mobile">Field Officer</div>
        <ul class="fo-drawer-nav" id="foDrawerNav"></ul>
        <div class="fo-drawer-foot">
            <a href="/Auth/Logout" class="fo-logout-mobile">
                <i class="fi fi-rr-exit"></i> <span data-i18n="nav_logout">Logout</span>
            </a>
        </div>
    </div>

    <!-- Bottom nav (mobile) -->
    <nav class="fo-bottom-nav" id="foBottomNav" aria-label="Navigation"></nav>

    <!-- Notification drawer -->
    <div class="fo-notif" id="foNotif">
        <div class="fo-notif-header">
            <span data-i18n="nav_notifications">Notifications</span>
            <button onclick="toggleFoNotif(event)"><i class="fi fi-rr-cross-small"></i></button>
        </div>
        <div class="fo-notif-actions">
            <small><span id="foUnread">0</span> <span data-i18n="notif_unread">unread</span></small>
            <div style="display:flex; gap: 12px; align-items:center;">
                <button onclick="foMarkAllRead()" data-i18n="notif_mark_all">Mark all read</button>
                <button onclick="foClearAll()" style="color: #ff6b6b;" data-i18n="notif_clear_all">Clear all</button>
            </div>
        </div>
        <div class="fo-notif-list" id="foNotifList"></div>
    </div>

    <!-- Toast -->
    <div class="fo-toasts" id="foToasts"></div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://kendo.cdn.telerik.com/2023.1.117/js/kendo.all.min.js"></script>

    <script>
        window.USER_ROLE    = 'FieldOfficer';
        window.API_BASE     = 'http://localhost:5020/api/FieldOfficer';
        window.CURRENT_LANG = '@currentLang';
    </script>

    <script src="~/js/layouts/platform_i18n.js" asp-append-version="true"></script>
    <script src="~/js/layouts/fo_layout.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>

