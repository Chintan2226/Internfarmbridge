@using Microsoft.Extensions.Localization
@inject IStringLocalizer<MVC.Controllers.LanguageController> Localizer
@{
    Layout = null;
    var title = (ViewData["Title"] ?? "Dashboard").ToString();
    var currentLang = "en";
    var cultureCookie = Context.Request.Cookies[".AspNetCore.Culture"];
    if (!string.IsNullOrEmpty(cultureCookie)) {
        var m = System.Text.RegularExpressions.Regex.Match(cultureCookie, @"c=(\w+)");
        if (m.Success) currentLang = m.Groups[1].Value;
    }
}
<!DOCTYPE html>
<html lang="@currentLang">
<head>
    <link rel="icon" type="image/png" href="~/Logo/Logo_Without_Bg.png" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title — FarmBridge Field Officer</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdn-uicons.flaticon.com/2.6.0/uicons-regular-rounded/css/uicons-regular-rounded.css" />
    <link rel="stylesheet" href="https://cdn-uicons.flaticon.com/2.6.0/uicons-solid-rounded/css/uicons-solid-rounded.css" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/kendo/kendo.default-v2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/layouts/fo_layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layouts/fb_kendo_premium.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layouts/fb_skeleton.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)

    <script>
        window.fbServerTranslations = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Localizer.GetAllStrings(includeParentCultures: true).ToDictionary(s => s.Name, s => s.Value)
        ));
    </script>
</head>
<body data-role="FieldOfficer" data-title="@title">

    <!-- Sidebar -->
    <nav class="fo-sidebar" id="foSidebar">
        <div class="fo-sidebar-logo">
            <img src="/Logo/Logo_Without_Bg.png" alt="FarmBridge" />
            <span class="fo-sidebar-name">
                <span style="color:#1b5e19;">Farm</span><span style="color:#3b82f6;">Bridge</span>
            </span>
        </div>
        <div class="fo-role-badge">Field Officer</div>
        <ul class="fo-nav" id="foNav"></ul>
        <div class="fo-sidebar-foot">
            <a href="javascript:void(0)" onclick="foLogout()" class="fo-nav-link fo-logout" title="Logout">
                <i class="fi fi-rr-exit"></i>
                <span>Logout</span>
            </a>
        </div>
    </nav>

    <!-- Main -->
    <div class="fo-main" id="foMain">

        <!-- Topbar -->
        <header class="fo-topbar" id="foTopbar">
            <div class="fo-topbar-left">
                <button class="fo-menu-btn" id="foMenuBtn" aria-label="Menu">
                    <i class="fi fi-rr-bars-staggered"></i>
                </button>
                <h1 class="fo-page-title" id="foPageTitle">@title</h1>
            </div>
            <div class="fo-topbar-right">
                <button class="fo-action-btn" id="foBellBtn" aria-label="Notifications">
                    <i class="fi fi-rr-bell"></i>
                    <span class="fo-dot" id="foBellDot" hidden></span>
                </button>
                <div class="fo-avatar" id="foAvatar" onclick="location.href='/FieldOfficer/Profile'" title="My Profile"
                     style="overflow:hidden; position:relative;">
                    <img id="foAvatarImg" src="" alt=""
                         style="display:none; width:100%; height:100%; object-fit:cover; position:absolute; inset:0; border-radius:50%;" />
                    <span id="foAvatarLetter"
                          style="display:flex; align-items:center; justify-content:center; width:100%; height:100%; font-size:15px; font-weight:700; color:#fff;">F</span>
                </div>
            </div>
        </header>

        <!-- Content -->
        <main class="fo-content">
            @RenderBody()
        </main>
    </div>

    <!-- Mobile overlay -->
    <div class="fo-overlay" id="foOverlay"></div>

    <!-- Mobile drawer -->
    <div class="fo-drawer" id="foDrawer">
        <div class="fo-drawer-head">
            <img src="/Logo/Logo_Without_Bg.png" alt="FarmBridge" />
            <span><span style="color:#a7f3d0;">Farm</span><span style="color:#93c5fd;">Bridge</span></span>
            <button class="fo-drawer-close" id="foDrawerClose"><i class="fi fi-rr-cross-small"></i></button>
        </div>
        <div class="fo-role-badge-mobile">Field Officer</div>
        <ul class="fo-drawer-nav" id="foDrawerNav"></ul>
        <div class="fo-drawer-foot">
            <a href="javascript:void(0)" onclick="foLogout()" class="fo-logout-mobile">
                <i class="fi fi-rr-exit"></i> <span>Logout</span>
            </a>
        </div>
    </div>

    <!-- Notification drawer -->
    <div class="fo-notif" id="foNotif">
        <div class="fo-notif-header">
            <span>Notifications</span>
            <button id="foNotifClose"><i class="fi fi-rr-cross-small"></i></button>
        </div>
        <div class="fo-notif-actions">
            <small><span id="foUnread">0</span> unread</small>
            <div style="display:flex; gap:12px; align-items:center;">
                <button onclick="foMarkAllRead()">Mark all read</button>
                <button onclick="foClearAll()" style="color:#ff6b6b;">Clear all</button>
            </div>
        </div>
        <div class="fo-notif-list" id="foNotifList"></div>
    </div>

    <!-- Toast -->
    <div class="fo-toasts" id="foToasts"></div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/kendo/kendo.all.min.js" asp-append-version="true"></script>

    <script>
        // ── Auth Helpers ──────────────────────────────────────────────
        window.USER_ROLE = 'FieldOfficer';
        window.API_BASE  = 'http://localhost:5020/api/FieldOfficer';

        function getFoToken() {
            var m = document.cookie.match(/(?:^|;\s*)authToken=([^;]+)/);
            return m ? decodeURIComponent(m[1]) : null;
        }

        function parseJwt(token) {
            try { return JSON.parse(atob(token.split('.')[1])); } catch (e) { return null; }
        }

        var _foToken = getFoToken();
        var _foDecoded = _foToken ? parseJwt(_foToken) : null;

        window.FO_ID   = _foDecoded ? parseInt(_foDecoded.fo_id || _foDecoded.officer_id || 0) : 0;
        window.FO_NAME = _foDecoded && _foDecoded.full_name ? _foDecoded.full_name : '';

        if (!getFoToken()) { window.location.href = '/StaffAuth/Login'; }

        // ── Shared AJAX helpers used by page scripts ──────────────────
        window.foApiUrl = function(path) {
            return window.API_BASE + path;
        };

        window.handleFoUnauthorized = function(xhr) {
            if (!xhr || xhr.status === 401 || xhr.status === 403 || !getFoToken()) {
                window.location.href = '/StaffAuth/Login';
                return true;
            }
            return false;
        };

        window.showFoLoadFailedAlert = function(section) {
            console.error('Failed to load: ' + section);
        };

        window.foSuccess = function(title, msg) {
            if (typeof Swal !== 'undefined') {
                Swal.fire({ icon: 'success', title: title, text: msg, timer: 2500, showConfirmButton: false });
            } else { alert(title + ': ' + msg); }
        };
        window.foError = function(title, msg) {
            if (typeof Swal !== 'undefined') {
                Swal.fire({ icon: 'error', title: title, text: msg });
            } else { alert('Error: ' + msg); }
        };
        window.foWarning = function(title, msg) {
            if (typeof Swal !== 'undefined') {
                Swal.fire({ icon: 'warning', title: title, text: msg });
            } else { alert(msg); }
        };
        window.foConfirm = function(title, msg, confirmText) {
            if (typeof Swal !== 'undefined') {
                return Swal.fire({
                    icon: 'question', title: title, text: msg,
                    showCancelButton: true,
                    confirmButtonText: confirmText || 'Confirm',
                    confirmButtonColor: '#3b82f6'
                }).then(r => r.isConfirmed);
            }
            return Promise.resolve(confirm(msg));
        };

        // ── Topbar avatar ─────────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', function () {
            var letter = (window.FO_NAME || 'F').charAt(0).toUpperCase();
            var avatarLetter = document.getElementById('foAvatarLetter');
            var avatarImg    = document.getElementById('foAvatarImg');
            if (avatarLetter) avatarLetter.textContent = letter;

            // Drawer toggle
            var menuBtn    = document.getElementById('foMenuBtn');
            var drawer     = document.getElementById('foDrawer');
            var overlay    = document.getElementById('foOverlay');
            var drawerClose= document.getElementById('foDrawerClose');
            var notifBtn   = document.getElementById('foBellBtn');
            var notifPanel = document.getElementById('foNotif');
            var notifClose = document.getElementById('foNotifClose');

            function toggleDrawer(e) {
                if (e) { e.preventDefault(); e.stopPropagation(); }
                if (drawer) drawer.classList.toggle('open');
                if (overlay) overlay.classList.toggle('open');
            }
            function closeDrawer() {
                if (drawer) drawer.classList.remove('open');
                if (overlay) overlay.classList.remove('open');
            }
            function toggleNotif(e) {
                if (e) e.stopPropagation();
                if (notifPanel) notifPanel.classList.toggle('open');
            }

            if (menuBtn)    menuBtn.addEventListener('click', toggleDrawer);
            if (overlay)    overlay.addEventListener('click', closeDrawer);
            if (drawerClose) drawerClose.addEventListener('click', closeDrawer);
            if (notifBtn)   notifBtn.addEventListener('click', toggleNotif);
            if (notifClose) notifClose.addEventListener('click', toggleNotif);

            document.addEventListener('click', function(e) {
                if (notifPanel && notifPanel.classList.contains('open') &&
                    !notifPanel.contains(e.target) && !notifBtn?.contains(e.target)) {
                    notifPanel.classList.remove('open');
                }
            });
        });

        window.foLogout = function () {
            document.cookie = 'authToken=; path=/; expires=Thu, 01 Jan 1970 00:00:00 UTC; SameSite=Strict';
            localStorage.clear();
            sessionStorage.clear();
            window.location.href = '/StaffAuth/Login';
        };
    </script>

    <script src="~/js/layouts/fo_layout.js" asp-append-version="true"></script>
    <script src="~/js/layouts/fb_skeleton_helper.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
