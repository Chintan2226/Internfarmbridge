@using Microsoft.Extensions.Localization
@inject IStringLocalizer<MVC.Controllers.LanguageController> Localizer
@{
    Layout = null;
    var role = "Vendor";
    var title = (ViewData["Title"] ?? "Dashboard").ToString();
    // Lang cookie
    var currentLang = "en";
    var cultureCookie = Context.Request.Cookies[".AspNetCore.Culture"];
    if (!string.IsNullOrEmpty(cultureCookie)) {
        var match = System.Text.RegularExpressions.Regex.Match(cultureCookie, @"c=(\w+)");
        if (match.Success) currentLang = match.Groups[1].Value;
    }
}
<!DOCTYPE html>
<html lang="@currentLang">
<head>
    <link rel="icon" type="image/png" href="~/Logo/Logo_Without_Bg.png" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title — FarmBridge</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=Baloo+2:wght@400;600;700;800&family=Playfair+Display:wght@400;700;900&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdn-uicons.flaticon.com/2.6.0/uicons-regular-rounded/css/uicons-regular-rounded.css" />
    <link rel="stylesheet" href="https://cdn-uicons.flaticon.com/2.6.0/uicons-solid-rounded/css/uicons-solid-rounded.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://kendo.cdn.telerik.com/2023.1.117/styles/kendo.common.min.css" rel="stylesheet" />
    <link href="https://kendo.cdn.telerik.com/2023.1.117/styles/kendo.default.min.css" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/layouts/vendor_layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/vendor/vendor_dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layouts/fb_kendo_premium.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layouts/fb_skeleton.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

    @RenderSection("Styles", required: false)
    
    
<link rel="stylesheet" href="~/css/pages/shared/layouts__vendorlayout.css" asp-append-version="true" />


    <script src="https://cdn.lordicon.com/lordicon.js"></script>
    <script>
        window.API_BASE_URL = 'http://localhost:5020/api/Vendor';
        window.USER_ROLE = '@role';
        window.API_BASE = `http://localhost:5020/api/@role`;
        window.CURRENT_LANG = '@currentLang';
        window.fbServerTranslations = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Localizer.GetAllStrings(includeParentCultures: true).ToDictionary(s => s.Name, s => s.Value)
        ));
    </script>
    <link rel="stylesheet" href="~/css/layouts/fb_kendo_premium.css" asp-append-version="true" />
</head>
<body data-role="@role" data-title="@title">

    <div aria-hidden="true" style="position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden;">
        <div style="position:absolute;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(168,230,160,0.18) 0%,transparent 70%);top:-80px;left:-100px;filter:blur(40px);"></div>
        <div style="position:absolute;width:350px;height:350px;border-radius:50%;background:radial-gradient(circle,rgba(181,221,245,0.12) 0%,transparent 70%);bottom:10%;right:-80px;filter:blur(40px);"></div>
    </div>

    <nav class="fv-sidebar" id="fvSidebar">
        <div class="fv-sidebar-logo">
            <img src="/Logo/Logo_Without_Bg.png" alt="FarmBridge" />
            <span class="fv-sidebar-name"><span style="color: #1b5e19;">Farm</span><span style="color: #2b6f87;">Bridge</span></span>
        </div>
        <div class="fv-role-badge" id="fvRoleBadge">@role</div>
        <ul class="fv-nav" id="fvNav">
        @{
            var path = Context.Request.Path.ToString().ToLower();
        }

        <ul class="fv-nav">
            <li>
                <a href="/Vendor/Catalog" class="fv-nav-link @(path.Contains("/vendor/catalog") ? "active" : "")">
                    <i class="fi fi-rr-shop"></i>
                    <span data-i18n="nav_crop_catalog">Crops</span>
                </a>
            </li>

            <li>
                <a href="/Vendor/Orders" class="fv-nav-link @(path.Contains("/vendor/orders") ? "active" : "")">
                    <i class="fi fi-rr-box-alt"></i>
                    <span data-i18n="nav_orders">Orders</span>
                </a>
            </li>

            <li>
                <a href="/Vendor/Dashboard" class="fv-nav-link @(path.Contains("/vendor/dashboard") ? "active" : "")">
                    <i class="fi fi-rr-apps"></i>
                    <span data-i18n="nav_dashboard">Dashboard</span>
                </a>
            </li>

            <li>
                <a href="/Vendor/Payments" class="fv-nav-link @(path.Contains("/vendor/payments") ? "active" : "")">
                    <i class="fi fi-rr-credit-card"></i>
                    <span data-i18n="nav_payments">Payments</span>
                </a>
            </li>

            <li>
                <a href="/Vendor/Profile" class="fv-nav-link @(path.Contains("/vendor/profile") ? "active" : "")">
                    <i class="fi fi-rr-user"></i>
                    <span data-i18n="nav_profile">Profile</span>
                </a>
            </li>
        </ul>
        <div class="fv-sidebar-foot">
            <a href="javascript:void(0)" class="fv-nav-link fv-logout" onclick="logoutVendor()">
                <i class="fi fi-rr-exit"></i>
                <span data-i18n="nav_logout">Logout</span>
            </a>
</div>
    </nav>

    <div class="fv-main" id="fvMain">
        <header class="fv-topbar" id="fvTopbar">
            <div class="fv-topbar-left">
                <button class="fv-menu-btn" id="fvMenuBtn" onclick="toggleDrawer()" aria-label="Menu">
                    <i class="fi fi-rr-bars-staggered"></i>
                </button>
                @{
                    var titleKey = "title_dashboard";
                    if (path.Contains("/vendor/catalog")) titleKey = "title_catalog";
                    else if (path.Contains("/vendor/orders")) titleKey = "title_orders";
                    else if (path.Contains("/vendor/payments")) titleKey = "title_payments";
                    else if (path.Contains("/vendor/profile")) titleKey = "title_profile";
                }
                <h1 class="fv-page-title" data-i18n="@titleKey">@title</h1>
            </div>
            <div class="fv-topbar-right">
                <div class="fb-lang-switcher">
                    <button class="fv-action-btn fb-lang-btn" onclick="toggleLangDropdown(event)" aria-label="Language">
                        <i class="fi fi-rr-globe"></i>
                    </button>
                    <div class="fb-lang-dropdown">
                        <button class="fb-lang-option" data-lang="en" onclick="switchLang('en')">English</button>
                        <button class="fb-lang-option" data-lang="hi" onclick="switchLang('hi')">हिन्दी</button>
                        <button class="fb-lang-option" data-lang="gu" onclick="switchLang('gu')">ગુજરાતી</button>
                    </div>
                </div>
                <button class="fv-action-btn" id="fvBellBtn" onclick="toggleNotifDrawer(event)" aria-label="Notifications">
                    <i class="fi fi-rr-bell"></i>
                    <span id="fvBellBadge" class="nav-badge" style="display:none">0</span>
                </button>

                @if (role == "Vendor") {
                    <a href="/Vendor/Wishlist" class="fv-action-btn" aria-label="Wishlist">
                        <i class="fi fi-rr-heart"></i>
                        <span id="globalWishlistCount" class="nav-badge bg-wishlist">0</span>
                    </a>

                    <a href="/Vendor/Checkout" class="fv-action-btn" aria-label="Cart">
                        <i class="fi fi-rr-shopping-cart"></i>
                        <span id="globalCartCount" class="nav-badge bg-cart">0</span>
                    </a>
                }
                
                <div class="fv-avatar" id="fvAvatar" onclick="location.href='/Vendor/Profile'" title="Profile">
                    V
                </div>
            </div>
        </header>

        <main class="fv-content">
            @RenderBody()
        </main>
    </div>

    <div class="cart-sidebar" id="cartSidebar">...</div>
    <div class="wishlist-sidebar" id="wishlistSidebar">...</div>
    <div class="fv-drawer" id="fvDrawer">...</div>
    
    <div class="fv-notif" id="fvNotif">
        <div class="fv-notif-header">
            <span data-i18n="nav_notifications">Notifications</span>
            <button onclick="toggleNotifDrawer(event)">✕</button>
        </div>
        <div class="fv-notif-actions">
            <small><span id="fvUnreadCountText">0</span> <span data-i18n="notif_unread">unread</span></small>
            <div style="display:flex; gap: 12px; align-items:center;">
                <button onclick="fvMarkAllRead()" data-i18n="notif_mark_all">Mark all read</button>
                <button onclick="fvClearAll()" style="color: #ff6b6b; text-decoration: none;" data-i18n="notif_clear_all">Clear all</button>
            </div>
        </div>
        <div class="fv-notif-tabs">
            <button class="active" onclick="fvTab('all', this)" data-i18n="notif_tab_all">All</button>
            <button onclick="fvTab('unread', this)"><span data-i18n="notif_tab_unread">Unread</span> <span id="fvUnreadBadgeNum">0</span></button>
        </div>
        <div class="fv-notif-list" id="fvNotifList"></div>
    </div>

    <div class="fv-overlay" id="fvOverlay" onclick="toggleDrawer()"></div>
    <div class="fv-toasts" id="fvToasts"></div>
    <div class="fb-toast-container" id="fbToastContainer"></div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://kendo.cdn.telerik.com/2023.1.117/js/kendo.all.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="~/js/Vendor/vendor_dashboard.js" asp-append-version="true"></script>
    <script src="~/js/Vendor/vendor_layout.js" asp-append-version="true"></script>
    <script src="~/js/layouts/platform_i18n.js" asp-append-version="true"></script>
    <script src="~/js/layouts/fb_skeleton_helper.js" asp-append-version="true"></script>

    <script>
        // Premium Notification Helper
        window.fbNotify = function(options) {
            const { title, message, icon = 'success', type = 'toast', timer = 3000 } = options;
            
            if (type === 'toast') {
                const Toast = Swal.mixin({
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: timer,
                    timerProgressBar: true,
                    didOpen: (toast) => {
                        toast.addEventListener('mouseenter', Swal.stopTimer)
                        toast.addEventListener('mouseleave', Swal.resumeTimer)
                    }
                });
                Toast.fire({
                    icon: icon,
                    title: message || title
                });
            } else {
                Swal.fire({
                    title: title,
                    text: message,
                    icon: icon,
                    confirmButtonColor: '#15803d',
                    confirmButtonText: 'OK',
                    borderRadius: '16px',
                    customClass: {
                        popup: 'glass-morphism',
                        title: 'premium-title'
                    }
                });
            }
        };

        function logoutVendor() {
            Swal.fire({
                title: window.fbT ? fbT('secure_logout') : 'Logout?',
                text: "Are you sure you want to end your session?",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#15803d',
                cancelButtonColor: '#94a3b8',
                confirmButtonText: 'Yes, Logout',
                borderRadius: '16px'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.cookie = "authToken=; expires=Thu, 01 Jan 1970 UTC; path=/;";
                    localStorage.clear();
                    sessionStorage.clear();
                    window.location.href = "/Vendor/Login";
                }
            });
        }

        $(document).ready(() => {
            syncGlobalBadges();
            window.addEventListener('storage', syncGlobalBadges);
            
            try {
                const token = getCookie("authToken");
                if(token) {
                    const decoded = parseJwtVendor(token);
                    if(decoded && decoded.full_name) {
                        const fvAvatar = document.getElementById('fvAvatar');
                        if (fvAvatar) {
                            fvAvatar.textContent = decoded.full_name.charAt(0).toUpperCase();
                            fvAvatar.title = decoded.full_name;
                        }
                    }
                }
            } catch(e) { console.warn("Avatar parsing fail", e); }
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>

