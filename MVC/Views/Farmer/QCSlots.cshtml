@{
    ViewData["Title"] = "QC Slot Booking";
    ViewData["UserRole"] = "Farmer";
    Layout = "~/Views/Shared/Layouts/_FarmerLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/layouts/dashboard_shared.css" asp-append-version="true" />
    <link href="~/css/Farmer/qclots.css" rel="stylesheet" asp-append-version="true" />
}

<div class="db-wrap">

    <!-- Page Header -->
    <div style="display:flex; justify-content:space-between; align-items:center;">
        <div>
            <h2 style="margin:0; font-size:22px; font-weight:800; color:#0a2108; display:flex; align-items:center; gap:10px;">
                <i class="fi fi-sr-calendar-check" style="color:#10b981;"></i> Quality Check Slots
            </h2>
            <p style="margin:4px 0 0; font-size:13px; color:#5a7257;">Schedule and manage your crop quality inspections</p>
        </div>
        <button id="btnOpenQCWindow" class="premium-btn">
            <i class="fi fi-rr-calendar-plus"></i> Request Appointment
        </button>
    </div>

    <!-- KPI Cards -->
    <div class="kpi-grid qc-kpi-grid">
        <div class="kpi-card emerald-card">
            <div class="kpi-top">
                <div class="kpi-lbl">Upcoming Appts</div>
                <div class="kpi-icon"><i class="fi fi-sr-calendar"></i></div>
            </div>
            <div class="kpi-val fb-skeleton-text-inline" id="kpiUpcoming">0</div>
            <div class="kpi-sub">Next scheduled visits</div>
            <i class="fi fi-sr-calendar watermark"></i>
        </div>

        <div class="kpi-card gold-card">
            <div class="kpi-top">
                <div class="kpi-lbl">Awaiting Results</div>
                <div class="kpi-icon"><i class="fi fi-sr-hourglass-end"></i></div>
            </div>
            <div class="kpi-val fb-skeleton-text-inline" id="kpiAwaiting">0</div>
            <div class="kpi-sub">Tests in-progress</div>
            <i class="fi fi-sr-hourglass-end watermark"></i>
        </div>

        <div class="kpi-card farm-card">
            <div class="kpi-top">
                <div class="kpi-lbl">Total Passed</div>
                <div class="kpi-icon"><i class="fi fi-sr-badge-check"></i></div>
            </div>
            <div class="kpi-val fb-skeleton-text-inline" id="kpiTotalPassed">0</div>
            <div class="kpi-sub">Verified inventory</div>
            <i class="fi fi-sr-badge-check watermark"></i>
        </div>

        <div class="kpi-card fo-card">
            <div class="kpi-top">
                <div class="kpi-lbl">Premium Grade</div>
                <div class="kpi-icon"><i class="fi fi-sr-star"></i></div>
            </div>
            <div class="kpi-val fb-skeleton-text-inline" id="kpiGradeRate">0%</div>
            <div class="kpi-sub">A-Grade success rate</div>
            <i class="fi fi-sr-star watermark"></i>
        </div>
    </div>

    <!-- Appointment History -->
    <div class="glass-panel">
        <div style="margin-bottom:20px;">
            <h3 style="margin:0; font-size:16px; font-weight:700; color:#0a2108;">Appointment History</h3>
            <p style="margin:4px 0 0; font-size:12px; color:#5a7257;">Review your past and upcoming QC schedules</p>
        </div>
        <div class="kendo-widget-container">
            <div id="gridSkeleton" class="fb-skeleton" style="height: 300px; width: 100%; border-radius:12px;"></div>
            <div id="historyGrid" style="display: none;"></div>
        </div>
    </div>

</div>

<!-- QC Booking Window -->
<div id="qcBookWindow" class="qc-book-win">
    <form id="qcBookForm" autocomplete="off" class="premium-form-container">
        <div class="premium-form-body">

            <div class="premium-section">
                <div class="premium-section-header">
                    <div class="icon-wrap"><i class="fi fi-rr-building"></i></div>
                    <h4>Facility Selection</h4>
                </div>
                <div class="premium-row">
                    <div class="premium-col-12">
                        <label class="premium-lbl">Select Warehouse Facility <span class="req">*</span></label>
                        <select id="warehouseLocation">
                            <option value="">Select Nearest Warehouse...</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="premium-section">
                <div class="premium-section-header">
                    <div class="icon-wrap"><i class="fi fi-rr-seedling"></i></div>
                    <h4>Crop Details</h4>
                </div>
                <div class="premium-row">
                    <div class="premium-col-12">
                        <label class="premium-lbl">Select Active Crop Listing <span class="req">*</span></label>
                        <select id="cropListing">
                            <option value="">Select Crop for Inspection...</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="premium-section">
                <div class="premium-section-header">
                    <div class="icon-wrap"><i class="fi fi-rr-calendar"></i></div>
                    <h4>Appointment Schedule</h4>
                </div>
                <div class="premium-row">
                    <div class="premium-col-12">
                        <label class="premium-lbl">Select Inspection Date <span class="req">*</span></label>
                        <input id="slotDate" />
                    </div>
                </div>
                <div id="slotsContainer" class="premium-row mt-3 qc-hide-start">
                    <div class="premium-col-12">
                        <label class="premium-lbl">Available Inspection Slots <span class="req">*</span></label>
                        <div id="timeSlotGrid" class="slot-grid-layout"></div>
                    </div>
                </div>
            </div>

        </div>

        <div class="premium-modal-footer">
            <button type="button" id="btnCloseQCWindow" class="premium-btn-cancel">Cancel</button>
            <div class="premium-actions">
                <button type="button" id="confirmBookingBtn" class="premium-btn-publish" disabled>
                    <i class="fi fi-rr-check"></i> Confirm Booking
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/Farmer/qcslots.js" asp-append-version="true"></script>
}