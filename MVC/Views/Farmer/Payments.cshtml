@{
    ViewData["Title"] = "Payment Tracking & History";
    ViewData["UserRole"] = "Farmer";
    Layout = "~/Views/Shared/Layouts/_FarmerLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/layouts/dashboard_shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Farmer/payments.css" asp-append-version="true" />
}

<div class="db-wrap">

    <!-- Page Header -->
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
        <div>
            <h2 style="margin:0; font-size:22px; font-weight:800; color:#0a2108; display:flex; align-items:center; gap:10px;">
                <i class="fi fi-sr-wallet" style="color:#10b981;"></i> Financial Ledger
            </h2>
            <p style="margin:4px 0 0; font-size:13px; color:#5a7257;">Track your earnings, pending clearances, and transaction history</p>
        </div>
    </div>

    <!-- KPI Cards -->
    <div class="kpi-grid pay-kpi-grid">
        <div class="kpi-card emerald-card">
            <div class="kpi-top">
                <div class="kpi-lbl">Lifetime Earnings</div>
                <div class="kpi-icon"><i class="fi fi-sr-money-bill-wave"></i></div>
            </div>
            <div class="kpi-val" id="kpiLifetimeEarned">₹0</div>
            <div class="kpi-sub">
                <span class="kpi-trend up"><i class="fi fi-rr-check-double"></i> Total</span>
                Credited to your account
            </div>
            <i class="fi fi-sr-money-bill-wave watermark"></i>
        </div>

        <div class="kpi-card gold-card">
            <div class="kpi-top">
                <div class="kpi-lbl">Pending Clearance</div>
                <div class="kpi-icon"><i class="fi fi-sr-time-past"></i></div>
            </div>
            <div class="kpi-val" id="kpiPendingPay">₹0</div>
            <div class="kpi-sub">
                <span class="kpi-trend neutral"><i class="fi fi-rr-clock"></i> Processing</span>
                Awaiting final verification
            </div>
            <i class="fi fi-sr-time-past watermark"></i>
        </div>
    </div>

    <!-- Payments Grid -->
    <div class="glass-panel">
        <div style="margin-bottom:16px;">
            <h3 style="margin:0; font-size:16px; font-weight:700; color:#0a2108;">Transaction History</h3>
            <p style="margin:4px 0 0; font-size:12px; color:#5a7257;">Detailed breakdown of all your payments</p>
        </div>
        <div class="kendo-widget-container">
            <div id="gridSkeleton"></div>
            <div id="paymentsGrid" style="display: none;"></div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.7.1/jszip.min.js"></script>
    <script src="~/js/Farmer/payments.js" asp-append-version="true"></script>
    <script type="x/kendo-template" id="page-template">
      <div class="page-template">
        <div class="header">
          <div style="float: right">Page #: pageNum # of #: totalPages #</div>
          FarmBridge - Farmer Payment History
        </div>
      </div>
    </script>
}