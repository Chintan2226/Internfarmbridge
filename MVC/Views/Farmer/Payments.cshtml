@{
    ViewData["Title"] = "Payment Tracking & History";
    ViewData["UserRole"] = "Farmer";
    Layout = "~/Views/Shared/Layouts/_FarmerLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/layouts/dashboard_shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Farmer/payments.css" asp-append-version="true" />
}

<div class="db-wrap" style="gap: 20px; padding-bottom: 20px;">

    <div class="f-action-row" style="display: flex; justify-content: space-between; align-items: center;">
        <h2 style="font-size: 20px; font-weight: 700; color: #2e7d32; margin: 0;">Payment Clearances</h2>
    </div>

    <section>
        <div class="kpi-grid pay-kpi-grid">
            <div class="kpi-card">
                <div class="kpi-top">
                    <div class="kpi-lbl">Lifetime Earnings</div>
                    <div class="kpi-icon" style="background:var(--grad-farm);"><i class="fi fi-rr-wallet" style="color:white; font-size: 18px;"></i></div>
                </div>
                <div class="kpi-val" id="kpiLifetimeEarned">₹0</div>
                <div class="watermark"><i class="fi fi-rr-wallet"></i></div>
            </div>
            <div class="kpi-card">
                <div class="kpi-top">
                    <div class="kpi-lbl">Pending Clearance</div>
                    <div class="kpi-icon" style="background:var(--grad-vend);"><i class="fi fi-rr-time-fast" style="color:white; font-size: 18px;"></i></div>
                </div>
                <div class="kpi-val" id="kpiPendingPay">₹0</div>
                <div class="watermark"><i class="fi fi-rr-time-fast"></i></div>
            </div>
        </div>
    </section>

    <section>
        <div class="grid-card" style="padding: 20px;">
            <div class="grid-head" style="margin-bottom: 16px;">
                <div class="grid-title">Financial Ledger</div>
            </div>
            <div class="kendo-widget-container">
                <div id="paymentsGrid"></div>
            </div>
        </div>
    </section>

</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.7.1/jszip.min.js"></script>
    <script src="~/js/Farmer/payments.js" asp-append-version="true"></script>
    <script type="x/kendo-template" id="page-template">
      <div class="page-template">
        <div class="header">
          <div style="float: right">Page #: pageNum # of #: totalPages #</div>
          FarmBridge - Farmer Payment History
        </div>
      </div>
    </script>
}