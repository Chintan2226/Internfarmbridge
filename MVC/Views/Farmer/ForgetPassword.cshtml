@{
    ViewData["Title"] = "Recover Account - FarmBridge";
    Layout = null;
}

<link href="https://kendo.cdn.telerik.com/2022.1.119/styles/kendo.common.min.css" rel="stylesheet" />
<link href="https://kendo.cdn.telerik.com/2022.1.119/styles/kendo.default.min.css" rel="stylesheet" />
<link rel="stylesheet" href="~/css/farmer-auth.css" />

<div class="container-auth">
    <!-- Left Banner -->
    <div class="auth-banner">
        <div class="banner-logo">
            <img src="~/Logo/Logo_Without_Bg.png" alt="FarmBridge Logo" />
        </div>
        <h1 class="banner-title">Farmer Portal</h1>
        <p class="banner-description">Recover your account access to manage your listings and orders.</p>
        <div class="banner-features">
            <div class="feature-item">🌾 List your harvest</div>
            <div class="feature-item">🏭 Book warehouse slots</div>
            <div class="feature-item">💰 Track payments</div>
        </div>
    </div>

    <!-- Right Form Panel -->
    <div class="form-container">
        <div class="form-card">

            <!-- Step 1: Request OTP -->
            <div id="requestOtpSection">
                <h2>Forgot Password</h2>
                <p class="form-subtitle">Enter your registered email to receive a verification code.</p>

                <span id="notificationRequest"></span>
                <form id="requestOtpForm"></form>

                <div class="form-footer">
                    <p>Remember your password? <a href="/Farmer/Login">Sign In</a></p>
                    <div class="back-home">
                        <a href="/">← Back to Home</a>
                    </div>
                </div>
            </div>

            <!-- Step 2: Verify OTP + Set New Password -->
            <div id="resetPasswordSection" style="display: none;">
                <h2>Reset Password</h2>
                <p class="form-subtitle">Enter the OTP sent to your email and choose a new password.</p>

                <span id="notificationReset"></span>
                <form id="verifyResetForm"></form>

                <div class="form-footer">
                    <div class="back-home">
                        <a href="#" id="backToStep1">← Use a different email</a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://kendo.cdn.telerik.com/2022.1.119/js/jquery.min.js"></script>
    <script src="https://kendo.cdn.telerik.com/2022.1.119/js/kendo.all.min.js"></script>

    <script>
        // Read query params (used when redirected from Login page inline flow)
        const urlParams = new URLSearchParams(window.location.search);
        const prefillEmail = urlParams.get("email") || "";
        const prefillOtp = urlParams.get("otp") || "";

        $(document).ready(function () {
            initNotifications();
            buildRequestForm();
            buildResetForm();

            // If redirected with email + OTP prefilled, jump straight to step 2
            if (prefillEmail && prefillOtp) {
                $("#requestOtpSection").hide();
                $("#resetPasswordSection").show();
            }

            $("#backToStep1").on("click", function (e) {
                e.preventDefault();
                $("#resetPasswordSection").slideUp(300, function () {
                    $("#requestOtpSection").slideDown(300);
                });
            });
        });

        function initNotifications() {
            const config = {
                allowHideAfter: 4000,
                width: 320,
                position: { pinned: true, top: 30, right: 30 }
            };
            $("#notificationRequest").kendoNotification(config);
            $("#notificationReset").kendoNotification(config);
        }

        // ── Step 1: Request OTP ───────────────────────────
        function buildRequestForm() {
            $("#requestOtpForm").kendoForm({
                formData: { Email: prefillEmail },
                items: [{
                    field: "Email",
                    label: "Email Address",
                    validation: { required: true, email: true },
                    hint: "Enter your registered email address"
                }],
                buttonsTemplate:
                    '<button type="submit" class="k-button k-button-lg k-button-solid-success btn-full">Send OTP →</button>',
                submit: function (e) {
                    e.preventDefault();

                    $.ajax({
                        url: "/api/farmer/send-otp",
                        method: "POST",
                        contentType: "application/json",
                        data: JSON.stringify({ email: e.model.Email }),
                        success: function (result) {
                            if (result.success) {
                                $("#notificationRequest")
                                    .getKendoNotification()
                                    .show("OTP sent! Please check your email inbox.", "success");

                                // Store email for step 2
                                window._resetEmail = e.model.Email;

                                setTimeout(function () {
                                    $("#requestOtpSection").slideUp(300, function () {
                                        $("#resetPasswordSection").slideDown(300);
                                    });
                                }, 1200);
                            } else {
                                $("#notificationRequest")
                                    .getKendoNotification()
                                    .show(result.message || "Email not found.", "error");
                            }
                        },
                        error: function () {
                            $("#notificationRequest")
                                .getKendoNotification()
                                .show("Failed to send OTP. Please try again.", "error");
                        }
                    });
                }
            });
        }

        // ── Step 2: Verify OTP + Reset Password ───────────
        function buildResetForm() {
            $("#verifyResetForm").kendoForm({
                formData: {
                    otp: prefillOtp,
                    newPassword: "",
                    confirmPassword: ""
                },
                items: [
                    {
                        field: "otp",
                        label: "Enter OTP",
                        validation: { required: true },
                        hint: "6-digit code sent to your email"
                    },
                    {
                        field: "newPassword",
                        label: "New Password",
                        editor: function (container, options) {
                            $('<input type="password" name="' + options.field + '" />')
                                .appendTo(container)
                                .kendoTextBox();
                        },
                        validation: { required: true, minLength: 8 },
                        hint: "Min 8 chars with letters, numbers & special characters"
                    },
                    {
                        field: "confirmPassword",
                        label: "Confirm New Password",
                        editor: function (container, options) {
                            $('<input type="password" name="' + options.field + '" />')
                                .appendTo(container)
                                .kendoTextBox();
                        },
                        validation: { required: true }
                    }
                ],
                buttonsTemplate:
                    '<button type="submit" class="k-button k-button-lg k-button-solid-success btn-full">Reset Password ✓</button>',
                submit: function (e) {
                    e.preventDefault();

                    if (e.model.newPassword !== e.model.confirmPassword) {
                        $("#notificationReset").getKendoNotification().show("Passwords do not match.", "error");
                        return;
                    }

                    const emailToUse = window._resetEmail || prefillEmail;
                    if (!emailToUse) {
                        $("#notificationReset").getKendoNotification().show("Email not found. Please go back and request OTP again.", "error");
                        return;
                    }

                    $.ajax({
                        url: "/api/farmer/reset-password",
                        method: "POST",
                        contentType: "application/json",
                        data: JSON.stringify({
                            email: emailToUse,
                            otp: e.model.otp,
                            newPassword: e.model.newPassword,
                            confirmPassword: e.model.confirmPassword
                        }),
                        success: function (result) {
                            if (result.success) {
                                $("#notificationReset")
                                    .getKendoNotification()
                                    .show("Password updated! Redirecting to login...", "success");
                                setTimeout(() => window.location.href = "/Farmer/Login", 2000);
                            } else {
                                $("#notificationReset")
                                    .getKendoNotification()
                                    .show(result.message || "Invalid OTP or password.", "error");
                            }
                        },
                        error: function () {
                            $("#notificationReset")
                                .getKendoNotification()
                                .show("An error occurred. Please try again.", "error");
                        }
                    });
                }
            });
        }
    </script>
}
