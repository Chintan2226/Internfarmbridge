@{
    ViewData["Title"] = "Price Predictor";
    Layout = "~/Views/Shared/Layouts/_FarmerLayout.cshtml";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
@* Kendo/jQuery/Chart.js are already loaded by `_FarmerLayout.cshtml`.
   Keeping a single version prevents blank/unstable widget rendering. *@

<link rel="stylesheet" href="~/css/pages/farmer/priceprediction.css" asp-append-version="true" />

<div class="pp-wrap">

    <!-- Header -->
    <div class="pp-header">
        <div class="pp-header-left">
            <h1>
                <span class="leaf-icon">
                    <i class="bi bi-flower2" style="font-size:13px;color:white;"></i>
                </span>
                Price Predictor
            </h1>
            <p>AI-powered crop price forecasting for the next season</p>
        </div>
        <span class="live-badge">
            <span class="pulse-dot"></span>
            Model live
        </span>
    </div>

    <div class="pp-grid">

        <!-- ── Sidebar ─────────────────────────────────── -->
        <div class="pp-sidebar">

            <!-- Selection card -->
            <div class="pp-card">
                <div class="pp-card-header">
                    <span class="pp-card-title">Selection</span>
                </div>
                <div class="pp-card-body">
                    <div class="field-group">
                        <label class="field-label" for="state">State</label>
                        <select id="state" class="pp-select">
                            <option value="">Select state...</option>
                        </select>
                    </div>
                    <div class="field-group">
                        <label class="field-label" for="market">Market</label>
                        <select id="market" class="pp-select">
                            <option value="">Select market...</option>
                        </select>
                    </div>
                    <div class="field-group">
                        <label class="field-label" for="commodity">Crop</label>
                        <select id="commodity" class="pp-select">
                            <option value="">Select crop...</option>
                        </select>
                    </div>
                    <button id="predictBtn" class="predict-btn">
                        <i class="bi bi-search"></i>
                        <span id="btnText">Predict Price</span>
                        <div class="pp-spinner" id="spinner"></div>
                    </button>
                    <p class="pp-err" id="selectionError"></p>
                </div>
            </div>

            <!-- Summary card -->
            <div class="pp-card">
                <div class="pp-card-header">
                    <span class="pp-card-title">Summary</span>
                    <span id="sourceChip" style="font-size:11px;color:var(--muted);"></span>
                </div>
                <div class="pp-card-body">
                    <div class="metric-row">
                        <div class="metric-tile">
                            <div class="metric-label">Predicted</div>
                            <div class="metric-value predicted" id="predictedKg">—</div>
                        </div>
                        <div class="metric-tile">
                            <div class="metric-label">Current avg</div>
                            <div class="metric-value" id="currentKg">—</div>
                        </div>
                    </div>
                    <div class="trend-strip" id="trendStrip">
                        <i class="bi bi-arrow-right"></i>
                        <span id="trendText">Run a prediction to see the trend</span>
                    </div>
                    <p class="pp-hint" id="aiHint">Select state, market, and crop — then predict.</p>
                </div>
            </div>

        </div>

        <!-- ── Main ─────────────────────────────────────── -->
        <div class="pp-main">
            <div class="pp-card" style="flex:1">
                <div class="pp-card-header">
                    <span class="pp-card-title">Next Season Outlook</span>
                </div>

                <!-- State info bar (hidden until state selected) -->
                <div class="state-bar" id="stateBar" style="display:none;">
                    <i class="bi bi-geo-alt-fill" style="font-size:12px;"></i>
                    Showing outlook for <strong id="stateLabel"></strong>
                    <span id="cropCountLabel"></span>
                </div>

                <!-- Table view -->
                <div id="tableView">
                    <div class="empty-state" id="outlookEmpty">
                        <i class="bi bi-table"></i>
                        <p>Select a state above to load the season outlook</p>
                    </div>
                    <div id="outlookGrid" style="display:none; border:none; margin-top:10px; font-family:'DM Sans', sans-serif;"></div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
<script>
    const API = "http://127.0.0.1:8000";

    let seasonData = [];

    const DOT_COLORS = ["#7F77DD", "#1D9E75", "#5DCAA5", "#EF9F27", "#D85A30",
                        "#D4537E", "#378ADD", "#639922", "#BA7517", "#E24B4A"];

    /* ── Utilities ─────────────────────────────────── */
    function apiUrl(path) {
        const sep = path.includes("?") ? "&" : "?";
        return API + path + `${sep}_=${Date.now()}`;
    }

    function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

    async function loadDropdown(selectId, path) {
        try {
            const controller = new AbortController();
            const t = setTimeout(() => controller.abort(), 8000);
            const res  = await fetch(apiUrl(path), { signal: controller.signal, cache: "no-store" });
            clearTimeout(t);
            const data = await res.json();
            const $sel = $("#" + selectId);
            $sel.find("option:not(:first)").remove();
            (data.data || []).forEach(item => {
                $sel.append($("<option>").val(item).text(item));
            });
        } catch (e) {
            console.error("Dropdown load failed:", path, e);
        }
    }

    async function loadDropdownWithRetry(selectId, path, tries = 3) {
        for (let i = 0; i < tries; i++) {
            await loadDropdown(selectId, path);
            const hasItems = $("#" + selectId + " option").length > 1;
            if (hasItems) return true;
            await sleep(350 * Math.pow(2, i));
        }
        return false;
    }

    // Chart/tabs removed (table-only)

    /* ── Render predictions table ──────────────────── */
    function initGrid() {
        if(!$("#outlookGrid").data("kendoGrid")) {
            $("#outlookGrid").kendoGrid({
                dataSource: { data: [], pageSize: 5 },
                pageable: { pageSizes: false, refresh: false, info: true, numeric: true, previousNext: true },
                sortable: true,
                columns: [
                    { field: "commodity", title: "Crop", template: "<span style='font-weight:500'>#= commodity #</span>" },
                    { field: "current_price_per_kg", title: "Current (₹/kg)", template: "<span class='mono'>₹#= parseFloat(current_price_per_kg).toFixed(2) #</span>" },
                    { field: "predicted_price_90d_per_kg", title: "90D Forecast", template: "<span class='mono' style='color:var(--green-600);font-weight:600'>₹#= parseFloat(predicted_price_90d_per_kg).toFixed(2) #</span>" },
                    { title: "Change", template: function(dataItem) {
                        const diff = dataItem.predicted_price_90d_per_kg - dataItem.current_price_per_kg;
                        const pct  = ((diff / dataItem.current_price_per_kg) * 100).toFixed(1);
                        const up   = diff >= 0;
                        return `<span class="change-pill ${up ? 'up' : 'dn'}">${up ? '▲' : '▼'} ${Math.abs(pct)}%</span>`;
                    }},
                    { field: "recommendation", title: "Signal", template: function(dataItem) {
                        const rec = (dataItem.recommendation || "").toLowerCase();
                        const recClass = rec.includes("profitable") ? "buy" : rec.includes("stable") ? "hold" : "caution";
                        const recLabel = rec.includes("profitable") ? "Good for Sowing" : rec.includes("stable") ? "Stable Market" : rec.includes("high risk") ? "High Risk" : "Moderate Risk";
                        return `<span class="rec-tag ${recClass}">${recLabel}</span>`;
                    }}
                ]
            });
        }
    }

    /* ── Show / update outlook ─────────────────────── */
    function showOutlook(rows) {
        seasonData = rows;
        $("#outlookEmpty").hide();
        $("#outlookGrid").show();
        const grid = $("#outlookGrid").data("kendoGrid");
        if(grid) grid.dataSource.data(rows);
        $("#cropCountLabel").text("— " + rows.length + " crops tracked");
    }

    /* ── Trend chip helper ─────────────────────────── */
    function updateTrend(predicted, current) {
        const diff  = predicted - current;
        const strip = $("#trendStrip").removeClass("up down flat");
        if (diff > 0) {
            strip.addClass("up").html(
                `<i class="bi bi-arrow-up-short" style="font-size:16px;"></i>
                 Up ₹${Math.abs(diff).toFixed(2)}/kg — prices expected to rise`
            );
        } else if (diff < 0) {
            strip.addClass("down").html(
                `<i class="bi bi-arrow-down-short" style="font-size:16px;"></i>
                 Down ₹${Math.abs(diff).toFixed(2)}/kg — prices may soften`
            );
        } else {
            strip.addClass("flat").html(
                `<i class="bi bi-arrow-right" style="font-size:14px;"></i>
                 Stable — no significant movement expected`
            );
        }
    }

    /* ── Document ready ────────────────────────────── */
    $(document).ready(async function () {
        initGrid();

        /* Load states */
        $("#state").prop("disabled", true);
        const ok = await loadDropdownWithRetry("state", "/dropdowns/states", 4);
        $("#state").prop("disabled", false);
        if (!ok) {
            $("#selectionError").text("AI dropdowns couldn’t load. Ensure Python service is running on port 8000.").show();
        }

        /* State change → load markets + season outlook */
        $("#state").on("change", async function () {
            const state = $(this).val();
            $("#commodity").find("option:not(:first)").remove();
            $("#market").find("option:not(:first)").remove();

            if (!state) {
                $("#stateBar").hide();
                $("#outlookEmpty").show();
                $("#outlookGrid").hide();
                return;
            }

            await loadDropdown("market", `/dropdowns/markets?state=${encodeURIComponent(state)}`);

            /* Season outlook */
            try {
                $("#stateLabel").text(state);
                $("#stateBar").show();
                $("#outlookEmpty").text("Loading outlook...").show();
                $("#outlookTable").hide();

                const res  = await fetch(apiUrl("/predict/state_season"), {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ state })
                });
                const data = await res.json();

                if (data.success && data.season_forecast.length) {
                    showOutlook(data.season_forecast);
                } else {
                    $("#outlookEmpty").text("No season outlook available for this state.").show();
                    $("#outlookTable").hide();
                }
            } catch (e) {
                console.error("Season outlook error:", e);
                $("#outlookEmpty").text("Failed to load outlook. Check API connection.").show();
                $("#outlookTable").hide();
            }
        });

        /* Market change → load commodities */
        $("#market").on("change", async function () {
            const state  = $("#state").val();
            const market = $(this).val();
            if (!state || !market) return;
            await loadDropdown("commodity",
                `/dropdowns/commodities?state=${encodeURIComponent(state)}&market=${encodeURIComponent(market)}`
            );
        });

        /* Predict button */
        $("#predictBtn").on("click", async function () {
            const state     = $("#state").val();
            const market    = $("#market").val();
            const commodity = $("#commodity").val();
            const $err      = $("#selectionError");

            if (!state || !market || !commodity) {
                $err.text("Please select all three fields to continue.").show();
                return;
            }

            $err.hide();
            $("#predictBtn").prop("disabled", true);
            $("#btnText").text("Predicting...");
            $("#spinner").show();
            $("#aiHint").text("Running inference on historical market data...");

            try {
                const res  = await fetch(apiUrl("/predict/farmer"), {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ state, market, commodity })
                });
                const data = await res.json();

                if (data.success) {
                    const pred = parseFloat(data.predicted_price_per_kg);
                    const curr = parseFloat(data.current_price_per_kg);

                    $("#predictedKg").text(`₹${pred.toFixed(2)}/kg`);
                    $("#currentKg").text(`₹${curr.toFixed(2)}/kg`);
                    $("#sourceChip").text(`Source: ${data.source || "model"}`);
                    updateTrend(pred, curr);
                    $("#aiHint").text(`Prediction for ${commodity} in ${market}, ${state}.`);
                } else {
                    $err.text(data.message || "Prediction failed. Try again.").show();
                    $("#aiHint").text("Model could not generate a prediction.");
                }
            } catch (e) {
                console.error("Predict error:", e);
                $err.text("Failed to connect to AI Engine. Is the service running?").show();
                $("#aiHint").text("Service unavailable. Try again in a moment.");
            } finally {
                $("#predictBtn").prop("disabled", false);
                $("#btnText").text("Predict Price");
                $("#spinner").hide();
            }
        });
    });
</script>
}
