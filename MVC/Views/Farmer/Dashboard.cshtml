@{
    ViewData["Title"] = "Farmer Dashboard";
    ViewData["UserRole"] = "Farmer";
    Layout = "~/Views/Shared/Layouts/_FarmerLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/layouts/dashboard_shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Farmer/Dashboard.css" asp-append-version="true" />
    <script src="https://unpkg.com/@@phosphor-icons/web"></script>
}

<div class="db-wrap">
    <div class="f-action-row">
        <button class="f-btn" onclick="location.href='/Farmer/Crops'"><i class="ph-bold ph-plant"></i> List New Crop</button>
        <button class="f-btn" onclick="location.href='/Farmer/QCSlots'"><i class="ph-bold ph-calendar-check"></i> Book QC Appointment</button>
        <button class="f-btn" onclick="location.href='/Farmer/Inquiries'"><i class="ph-bold ph-headset"></i> Help & Support</button>
    </div>

    <section>
        <div class="kpi-grid dash-kpi-grid">
            <div class="kpi-card">
                <div class="kpi-top">
                    <div class="kpi-lbl">Total Earnings</div>
                    <div class="kpi-icon" style="background:var(--grad-rev);"><i class="ph-duotone ph-currency-inr" style="color:white; font-size: 26px;"></i></div>
                    <i class="ph-duotone ph-currency-inr watermark"></i>
                </div>
                <div class="kpi-val skeleton" id="kpiEarnings">₹0</div>
                <div class="kpi-sub"><span class="kpi-trend up"><i class="ph-bold ph-trend-up"></i> Collected</span> to your bank accounts</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-top">
                    <div class="kpi-lbl">Pending Payments</div>
                    <div class="kpi-icon" style="background:var(--grad-vend);"><i class="ph-duotone ph-hourglass-high" style="color:white; font-size: 26px;"></i></div>
                    <i class="ph-duotone ph-hourglass-high watermark"></i>
                </div>
                <div class="kpi-val skeleton" id="kpiPendingPay">₹0</div>
                <div class="kpi-sub"><span class="kpi-trend neutral"><i class="ph-bold ph-minus"></i> Awaiting</span> buyer confirmation</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-top">
                    <div class="kpi-lbl">Active Crops Listed</div>
                    <div class="kpi-icon" style="background:var(--grad-farm);"><i class="ph-duotone ph-plant" style="color:white; font-size: 26px;"></i></div>
                    <i class="ph-duotone ph-plant watermark"></i>
                </div>
                <div class="kpi-val skeleton" id="kpiCrops">0</div>
                <div class="kpi-sub"><span class="kpi-trend up"><i class="ph-bold ph-check-circle"></i> Verified</span> by FarmBridge</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-top">
                    <div class="kpi-lbl">Upcoming QC Slots</div>
                    <div class="kpi-icon" style="background:var(--grad-fo);"><i class="ph-duotone ph-shield-check" style="color:white; font-size: 26px;"></i></div>
                    <i class="ph-duotone ph-shield-check watermark"></i>
                </div>
                <div class="kpi-val skeleton" id="kpiQC">0</div>
                <div class="kpi-sub"><span class="kpi-trend neutral"><i class="ph-bold ph-calendar"></i> Scheduled</span> for future dates</div>
            </div>
        </div>
    </section>

    <section>
        <div class="dash-split-layout">
            <div class="chart-card" style="padding: 20px;">
                <div class="chart-head" style="margin-bottom: 10px;">
                    <div>
                        <div class="chart-title">Income History</div>
                        <div class="chart-sub">Your monthly earnings summary</div>
                    </div>
                </div>
                <div class="kendo-widget-container">
                    <div id="chartSkeleton" class="skeleton chart-skeleton"></div>
                    <div id="incomeChart" style="height: 200px; display: none;"></div>
                </div>
            </div>

            <div class="grid-card" style="padding: 20px; overflow: hidden; display: flex; flex-direction: column;">
                <div class="grid-head" style="margin-bottom: 10px;">
                    <div class="grid-title">Recent Payments & Clearances</div>
                </div>
                <div class="kendo-widget-container" style="flex: 1;">
                    <div id="gridSkeleton" class="skeleton chart-skeleton" style="height: 100%;"></div>
                    <div id="paymentsGrid" class="borderless-grid" style="display: none;"></div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
<script src="~/js/Farmer/dashboard.js" asp-append-version="true"></script>
}