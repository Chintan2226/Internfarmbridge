@{
    ViewData["Title"] = "Inquiries & Help";
    ViewData["UserRole"] = "Farmer";
    Layout = "~/Views/Shared/Layouts/_FarmerLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/layouts/dashboard_shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Farmer/inquiries.css" asp-append-version="true" />
}

<div class="db-wrap">

    <!-- Page Header -->
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
        <div>
            <h2 style="margin:0; font-size:22px; font-weight:800; color:#0a2108; display:flex; align-items:center; gap:10px;">
                <i class="fi fi-sr-headset" style="color:#10b981;"></i> Support Helpdesk
            </h2>
            <p style="margin:4px 0 0; font-size:13px; color:#5a7257;">Get assistance with payments, logistics, or platform technical issues</p>
        </div>
        <div style="display:flex; align-items:center; gap:8px; background:#dcfce7; color:#166534; padding:8px 16px; border-radius:20px; font-size:13px; font-weight:600;">
            <span style="width:8px; height:8px; border-radius:50%; background:#16a34a; display:inline-block;"></span>
            System Online
        </div>
    </div>

    <!-- KPI Stats -->
    <div class="inq-kpi-grid">
        <div class="kpi-card emerald-card">
            <div class="kpi-top">
                <div class="kpi-lbl">Total Queries</div>
                <div class="kpi-icon"><i class="fi fi-sr-apps"></i></div>
            </div>
            <div class="kpi-val" id="kpiTotal">0</div>
            <div class="kpi-sub">Lifetime support tickets</div>
        </div>
        <div class="kpi-card gold-card">
            <div class="kpi-top">
                <div class="kpi-lbl">Pending Action</div>
                <div class="kpi-icon"><i class="fi fi-sr-clock-three"></i></div>
            </div>
            <div class="kpi-val" id="kpiPending">0</div>
            <div class="kpi-sub">Currently being reviewed</div>
        </div>
        <div class="kpi-card farm-card">
            <div class="kpi-top">
                <div class="kpi-lbl">Solved</div>
                <div class="kpi-icon"><i class="fi fi-sr-shield-check"></i></div>
            </div>
            <div class="kpi-val" id="kpiSolved">0</div>
            <div class="kpi-sub">Successfully resolved</div>
        </div>
    </div>

    <!-- Split Layout -->
    <div class="inquiry-split-layout">

        <!-- Left Sidebar: Contact & FAQ -->
        <div style="display:flex; flex-direction:column; gap:20px;">
            <!-- Direct Contact -->
            <div class="inq-sidebar-card">
                <div class="inq-card-title">
                    <i class="fi fi-sr-phone-call" style="color:#10b981;"></i> Direct Contact
                </div>
                <div class="inq-contact-row">
                    <div class="inq-contact-icon"><i class="fi fi-rr-phone-call" style="color:#10b981; font-size:18px;"></i></div>
                    <div>
                        <div class="inq-contact-lbl">Toll-Free Helpline</div>
                        <div class="inq-contact-val">1800-123-4567</div>
                    </div>
                </div>
                <div class="inq-contact-row inq-contact-last">
                    <div class="inq-contact-icon"><i class="fi fi-rr-comment-alt" style="color:#10b981; font-size:18px;"></i></div>
                    <div>
                        <div class="inq-contact-lbl">WhatsApp Support</div>
                        <div class="inq-contact-val">+91 98765 43210</div>
                    </div>
                </div>
            </div>

            <!-- Quick Help FAQ -->
            <div class="inq-sidebar-card" style="flex:1;">
                <div class="inq-card-title">
                    <i class="fi fi-sr-interrogation" style="color:#10b981;"></i> Quick Help
                </div>
                <div class="inq-faq-item">
                    <div class="inq-faq-q">Payment timelines?</div>
                    <div class="inq-faq-a">Released after QC clearance and final sale.</div>
                </div>
                <div class="inq-faq-item inq-faq-last">
                    <div class="inq-faq-q">Reschedule QC?</div>
                    <div class="inq-faq-a">Yes, via the QC Appointments tab.</div>
                </div>
                <a href="#" style="color:#10b981; font-size:13px; font-weight:600; text-decoration:none; display:block; margin-top:16px;">Browse full FAQ →</a>
            </div>
        </div>

        <!-- Right: Inquiry Form -->
        <div class="inquiry-form-card">
            <h3 style="margin:0 0 24px; font-size:18px; font-weight:700; color:#1e293b;">Submit Support Ticket</h3>
            <form id="inquiryForm">
                <div class="inq-form-row">
                    <label class="premium-label">Routing Department</label>
                    <div class="custom-select-wrapper">
                        <select id="inquiryType" class="text-field select-field">
                            <option value="" disabled selected hidden>Select Department...</option>
                            <option value="Payments">Payments &amp; Billing</option>
                            <option value="Logistics">Logistics &amp; Pickup</option>
                            <option value="Quality">Quality Check (QC)</option>
                            <option value="Technical">Technical Issues</option>
                        </select>
                    </div>
                </div>

                <div class="inq-form-row">
                    <label class="premium-label">Urgency Level</label>
                    <div class="custom-select-wrapper">
                        <select class="text-field select-field">
                            <option value="Normal">Normal</option>
                            <option value="High">High (Needs Urgent Attention)</option>
                        </select>
                    </div>
                </div>

                <div class="inq-form-row">
                    <label class="premium-label">Subject Headline</label>
                    <input id="subject" type="text" class="text-field" placeholder="What can we help you with?" required />
                </div>

                <div class="inq-form-row-last">
                    <label class="premium-label">Comprehensive Details</label>
                    <textarea id="messageBody" class="text-field premium-textarea" placeholder="Please describe your issue in detail..." required></textarea>
                </div>

                <div class="form-footer-actions">
                    <div class="secure-badge">
                        <i class="fi fi-rr-lock"></i> Your data is encrypted and secure
                    </div>
                    <div class="btn-group-responsive">
                        <button type="reset" id="btnResetInquiry" class="btn-premium-ghost">Reset</button>
                        <button type="button" id="btnSubmitInquiry" class="btn-premium-solid">
                            <i class="fi fi-rr-paper-plane" style="margin-right:8px;"></i> Send Query
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/Farmer/inquiries.js" asp-append-version="true"></script>
}
