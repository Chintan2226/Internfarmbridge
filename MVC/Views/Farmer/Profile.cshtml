@{
    ViewData["Title"] = "Account Settings";
    ViewData["UserRole"] = "Farmer";
    Layout = "~/Views/Shared/Layouts/_FarmerLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/layouts/dashboard_shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/farmer/profile.css" asp-append-version="true" />
}

<div class="db-wrap" style="gap: 20px; padding-bottom: 20px;">
    <section class="profile-layout" style="margin-top: 10px;">
        
        @* Sidebar *@
        <div class="profile-sidebar">
            <div class="profile-header">
                <button class="k-button" style="position:absolute; top: 10px; right: 10px; background: rgba(255,255,255,0.2); border:none; color:#fff;" onclick="changeCover()"><i class="fi fi-rr-picture"></i></button>
            </div>
            
            <div style="position: relative; padding: 50px 24px 20px; text-align: center; display: flex; flex-direction: column; align-items: center;">
                <div class="profile-avatar-wrap" id="farmerAvatarWrap" style="position: absolute; top: -40px; left: 50%; transform: translateX(-50%); cursor: pointer;" onclick="document.getElementById('photoInput').click()">
                    <img id="farmerPhoto" src="" style="display:none; width: 100%; height: 100%; border-radius: 50%; object-fit: cover;" />
                    <div id="avatarPlaceholder" style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;">
                        <i class="fi fi-rr-user" style="font-size: 32px; color: #94a3b8;"></i>
                    </div>
                    <div class="photo-overlay">
                        <i class="fi fi-rr-camera" style="color: #fff;"></i>
                    </div>
                </div>
                
                <h3 id="farmerNameLabel" class="skeleton" style="font-size: 18px; font-weight: 800; color: #1e293b; margin: 0 0 4px 0; min-width: 150px; min-height: 22px;"></h3>
                <p id="farmerMetaLabel" class="skeleton" style="font-size: 13px; color: #64748b; margin: 0 0 16px 0; min-width: 100px; min-height: 16px;"></p>

                <div style="margin-bottom: 16px; display: flex; justify-content: center; gap: 8px;">
                    <input type="file" id="photoInput" style="display: none;" accept="image/*" onchange="handlePhotoUpload(this)" />
                    <button class="k-button" id="btnDeletePhoto" style="display:none; background: rgba(239, 68, 68, 0.1); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.2); font-size: 11px; padding: 4px 10px; border-radius: 6px;" onclick="deletePhoto()">
                        <i class="fi fi-rr-trash" style="margin-right: 4px;"></i> <span data-i18n="profile_remove_photo">Remove Photo</span>
                    </button>
                </div>

                <div style="text-align: left; padding-top: 16px; border-top: 1px solid #f1f5f9;">
                    <div class="kpi-stat-row">
                        <span class="kpi-stat-lbl" data-i18n="profile_active_listings">Active Listings</span>
                        <span class="kpi-stat-val skeleton" id="statActiveListings" style="min-width: 20px; display: inline-block;">0</span>
                    </div>
                    <div class="kpi-stat-row" style="border-bottom: none;">
                        <span class="kpi-stat-lbl" data-i18n="profile_qc_passed">Quality Checks Passed</span>
                        <span class="kpi-stat-val skeleton" id="statQCPassed" style="min-width: 20px; display: inline-block;">0</span>
                    </div>
                </div>

                <button class="btn-logout" onclick="logoutUser()">
                    <i class="fi fi-rr-exit" style="margin-right: 6px;"></i> <span data-i18n="secure_logout">Secure Logout</span>
                </button>
            </div>
        </div>

        @* Main Content *@
        <div class="profile-main-card">
            <form id="profileForm">
                
                @* Personal Section *@
                <div class="section-title">
                    <i class="fi fi-rr-user" style="color: #3b82f6;"></i> <span data-i18n="profile_personal_farm_details">Personal & Farm Details</span>
                </div>
                
                <div class="row g-3" style="margin-bottom: 20px;">
                    <div class="col-md-6 form-group">
                        <label class="premium-label" data-i18n="profile_full_name">Full Name</label>
                        <input id="fullName" class="text-field skeleton" value="" />
                    </div>
                    <div class="col-md-6 form-group">
                        <label class="premium-label" data-i18n="profile_mobile_number">Mobile Number</label>
                        <input id="phoneNo" class="text-field skeleton" value="" disabled />
                    </div>
                </div>
                
                <div class="row g-3" style="margin-bottom: 20px;">
                    <div class="col-md-6 form-group">
                        <label class="premium-label" data-i18n="profile_state">State</label>
                        <input id="farmState" class="text-field skeleton" data-i18n-placeholder="profile_enter_state" />
                    </div>
                    <div class="col-md-6 form-group">
                        <label class="premium-label" data-i18n="profile_district">District</label>
                        <input id="farmDistrict" class="text-field skeleton" data-i18n-placeholder="profile_enter_district" />
                    </div>
                </div>

                <div class="row g-3" style="margin-bottom: 32px;">
                    <div class="col-12 form-group">
                        <label class="premium-label" data-i18n="profile_farm_address">Farm Address</label>
                        <input id="address" class="text-field skeleton" data-i18n-placeholder="profile_enter_address" />
                    </div>
                </div>

                @* Banking Section *@
                <div class="section-title" style="margin-top: 40px;">
                    <i class="fi fi-rr-bank" style="color: #8b5cf6;"></i> <span data-i18n="profile_bank_account_payouts">Bank Account & Payouts</span>
                </div>

                <div class="row g-3" style="margin-bottom: 20px;">
                    <div class="col-md-6 form-group">
                        <label class="premium-label" data-i18n="profile_bank_name">Bank Name</label>
                        <input id="bankName" class="text-field skeleton" data-i18n-placeholder="profile_enter_bank" />
                    </div>
                    <div class="col-md-6 form-group">
                        <label class="premium-label" data-i18n="profile_branch_name">Branch Name</label>
                        <input id="branchName" class="text-field skeleton" data-i18n-placeholder="profile_enter_branch" />
                    </div>
                </div>

                <div class="row g-3" style="margin-bottom: 20px;">
                    <div class="col-md-6 form-group">
                        <label class="premium-label" data-i18n="profile_account_holder_name">Account Holder Name</label>
                        <input id="acctName" class="text-field skeleton" value="" />
                    </div>
                    <div class="col-md-6 form-group">
                        <label class="premium-label" data-i18n="profile_account_type">Account Type</label>
                        <select id="acctType" class="text-field skeleton" style="cursor: pointer;">
                            <option value="" disabled selected hidden data-i18n="profile_select_acct_type">Select Account Type...</option>
                            <option value="savings" data-i18n="profile_savings">Savings</option>
                            <option value="current" data-i18n="profile_current">Current</option>
                        </select>
                    </div>
                </div>

                <div class="row g-3" style="margin-bottom: 20px;">
                    <div class="col-md-6 form-group">
                        <label class="premium-label" data-i18n="profile_account_number">Account Number</label>
                        <input id="acctNo" type="password" class="text-field skeleton" value="" />
                        <div style="font-size: 11px; color:#94a3b8; margin-top:4px;" data-i18n="profile_hidden_for_security">Hidden for security.</div>
                    </div>
                    <div class="col-md-6 form-group">
                        <label class="premium-label" data-i18n="profile_ifsc_code">IFSC Code</label>
                        <input id="ifscCode" class="text-field skeleton" data-i18n-placeholder="profile_enter_ifsc" style="text-transform: uppercase;" />
                    </div>
                </div>

                <div class="row g-3" style="margin-bottom: 32px;">
                    <div class="col-md-6 form-group">
                        <label class="premium-label" data-i18n="profile_upi_id">UPI ID <span style="font-size:10px; color:#94a3b8; text-transform:none;" data-i18n="profile_optional">(Optional)</span></label>
                        <input id="upiId" class="text-field skeleton" data-i18n-placeholder="profile_enter_upi" />
                    </div>
                </div>

                <div style="display: flex; justify-content: flex-end; align-items: center; margin-top: 40px; padding-top: 24px; border-top: 1px solid #f1f5f9;">
                    <div style="font-size: 13px; color: #64748b; margin-right: 20px;">
                        <i class="fi fi-rr-info" style="color: #64748b; margin-right: 4px;"></i> <span data-i18n="profile_required_to_save_banking">Required for banking changes.</span>
                    </div>
                    <button type="button" class="btn-update" onclick="saveProfile()" data-i18n="profile_update_info">Update Profile</button>
                </div>
            </form>
        </div>

    </section>
</div>

<div id="authModal" style="display: none;"></div>

@section Scripts {
    <script src="~/js/Farmer/profile.js" asp-append-version="true"></script>
}
