@{
    ViewData["Title"] = "My Crops";
    ViewData["UserRole"] = "Farmer";
    Layout = "~/Views/Shared/Layouts/_FarmerLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/layouts/dashboard_shared.css" asp-append-version="true" />
    <link href="~/css/Farmer/crops.css" rel="stylesheet" asp-append-version="true" />
}

<!-- ── Page Header ──────────────────────────────────────────────────────────── -->
<div class="crops-page-header">
    <div>
        <h1 class="crops-page-title">
            <i class="fi fi-rr-leaf"></i> My Crops
        </h1>
        <div class="crops-page-sub">Manage your crop listings and track quality check requests</div>
    </div>
    <button class="btn-list-new" onclick="openCropWindow()">
        <i class="fi fi-rr-plus"></i> List New Crop
    </button>
</div>

<!-- ── Stats Bar ─────────────────────────────────────────────────────────────── -->
<div class="crops-stats-bar" id="cropsStatsBar" style="display:none;">
    <div class="stat-chip chip-active">
        <span class="chip-dot"></span>
        <span id="statActive">0</span> Active
    </div>
    <div class="stat-chip chip-draft">
        <span class="chip-dot"></span>
        <span id="statDraft">0</span> Draft
    </div>
    <div class="stat-chip chip-qc">
        <span class="chip-dot"></span>
        <span id="statQC">0</span> QC Scheduled
    </div>
    <div class="stat-chip chip-sold">
        <span class="chip-dot"></span>
        <span id="statSold">0</span> Sold
    </div>
</div>

<!-- ── Card Grid ────────────────────────────────────────────────────────────── -->
<div id="cropsGrid"></div>

<!-- ── Empty State ──────────────────────────────────────────────────────────── -->
<div id="cropsEmpty" class="crops-empty" style="display:none;">
    <div class="empty-icon">🌱</div>
    <div class="empty-title">No crop listings yet</div>
    <div class="empty-sub">Click "List New Crop" to publish your first listing</div>
</div>

<!-- ── Hidden edit id ───────────────────────────────────────────────────────── -->
<input type="hidden" id="editListingId" value="" />

<!-- ── Create / Edit Modal ──────────────────────────────────────────────────── -->
<div id="cropWindow" style="display:none; padding:0;">
    <form id="cropForm" autocomplete="off" style="display:flex; flex-direction:column; max-height:82vh;">

        <div style="padding:22px 26px; flex:1; overflow-y:auto;">

            <!-- Section: Product -->
            <div class="section-heading">
                <i class="fi fi-rr-seedling"></i> Product Specifications
            </div>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-lbl">Crop Category <span class="req">*</span></label>
                    <input id="cropType" style="width:100%; border-radius:8px;" />
                </div>
                <div class="col-md-6">
                    <label class="form-lbl">Variety / Strain</label>
                    <input class="k-textbox" id="cropVariety"
                           style="width:100%; border-radius:8px; padding:6px 10px;"
                           placeholder="e.g. Sharbati" />
                </div>
            </div>

            <!-- Section: Inventory -->
            <div class="section-heading">
                <i class="fi fi-rr-box-alt"></i> Inventory &amp; Pricing
            </div>
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label class="form-lbl">Available Qty <span class="req">*</span></label>
                    <input id="cropQty" style="width:100%; border-radius:8px;" />
                </div>
                <div class="col-md-4">
                    <label class="form-lbl">Unit <span class="req">*</span></label>
                    <input id="cropUnit" style="width:100%; border-radius:8px;" />
                </div>
                <div class="col-md-4">
                    <label class="form-lbl">Asking Price (₹) <span class="req">*</span></label>
                    <input id="cropPrice" style="width:100%; border-radius:8px;" />
                </div>
            </div>

            <!-- Section: Logistics -->
            <div class="section-heading">
                <i class="fi fi-rr-map-marker"></i> Logistics &amp; Location
            </div>
            <div class="row g-3 mb-2">
                <div class="col-md-6">
                    <label class="form-lbl">Expected Harvest Date <span class="req">*</span></label>
                    <input id="harvestDate" style="width:100%; border-radius:8px;" />
                </div>
                <div class="col-md-3">
                    <label class="form-lbl">State</label>
                    <input class="k-textbox" id="farmState"
                           style="width:100%; border-radius:8px; padding:6px 10px;"
                           placeholder="e.g. Gujarat" />
                </div>
                <div class="col-md-3">
                    <label class="form-lbl">District</label>
                    <input class="k-textbox" id="farmDistrict"
                           style="width:100%; border-radius:8px; padding:6px 10px;"
                           placeholder="e.g. Surat" />
                </div>
                <div class="col-12">
                    <label class="form-lbl">Farm Address</label>
                    <textarea class="k-textarea" id="farmLocation" rows="2"
                              style="width:100%; border-radius:8px; border:1px solid rgba(0,0,0,0.12);
                                     padding:8px 12px; font-size:13px; resize:vertical;"
                              placeholder="Village, Taluka, full address..."></textarea>
                </div>
                <div class="col-12">
                    <label class="form-lbl">Additional Notes</label>
                    <textarea class="k-textarea" id="cropNotes" rows="2"
                              style="width:100%; border-radius:8px; border:1px solid rgba(0,0,0,0.12);
                                     padding:8px 12px; font-size:13px; resize:vertical;"
                              placeholder="Any specific details about the crop batch..."></textarea>
                </div>
            </div>

        </div>

        <!-- Footer Buttons -->
        <div class="modal-footer-bar">
            <button type="button" class="btn-modal-cancel" onclick="closeCropWindow()">
                Cancel
            </button>
            <button type="button" class="btn-modal-draft" onclick="saveCrop('Draft')">
                <i class="fi fi-rr-floppy-disk"></i> Save Draft
            </button>
            <button type="button" class="btn-modal-publish" onclick="saveCrop('Active')">
                <i class="fi fi-rr-cloud-upload"></i> Publish Listing
            </button>
        </div>
    </form>
</div>

<!-- ── Kendo Card Template ───────────────────────────────────────────────────── -->
<!--
    FIX: HTML entities (&#8377; &#9998;) have been replaced with their literal
    Unicode characters (₹ ✎). The browser decodes HTML entities inside
    <script type="text/x-kendo-template"> BEFORE Kendo parses the template,
    which inserts raw & characters that break Kendo's code generator.
    Using literal Unicode characters avoids this entirely.
-->
<script id="crop-card-template" type="text/x-kendo-template">
    <div class="crop-card status-#: Status.toLowerCase() #">

        <div class="crop-card-accent"></div>

        <div class="crop-card-body">

            <div class="crop-card-header">
                <div class="crop-card-title-group">
                    <div class="crop-name">#: Crop #</div>
                    <div class="crop-variety">#: Variety #</div>
                    <div class="crop-id">ID \##: Id #</div>
                </div>
                <span class="crop-badge badge-#: Status.toLowerCase() #">#: Status #</span>
            </div>

            <div class="crop-stats">
                <div class="stat-cell">
                    <div class="stat-label">Price / #: Unit #</div>
                    <div class="stat-val green">₹#: Price #</div>
                </div>
                <div class="stat-cell">
                    <div class="stat-label">Quantity</div>
                    <div class="stat-val">#: Qty # #: Unit #</div>
                </div>
                <div class="stat-cell">
                    <div class="stat-label">Harvest Date</div>
                    <div class="stat-val">#: HarvestDate #</div>
                </div>
            </div>

        </div>

        <div class="crop-card-footer">
      

            # if (Status.toLowerCase() === "active" || Status.toLowerCase() === "draft") { #
                <button class="ca-btn btn-danger" onclick="deleteCrop(#: Id #)">
                    Withdraw
                </button>
            # } else { #
               
            # } #
        </div>

    </div>
</script>

@section Scripts {
    <script src="~/js/Farmer/crops.js" asp-append-version="true"></script>
}
