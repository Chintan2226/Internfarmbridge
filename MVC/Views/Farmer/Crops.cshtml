@{
    ViewData["Title"] = "My Crops";
    ViewData["UserRole"] = "Farmer";
    Layout = "~/Views/Shared/Layouts/_FarmerLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/layouts/dashboard_shared.css" asp-append-version="true" />
    <link href="~/css/Farmer/crops.css" rel="stylesheet" asp-append-version="true" />
}

<!-- Page Header -->
<div class="crops-page-header">
    <div>
        <h1 class="crops-page-title">
            <i class="fi fi-rr-leaf"></i> My Crops
        </h1>
        <div class="crops-page-sub">Manage your crop listings and track quality check requests</div>
    </div>
    <button class="btn-list-new" onclick="openCropWindow()">
        <i class="fi fi-rr-plus"></i> List New Crop
    </button>
</div>

<!-- Search Bar - Improved UI -->
<div class="crop-search-wrapper" style="margin-bottom: 20px; padding: 0 0 16px 0;">
    <div class="crop-search-container" style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
        <div class="crop-search-input-wrapper" style="flex: 1; min-width: 250px; position: relative;">
            <i class="fas fa-search" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #9ca3af; font-size: 14px;"></i>
            <input type="text" id="cropSearchInput" 
                   class="crop-search-input" 
                   placeholder="Search by crop name, variety..."
                   autocomplete="off"
                   style="width: 100%; padding: 10px 12px 10px 36px; border: 1px solid #e2e8f0; border-radius: 10px; font-size: 14px; background: #fff; transition: all 0.2s;">
        </div>
        <select id="cropStatusFilter" class="crop-status-filter" style="padding: 10px 12px; border: 1px solid #e2e8f0; border-radius: 10px; font-size: 14px; background: #fff; min-width: 130px;">
            <option value="">All Status</option>
            <option value="active">Active</option>
            <option value="draft">Draft</option>
            <option value="qc_passed">QC Passed</option>
        </select>
        <button id="clearCropSearchBtn" class="crop-clear-search" style="background: none; border: none; color: #6b7280; cursor: pointer; font-size: 13px; display: none;">
            <i class="fas fa-times-circle"></i> Clear
        </button>
    </div>
</div>

<!-- Search Results Info - Improved -->
<div id="searchResultsInfo" 
     style="display:none; padding: 10px 15px; background: #f0fdf4; border-left: 4px solid #10b981; border-radius: 8px; margin-bottom: 20px;">
    <i class="fas fa-info-circle" style="color: #10b981;"></i>
    <span style="color: #166534;">Showing results for: <strong id="searchQueryText"></strong></span>
    <button id="clearCropSearch" 
            style="float:right; background: none; border: none; color: #10b981; cursor: pointer; font-weight: 500;">
        <i class="fas fa-times"></i> Clear
    </button>
</div>

<!-- Stats Bar -->
<div class="crops-stats-bar" id="cropsStatsBar">
    <div class="stat-chip chip-active">
        <span class="chip-dot"></span>
        <span id="statActive" class="skeleton" style="min-width: 20px; display: inline-block;"></span> Active
    </div>
    <div class="stat-chip chip-draft">
        <span class="chip-dot"></span>
        <span id="statDraft" class="skeleton" style="min-width: 20px; display: inline-block;"></span> Draft
    </div>
    <div class="stat-chip chip-qc">
        <span class="chip-dot"></span>
        <span id="statQC" class="skeleton" style="min-width: 20px; display: inline-block;"></span> QC Scheduled
    </div>
    <div class="stat-chip chip-sold">
        <span class="chip-dot"></span>
        <span id="statSold" class="skeleton" style="min-width: 20px; display: inline-block;"></span> Sold
    </div>
</div>

<!-- Card Grid -->
<div id="gridSkeleton" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; padding: 24px 0;">
    <div class="skeleton" style="height: 220px; border-radius: 16px; width: 100%;"></div>
    <div class="skeleton" style="height: 220px; border-radius: 16px; width: 100%;"></div>
    <div class="skeleton" style="height: 220px; border-radius: 16px; width: 100%;"></div>
    <div class="skeleton" style="height: 220px; border-radius: 16px; width: 100%;"></div>
    <div class="skeleton" style="height: 220px; border-radius: 16px; width: 100%;"></div>
    <div class="skeleton" style="height: 220px; border-radius: 16px; width: 100%;"></div>
    <div class="skeleton" style="height: 220px; border-radius: 16px; width: 100%;"></div>
    <div class="skeleton" style="height: 220px; border-radius: 16px; width: 100%;"></div>
</div>
<div id="cropsGrid" style="display:none;"></div>

<!-- Empty State -->
<div id="cropsEmpty" class="crops-empty" style="display:none;">
    <div class="empty-icon">🌱</div>
    <div class="empty-title">No crop listings yet</div>
    <div class="empty-sub">Click "List New Crop" to publish your first listing</div>
</div>

<!-- Hidden edit id -->
<input type="hidden" id="editListingId" value="" />

<!-- Create / Edit Modal -->
<div id="cropWindow" style="display:none; padding:0;">
    <form id="cropForm" autocomplete="off" class="premium-form-container">

        <div class="premium-form-body">

            <!-- Section: Product -->
            <div class="premium-section">
                <div class="premium-section-header">
                    <div class="icon-wrap"><i class="fi fi-rr-seedling"></i></div>
                    <h4>Product Specifications</h4>
                </div>
                <div class="premium-row">
                    <div class="premium-col-6">
                        <label class="premium-lbl">Crop Category <span class="req">*</span></label>
                        <input id="cropType" />
                    </div>
                    <div class="premium-col-6">
                        <label class="premium-lbl">Variety / Strain</label>
                        <input id="cropVariety" placeholder="e.g. Sharbati" />
                    </div>
                </div>
            </div>

            <!-- Section: Inventory -->
            <div class="premium-section">
                <div class="premium-section-header">
                    <div class="icon-wrap"><i class="fi fi-rr-box-alt"></i></div>
                    <h4>Inventory &amp; Pricing</h4>
                </div>
                <div class="premium-row">
                    <div class="premium-col-4">
                        <label class="premium-lbl">Available Qty <span class="req">*</span></label>
                        <input id="cropQty" />
                    </div>
                    <div class="premium-col-4">
                        <label class="premium-lbl">Unit (per unit) <span class="req">*</span></label>
                        <input id="cropUnit" />
                    </div>
                    <div class="premium-col-4">
                        <label class="premium-lbl">Asking Price (₹) (per unit) <span class="req">*</span></label>
                        <input id="cropPrice" />
                    </div>
                </div>
            </div>

            <!-- Section: Logistics -->
            <div class="premium-section">
                <div class="premium-section-header">
                    <div class="icon-wrap"><i class="fi fi-rr-map-marker"></i></div>
                    <h4>Logistics &amp; Location</h4>
                </div>
                <div class="premium-row">
                    <div class="premium-col-6">
                        <label class="premium-lbl">Expected Harvest Date <span class="req">*</span></label>
                        <input id="harvestDate" />
                    </div>
                    <div class="premium-col-3">
                        <label class="premium-lbl">State</label>
                        <input id="farmState" placeholder="e.g. Gujarat" />
                    </div>
                    <div class="premium-col-3">
                        <label class="premium-lbl">District</label>
                        <input id="farmDistrict" placeholder="e.g. Surat" />
                    </div>
                </div>
                <div class="premium-row mt-3">
                    <div class="premium-col-12">
                        <label class="premium-lbl">Farm Address</label>
                        <textarea id="farmLocation" placeholder="Village, Taluka, full address..."></textarea>
                    </div>
                </div>
                <div class="premium-row mt-3">
                    <div class="premium-col-12">
                        <label class="premium-lbl">Additional Notes</label>
                        <textarea id="cropNotes" placeholder="Any specific details about the crop batch..."></textarea>
                    </div>
                </div>
            </div>

        </div>

        <!-- Footer Buttons -->
        <div class="premium-modal-footer">
            <button type="button" class="premium-btn-cancel" onclick="closeCropWindow()">
                Cancel
            </button>
            <div class="premium-actions">
                <button type="button" class="premium-btn-draft" onclick="saveCrop('Draft')">
                    <i class="fi fi-rr-floppy-disk"></i> Save Draft
                </button>
                <button type="button" class="premium-btn-publish" onclick="saveCrop('Active')">
                    <i class="fi fi-rr-cloud-upload"></i> Publish Listing
                </button>
            </div>
        </div>
    </form>
</div>

<!-- Kendo Card Template -->
<!--
    NOTE: HTML entities (&#8377; &#9998;) have been replaced with literal
    Unicode characters (₹ ✎). The browser decodes HTML entities inside
    <script type="text/x-kendo-template"> BEFORE Kendo parses the template,
    which inserts raw & characters that break Kendo's code generator.
-->
<script id="crop-card-template" type="text/x-kendo-template">
    <div class="crop-card status-#: Status.toLowerCase() #">

        <div class="crop-card-accent"></div>

        <div class="crop-card-body">

            <div class="crop-card-header">
                <div class="crop-card-title-group">
                    <div class="crop-name">#: Crop #</div>
                    <div class="crop-variety">#: Variety #</div>
                    <div class="crop-id">ID \##: Id #</div>
                </div>
                <span class="crop-badge badge-#: Status.toLowerCase() #">#: Status #</span>
            </div>

            <div class="crop-stats">
                <div class="stat-cell">
                    <div class="stat-label">Price / #: Unit #</div>
                    <div class="stat-val green">₹#: Price #</div>
                </div>
                <div class="stat-cell">
                    <div class="stat-label">Quantity</div>
                    <div class="stat-val">#: Qty # #: Unit #</div>
                </div>
                <div class="stat-cell">
                    <div class="stat-label">Harvest Date</div>
                    <div class="stat-val">#: HarvestDate #</div>
                </div>
            </div>

        </div>

        <div class="crop-card-footer">

            # if (Status.toLowerCase() === "active" || Status.toLowerCase() === "draft") { #
                <button class="ca-btn btn-danger" onclick="deleteCrop(#: Id #)">
                    Withdraw
                </button>
            # } else { #
               
            # } #
        </div>

    </div>
</script>

@section Scripts {
    <script src="~/js/Farmer/crops.js" asp-append-version="true"></script>
}
