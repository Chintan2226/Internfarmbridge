@{
    ViewData["Title"] = "Farmer Login · FarmBridge";
    Layout = null;
}
<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <link rel="icon" type="image/png" href="~/Logo/Logo_Without_Bg.png"/>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="description" content="Login to your FarmBridge farmer account."/>
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script>
        tailwind.config = { darkMode: "class", theme: { extend: { colors: { primary: "#00450d", "primary-container": "#065f18", background: "#faf9f5", surface: "#faf9f5", "surface-container-low": "#f4f4f0", "surface-container-lowest": "#ffffff", "on-surface": "#1a1c1a", "on-surface-variant": "#41493e", outline: "#717a6d", "outline-variant": "#c0c9bb", tertiary: "#313f25" }, fontFamily: { headline: ["Plus Jakarta Sans"], body: ["Plus Jakarta Sans"] } } } }
    </script>
    <link rel="stylesheet" href="~/css/pages/farmer/login.css" asp-append-version="true"/>
</head>
<body class="bg-[#121411] font-body text-on-background min-h-screen flex items-center justify-center m-0 p-0 overflow-hidden">

<div id="notificationArea" class="fixed top-4 right-4 z-[9999] w-full max-w-sm flex flex-col gap-2 pointer-events-none"></div>

<a href="/" class="fixed top-4 sm:top-6 left-4 sm:left-6 z-[100] flex items-center gap-2 text-white/90 hover:text-white bg-white/15 hover:bg-white/25 px-4 py-2.5 rounded-full backdrop-blur-md border border-white/30 shadow-lg transition-all duration-300 hover:scale-105 group text-decoration-none">
    <span class="material-symbols-outlined text-[18px] group-hover:-translate-x-1 transition-transform">arrow_back</span>
    <span class="text-sm font-bold tracking-wide">Home</span>
</a>

<div class="fixed top-4 sm:top-6 right-4 sm:right-6 z-[100]">
    <button onclick="document.getElementById('langMenu').classList.toggle('hidden')" class="flex items-center gap-2 text-primary hover:text-white bg-white/70 hover:bg-primary/90 px-4 py-2 sm:py-2.5 rounded-full backdrop-blur-md border border-primary/20 shadow-lg transition-all duration-300 hover:scale-105">
        <span class="material-symbols-outlined text-[18px]">language</span>
        <span class="text-sm font-bold tracking-wide">Language</span>
    </button>
    <div id="langMenu" class="absolute right-0 mt-2 w-36 bg-white rounded-xl shadow-xl border border-black/5 flex flex-col hidden overflow-hidden transition-all duration-300">
        <button class="text-left px-4 py-2 hover:bg-gray-100 text-sm font-semibold transition-colors text-on-surface" onclick="changeLanguage('en')">🇺🇸 English</button>
        <button class="text-left px-4 py-2 hover:bg-gray-100 text-sm font-semibold transition-colors text-on-surface" onclick="changeLanguage('hi')">🇮🇳 हिन्दी</button>
        <button class="text-left px-4 py-2 hover:bg-gray-100 text-sm font-semibold transition-colors text-on-surface" onclick="changeLanguage('gu')">🇮🇳 ગુજરાતી</button>
    </div>
</div>

<div class="relative w-full h-screen flex items-center justify-center">
    <div class="absolute inset-0 z-0">
        <img src="https://images.unsplash.com/photo-1500382017468-9049fed747ef?q=80&w=2000&auto=format&fit=crop" alt="Agriculture Farm" class="w-full h-full object-cover"/>
        <div class="absolute inset-0 bg-primary/20 backdrop-blur-[2px]"></div>
    </div>

    <main class="relative z-10 w-full px-4 sm:px-6 flex flex-col items-center max-w-[520px]">
        <div id="loginSection" class="glass-panel w-full rounded-[2rem] shadow-[0_40px_80px_rgba(0,45,13,0.25)] border border-white/40 p-8 sm:p-10 transition-all duration-300">
            <div class="flex flex-col items-center text-center mb-8">
                <div class="w-16 h-16 bg-gradient-to-br from-primary to-primary-container rounded-full flex items-center justify-center mb-4 shadow-lg shadow-primary/20">
                    <span class="material-symbols-outlined text-white text-3xl" style="font-variation-settings: 'FILL' 1;">agriculture</span>
                </div>
                <h1 class="text-3xl font-headline font-extrabold text-primary tracking-tight mb-1">FarmBridge</h1>
                <p class="text-on-surface-variant font-medium text-sm">Login to your account</p>
            </div>

            <form id="loginForm" class="space-y-5" onsubmit="event.preventDefault(); handleLogin(event); return false;" novalidate>
                <div class="space-y-1.5">
                    <label for="emailOrPhone" class="block text-xs font-bold uppercase tracking-widest text-on-surface-variant/80 px-1">Email or Phone</label>
                    <input id="emailOrPhone" name="emailOrPhone" type="text" required autocomplete="username" class="w-full bg-white/70 border border-outline-variant/50 rounded-xl py-3.5 px-5 text-on-surface focus:bg-white focus:ring-2 focus:ring-primary/40 focus:border-primary transition-all placeholder:text-outline/50 shadow-inner" placeholder="agronomist@farmbridge.com"/>
                </div>

                <div class="space-y-1.5">
                    <div class="flex justify-between items-center px-1">
                        <label for="password" class="block text-xs font-bold uppercase tracking-widest text-on-surface-variant/80">Password</label>
                        <a id="forgotPasswordLink" href="#" class="text-xs font-bold text-primary hover:text-primary-container transition-colors">Forgot Password?</a>
                    </div>
                    <div class="relative">
                        <input id="password" name="password" type="password" required autocomplete="current-password" class="w-full bg-white/70 border border-outline-variant/50 rounded-xl py-3.5 pl-5 pr-12 text-on-surface focus:bg-white focus:ring-2 focus:ring-primary/40 focus:border-primary transition-all placeholder:text-outline/50 shadow-inner" placeholder="••••••••"/>
                        <button type="button" onclick="togglePassword()" class="absolute right-4 top-1/2 -translate-y-1/2 text-outline hover:text-primary transition-colors">
                            <span class="material-symbols-outlined text-[20px]" id="eyeIcon">visibility</span>
                        </button>
                    </div>
                </div>

                <button id="submitBtn" type="submit" class="w-full py-4 mt-2 bg-gradient-to-br from-primary to-primary-container text-white font-bold rounded-full shadow-lg shadow-primary/30 hover:shadow-xl hover:scale-[1.02] active:scale-[0.98] transition-all duration-300">Sign In</button>
            </form>

            <div class="relative flex items-center my-6">
                <div class="flex-grow border-t border-outline-variant/50"></div>
                <span class="px-4 text-[10px] font-bold uppercase tracking-widest text-outline/80">Or continue with</span>
                <div class="flex-grow border-t border-outline-variant/50"></div>
            </div>

            <button id="googleLoginBtn" onclick="handleGoogleLogin()" type="button" class="flex items-center justify-center gap-3 w-full py-3.5 bg-white rounded-full text-on-surface font-semibold shadow-sm hover:bg-gray-50 hover:shadow transition-all border border-outline-variant/30 mb-6">
                <svg class="w-5 h-5" viewBox="0 0 24 24">
                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"></path><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"></path><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"></path><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"></path>
                </svg> Google
            </button>

            <p class="text-center text-sm font-medium text-on-surface-variant">Don't have an account? <a href="/Farmer/Register" class="text-primary font-bold hover:underline ml-1">Register as Farmer</a></p>
        </div>

        <div id="forgotPasswordSection" class="glass-panel w-full rounded-[2rem] shadow-[0_40px_80px_rgba(0,45,13,0.25)] border border-white/40 p-8 sm:p-10 transition-all duration-300" style="display: none;">
            <div class="flex flex-col items-center text-center mb-8">
                <div class="w-16 h-16 bg-gradient-to-br from-primary to-primary-container rounded-full flex items-center justify-center mb-4 shadow-lg shadow-primary/20">
                    <span class="material-symbols-outlined text-white text-3xl">lock_reset</span>
                </div>
                <h2 class="text-2xl font-headline font-extrabold text-primary tracking-tight mb-1">Reset Password</h2>
                <p class="text-on-surface-variant font-medium text-sm">Enter your email to receive an OTP.</p>
            </div>

            <form id="forgotForm" class="space-y-5" onsubmit="event.preventDefault(); handleForgot(event); return false;" novalidate>
                <div class="space-y-1.5">
                    <label for="forgotEmail" class="block text-xs font-bold uppercase tracking-widest text-on-surface-variant/80 px-1">Email Address</label>
                    <input id="forgotEmail" name="email" type="email" required autocomplete="email" class="w-full bg-white/70 border border-outline-variant/50 rounded-xl py-3.5 px-5 text-on-surface focus:bg-white focus:ring-2 focus:ring-primary/40 focus:border-primary transition-all placeholder:text-outline/50 shadow-inner" placeholder="you@example.com"/>
                </div>

                <div class="space-y-1.5">
                    <label for="otp" class="block text-xs font-bold uppercase tracking-widest text-on-surface-variant/80 px-1">OTP (If received)</label>
                    <input id="otp" name="otp" type="text" maxlength="6" autocomplete="one-time-code" class="w-full bg-white/70 border border-outline-variant/50 rounded-xl py-3.5 px-5 text-on-surface focus:bg-white focus:ring-2 focus:ring-primary/40 focus:border-primary transition-all placeholder:text-outline/50 shadow-inner text-center tracking-[0.5em] font-bold text-lg" placeholder="------"/>
                </div>

                <button id="forgotBtn" type="submit" class="w-full py-4 mt-4 bg-gradient-to-br from-primary to-primary-container text-white font-bold rounded-full shadow-lg shadow-primary/30 hover:shadow-xl hover:scale-[1.02] active:scale-[0.98] transition-all duration-300">Send OTP / Reset</button>
            </form>

            <div class="mt-6 text-center">
                <a href="#" id="backToLoginLink" class="text-sm font-bold text-primary hover:text-primary-container flex items-center justify-center gap-1">
                    <span class="material-symbols-outlined text-[16px]">arrow_back</span> Back to Login
                </a>
            </div>
        </div>
    </main>
</div>

    <script src="~/js/pages/farmer/login.js" asp-append-version="true"></script>
<script src="~/js/layouts/platform_i18n.js" asp-append-version="true"></script>
<script src="~/js/layouts/site.js" asp-append-version="true"></script>
</body>
</html>