@{
    Layout = "~/Views/Shared/Layouts/_VendorLayout.cshtml";
    ViewData["Title"] = "Catalog";
}

<link rel="stylesheet" href="~/css/pages/vendor/catalog.css" asp-append-version="true" />

<div class="catalog-page-header">
    <div>
        <h1 class="catalog-page-title">
            <i class="fi fi-rr-seedling"></i>
            <span data-i18n="cat_title">Product Catalog</span>
        </h1>
        <p class="catalog-page-subtitle" data-i18n="cat_subtitle">Premium harvests sourced directly from certified farmers</p>
    </div>
    <div class="header-buttons">
        <button class="wishlist-top-btn" onclick="location.href='/Vendor/Wishlist'">
            <i class="fi fi-rr-heart"></i>
            <span data-i18n="cat_wishlist">My Wishlist</span>
            <span class="wishlist-count" id="wishlistCount">0</span>
        </button>
        <button class="cart-redirect-btn" onclick="location.href='/Vendor/Checkout'">
            <i class="fi fi-rr-shopping-cart"></i>
            <span data-i18n="cat_cart">Cart</span>
            <span class="cart-badge" id="headerCartCount">0</span>
        </button>
    </div>
</div>

<div class="catalog-filters">
    <div class="search-container">
        <i class="fi fi-rr-search"></i>
        <input type="text" class="filter-input" id="searchInput" data-i18n-placeholder="cat_search_ph" placeholder="Search by crop name, category, grade..."
               autocomplete="off">
    </div>
    <!-- Custom Category Dropdown -->
    <div class="fb-dropdown" id="categoryDropdown">
        <div class="fb-dropdown-trigger">
            <span><i class="fi fi-rr-apps" style="margin-right: 8px;"></i> <span data-i18n="cat_all_cat">All Categories</span></span>
            <i class="fi fi-rr-angle-small-down"></i>
        </div>
        <div class="fb-dropdown-menu">
            <div class="fb-dropdown-item active" data-value="all"><i class="fi fi-rr-apps"></i> <span data-i18n="cat_all_cat">All Categories</span></div>
            <div class="fb-dropdown-item" data-value="Grain">🌾 <span data-i18n="cat_cat_grain">Grains</span></div>
            <div class="fb-dropdown-item" data-value="Oilseed">🌻 <span data-i18n="cat_cat_oilseed">Oilseeds</span></div>
            <div class="fb-dropdown-item" data-value="Pulse">🫘 <span data-i18n="cat_cat_pulse">Pulses</span></div>
            <div class="fb-dropdown-item" data-value="Spice">🌶️ <span data-i18n="cat_cat_spice">Spices</span></div>
            <div class="fb-dropdown-item" data-value="Other">📦 <span data-i18n="cat_cat_other">Others</span></div>
        </div>
        <select id="categoryFilter" style="display: none;">
            <option value="all">All Categories</option>
            <option value="Grain">Grain</option>
            <option value="Oilseed">Oilseed</option>
            <option value="Pulse">Pulse</option>
            <option value="Spice">Spice</option>
            <option value="Other">Other</option>
        </select>
    </div>

    <!-- Custom Sort Dropdown -->
    <div class="fb-dropdown" id="sortDropdown">
        <div class="fb-dropdown-trigger">
            <span><i class="fi fi-rr-sort-amount-down" style="margin-right: 8px;"></i> <span data-i18n="cat_def_sort">Default Sort</span></span>
            <i class="fi fi-rr-angle-small-down"></i>
        </div>
        <div class="fb-dropdown-menu">
            <div class="fb-dropdown-item active" data-value="default"><i class="fi fi-rr-refresh"></i> <span data-i18n="cat_def_sort">Default Sort</span></div>
            <div class="fb-dropdown-item" data-value="price-low"><i class="fi fi-rr-arrow-trend-up"></i> <span data-i18n="cat_price_low">Price: Low to High</span></div>
            <div class="fb-dropdown-item" data-value="price-high"><i class="fi fi-rr-arrow-trend-down"></i> <span data-i18n="cat_price_high">Price: High to Low</span></div>
            <div class="fb-dropdown-item" data-value="newest"><i class="fi fi-rr-clock"></i> <span data-i18n="cat_newest">Newest First</span></div>
        </div>
        <select id="sortFilter" style="display: none;">
            <option value="default">Default Sort</option>
            <option value="price-low">Price: Low to High</option>
            <option value="price-high">Price: High to Low</option>
            <option value="newest">Newest First</option>
        </select>
    </div>
</div>

<!-- Search Results Info -->
<div id="searchResultsInfo"
     style="display: none; padding: 10px 15px; background: #e8f5e9; border-radius: 8px; margin-bottom: 15px;">
    <i class="fi fi-rr-info"></i>
    <span data-i18n="cat_search_results">Showing search results for:</span> <strong id="searchQueryText"></strong>
    <button id="clearSearch" class="btn btn-sm btn-link" style="float: right;" data-i18n="cat_clear">Clear</button>
</div>

<div id="catalogGrid">
    <!-- FBSkeleton will inject cards here via catalog.js or inline script -->
</div>

<div id="quantityWindow" style="display: none; padding: 0;">
    <div class="premium-modal-card">
        <div class="modal-product-info">
            <div id="popupProductIcon" class="modal-icon-wrap"></div>
            <div class="modal-text-wrap">
                <h3 id="popupProductName">Product Name</h3>
                <div id="popupStockInfo" class="stock-badge"><span data-i18n="cat_qty_avail">Available</span>: 0 kg</div>
            </div>
        </div>
        
        <div class="quantity-control-section">
            <label class="qty-label" data-i18n="cat_qty_title">Order Quantity</label>
            <div class="modern-stepper-pill">
                <button id="qtyMinus" class="pill-step-btn" onclick="catalogStepQty(-1)"><i class="fi fi-rr-minus-small"></i></button>
                <div class="pill-input-area">
                    <input type="number" id="popupQuantity" value="20" min="20" step="5" oninput="clampCatalogInput()">
                    <span class="pill-unit">kg</span>
                </div>
                <button id="qtyPlus" class="pill-step-btn" onclick="catalogStepQty(1)"><i class="fi fi-rr-plus-small"></i></button>
            </div>
        </div>

        <div class="price-display-card">
            <div class="price-label" data-i18n="cat_qty_total">Estimated Total Investment</div>
            <div id="popupTotalPrice" class="total-price-value">₹0</div>
        </div>

        <div class="modal-footer-actions">
            <button id="cancelQtyBtn" class="btn-modal-cancel" onclick="closeCatalogModal()">
                <i class="fi fi-rr-cross-small"></i> <span data-i18n="cat_qty_cancel">Cancel</span>
            </button>
            <button id="confirmQtyBtn" class="btn-modal-confirm" onclick="confirmAddToCart()">
                <i class="fi fi-rr-shopping-cart-add"></i> <span data-i18n="cat_qty_add">Add to Cart</span>
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lodash.js/4.17.21/lodash.min.js"></script>
    <script src="~/js/pages/vendor/catalog.js" asp-append-version="true"></script>
}