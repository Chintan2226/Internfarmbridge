@{
    Layout = "~/Views/Shared/Layouts/_VendorLayout.cshtml";
    ViewData["Title"] = "My Orders";
}

<link rel="stylesheet" href="~/css/pages/vendor/orders.css" asp-append-version="true" />

<div class="orders-page-wrapper reveal">
    <div class="orders-header-card glass-morphism">
        <div class="header-main-info">
            <div class="header-icon-wrap">
                <i class="fi fi-rr-shopping-bag"></i>
            </div>
            <div>
                <h1 class="orders-page-title" data-i18n="ord_title">My Orders</h1>
                <p class="orders-page-desc" data-i18n="ord_subtitle">Track and manage your procurement history with FarmBridge</p>
            </div>
        </div>
        <div class="header-actions">
            <div class="search-box">
                <i class="fi fi-rr-search"></i>
                <input type="text" id="orderSearch" data-i18n-placeholder="ord_search_ph" placeholder="Search by Order ID..." onkeyup="filterOrders()">
            </div>
            <div class="filter-group">
                <select id="statusFilter" onchange="filterOrders()">
                    <option value="all" data-i18n="ord_status_all">All Statuses</option>
                    <option value="placed" data-i18n="ord_status_placed">Placed</option>
                    <option value="confirmed" data-i18n="ord_status_confirmed">Confirmed</option>
                    <option value="dispatched" data-i18n="ord_status_transit">In Transit</option>
                    <option value="delivered" data-i18n="ord_status_delivered">Delivered</option>
                    <option value="cancelled" data-i18n="ord_status_cancelled">Cancelled</option>
                </select>
            </div>
        </div>
    </div>

    <div id="ordersContainer" class="orders-grid">
        <!-- Order cards will be injected here -->
    </div>
</div>

<!-- Cancellation Modal (Premium Glassmorphic) -->
<div class="modal-overlay" id="cancelModal">
    <div class="modal-box glass-morphism">
        <div class="modal-header">
            <div class="modal-icon error">
                <i class="fi fi-rr-cross-circle"></i>
            </div>
            <h4 data-i18n="ord_cancel_title">Cancel Order</h4>
        </div>
        <p class="modal-desc" data-i18n="ord_cancel_desc">Are you sure you want to cancel this order? This action cannot be undone once confirmed.</p>
        <div class="form-group">
            <label for="cancelReason" data-i18n="ord_cancel_reason">Reason for Cancellation</label>
            <textarea id="cancelReason" rows="3" data-i18n-placeholder="ord_cancel_ph" placeholder="Please provide a brief reason..."></textarea>
        </div>
        <div class="modal-buttons">
            <button class="modal-btn modal-btn-secondary" onclick="closeCancelModal()" data-i18n="ord_cancel_back">
                Go Back
            </button>
            <button class="modal-btn modal-btn-danger" onclick="confirmCancel()" data-i18n="ord_cancel_confirm">
                Confirm Cancellation
            </button>
        </div>
    </div>
</div>

<span id="popupNotification"></span>

@section Scripts {
    <script src="~/js/pages/vendor/orders.js" asp-append-version="true"></script>
}
