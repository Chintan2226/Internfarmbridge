@using Razorpay.Api
@{
    Layout = "~/Views/Shared/Layouts/_VendorLayout.cshtml";
    ViewData["Title"] = "Track Order";
    var orderId = Context.Request.Query["id"].ToString();
}


<link rel="stylesheet" href="~/css/pages/vendor/ordertracking.css" asp-append-version="true" />


<div class="tracking-page-wrapper reveal">
    <!-- Main Header -->
    <div class="tracking-main-header glass-morphism animate-in">
        <div class="header-left">
            <div class="status-indicator">
                <div class="pulse-ring"></div>
                <i class="fas fa-route"></i>
            </div>
            <div class="header-text">
                <h1 class="page-title">Track Journey</h1>
                <p class="page-subtitle">Real-time procurement tracking for Order <span class="text-emerald">#@orderId</span></p>
            </div>
        </div>
        <div class="header-right">
            <button class="btn-back-minimal" onclick="location.href='/Vendor/Orders'">
                <i class="fi fi-rr-arrow-small-left"></i>
                <span>Back to Orders</span>
            </button>
        </div>
    </div>

    <!-- Dashboard Grid -->
    <div class="tracking-dashboard-grid" id="trackingContent">
        <!-- Skeletons or Content will be injected here -->
    </div>
</div>

@section Scripts {
<script>
    const API_URL = 'http://localhost:5020/api/Vendor';
    const orderId = '@orderId';

    function getCookie(name) {
        const value = `; ${document.cookie}`;
        const parts = value.split(`; ${name}=`);
        if (parts.length === 2) return parts.pop().split(';').shift();
        return null;
    }

    function showTrackingSkeletons() {
        const container = document.getElementById('trackingContent');
        container.innerHTML = `
            <div class="tracking-col-left">
                <div class="skeleton-card glass-morphism h-full">
                    <div class="skeleton-shimmer h-40 mb-5 w-40"></div>
                    <div class="skeleton-timeline">
                        ${[1, 2, 3, 4, 5].map(() => `<div class="skeleton-step mb-4"></div>`).join('')}
                    </div>
                </div>
            </div>
            <div class="tracking-col-right">
                <div class="skeleton-card glass-morphism mb-4">
                    <div class="skeleton-shimmer h-100"></div>
                </div>
                <div class="skeleton-card glass-morphism">
                    <div class="skeleton-shimmer h-200"></div>
                </div>
            </div>
        `;
    }

    async function loadTracking() {
        if (!orderId) {
            showError("Order ID is missing.");
            return;
        }

        showTrackingSkeletons();

        try {
            const token = getCookie('authToken');
            const response = await fetch(`${API_URL}/orders/track/${orderId}`, {
                method: 'GET',
                headers: {
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json'
                }
            });

            if (response.status === 401) {
                showError("Session expired. Please login again.");
                return;
            }

            const result = await response.json();
            if (result.success && result.data) {
                setTimeout(() => displayTracking(result.data), 800);
            } else {
                showError(result.message || "Order details not found.");
            }
        } catch (error) {
            showError("Unable to connect to the server.");
        }
    }

    function displayTracking(data) {
        const isCancelled = data.status.toLowerCase() === 'cancelled' || data.status.toLowerCase() === 'canceled';
        
        const statusSteps = [
            { key: 'placed',      dbStatus: 'placed',         label: 'Order Placed', desc: 'Order received and logged.',         icon: 'fi-rr-shopping-cart-add' },
            { key: 'confirmed',   dbStatus: 'admin_confirmed', label: 'Confirmed',    desc: 'Order verified by FarmBridge.',       icon: 'fi-rr-box-check' },
            { key: 'dispatched',  dbStatus: 'dispatched',      label: 'Dispatched',   desc: 'Package left the warehouse.',          icon: 'fi-rr-truck-loading' },
            { key: 'transit',     dbStatus: 'in_transit',      label: 'In Transit',   desc: 'Journey to destination started.',      icon: 'fi-rr-map-marker' },
            { key: 'delivered',   dbStatus: 'delivered',       label: 'Delivered',    desc: 'Handover complete.',                   icon: 'fi-rr-badge-check' }
        ];

        const currentIdx = statusSteps.findIndex(s => s.dbStatus === data.status);
        const statusText = data.status.replace('_', ' ').toUpperCase();

        // Billing calculations
        const subtotal = data.items.reduce((sum, item) => sum + (item.total || 0), 0);
        const otherFees = (data.totalAmount || 0) - subtotal;

        // Header Updates
        if (isCancelled) {
            document.querySelector('.page-title').textContent = 'Order Details';
            document.querySelector('.status-indicator').style.background = '#ef4444';
            document.querySelector('.status-indicator i').className = 'fas fa-times-circle';
        }

        let html = `
            ${!isCancelled ? `
            <!-- Left Column: Timeline -->
            <div class="tracking-col-left animate-in">
                <div class="timeline-card glass-morphism">
                    <div class="card-header-flex">
                        <h3 class="section-title"><i class="fi fi-rr-stats"></i> <span data-i18n="track_journey">Delivery Journey</span></h3>
                        <span class="live-tag"><span class="dot"></span> <span data-i18n="track_live">Live Updates</span></span>
                    </div>
                    
                    <div class="modern-timeline">
                        ${statusSteps.map((step, index) => {
                            let state = 'pending';
                            if (index < currentIdx) state = 'completed';
                            else if (index === currentIdx) state = 'active';

                            const localizedLabel = fbT(`track_step_${step.key}`);
                            const localizedDesc = state === 'pending' ? fbT('track_step_next') : fbT(`track_step_${step.key}_desc`);

                            return `
                                <div class="timeline-node ${state}">
                                    <div class="node-marker">
                                        <div class="node-inner">
                                            <i class="fi ${state === 'completed' ? 'fi-rr-check' : step.icon}"></i>
                                        </div>
                                        <div class="node-line"></div>
                                    </div>
                                    <div class="node-content">
                                        <div class="node-label">${localizedLabel}</div>
                                        <div class="node-desc">${localizedDesc}</div>
                                    </div>
                                </div>
                            `;
                        }).join('')}
                    </div>
                </div>
            </div>
            ` : `
            <!-- Cancelled Message Column -->
            <div class="tracking-col-left animate-in">
                <div class="cancellation-card glass-morphism">
                    <div class="cancel-icon-wrap">
                        <i class="fas fa-ban"></i>
                    </div>
                    <h2 data-i18n="track_cancel_title">This Order was Cancelled</h2>
                    <p data-i18n="track_cancel_desc">We're sorry, but this procurement request has been cancelled. No further tracking updates are available for this journey.</p>
                    <div class="cancel-reason">
                        <small data-i18n="track_status_label">STATUS UPDATE</small>
                        <span data-i18n="track_status_terminated">CANCELLATION CONFIRMED</span>
                    </div>
                </div>
            </div>
            `}

            <!-- Right Column: Details & Items -->
            <div class="tracking-col-right">
                <!-- Info Summary -->
                <div class="info-summary-card glass-morphism animate-in" style="animation-delay: 0.1s">
                    <div class="status-banner">
                        <div class="status-text-wrap">
                            <small data-i18n="track_status_label">CURRENT STATE</small>
                            <h4 style="color: ${isCancelled ? '#ef4444' : 'var(--track-primary)'}">${fbT(`ord_status_${data.status.toLowerCase()}`)}</h4>
                        </div>
                        <div class="tracking-id-pill">
                            <i class="fi fi-rr-paper-plane"></i>
                            <span>#${data.trackingId || 'N/A'}</span>
                        </div>
                    </div>
                    
                    <div class="mini-grid">
                        <div class="mini-pill">
                            <i class="fi fi-rr-calendar"></i>
                            <div>
                                <small data-i18n="track_ordered_on">Ordered On</small>
                                <span>${new Date(data.orderDate).toLocaleDateString(window.CURRENT_LANG === 'gu' ? 'gu-IN' : (window.CURRENT_LANG === 'hi' ? 'hi-IN' : 'en-IN'), { day: '2-digit', month: 'short' })}</span>
                            </div>
                        </div>
                        <div class="mini-pill ${isCancelled ? '' : 'highlight'}">
                            <i class="fi fi-rr-${isCancelled ? 'cross-circle' : 'time-fast'}"></i>
                            <div>
                                <small>${isCancelled ? fbT('db_table_status') : fbT('track_expected_by')}</small>
                                <span>${isCancelled ? fbT('track_status_terminated') : (data.estimatedDelivery ? new Date(data.estimatedDelivery).toLocaleDateString(window.CURRENT_LANG === 'gu' ? 'gu-IN' : (window.CURRENT_LANG === 'hi' ? 'hi-IN' : 'en-IN'), { day: '2-digit', month: 'short' }) : 'TBD')}</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Package Contents -->
                <div class="package-card glass-morphism animate-in" style="animation-delay: 0.2s">
                    <h3 class="section-title"><i class="fi fi-rr-box-open"></i> <span data-i18n="track_items">Items In Order</span></h3>
                    <div class="item-list">
                        ${data.items.map(item => `
                            <div class="item-row">
                                <div class="item-main">
                                    <span class="item-name">${item.productName}</span>
                                    <span class="item-meta">${item.quantity} ${item.unit || 'kg'} &bull; &#8377;${parseFloat(item.price).toFixed(2)}/unit</span>
                                </div>
                                <div class="item-total">&#8377;${parseFloat(item.total).toFixed(2)}</div>
                            </div>
                        `).join('')}
                    </div>

                    <!-- Billing Breakdown -->
                    <div class="billing-breakdown">
                        <div class="billing-row">
                            <span data-i18n="track_subtotal">Subtotal</span>
                            <span>&#8377;${subtotal.toFixed(2)}</span>
                        </div>
                        <div class="billing-row">
                            <span data-i18n="track_service">Service & Delivery</span>
                            <span>&#8377;${otherFees.toFixed(2)}</span>
                        </div>
                    </div>
                    
                    <div class="grand-total-footer" style="${isCancelled ? 'background: #fef2f2; border-color: #fee2e2;' : ''}">
                        <div class="total-label-wrap">
                            <span style="${isCancelled ? 'color: #ef4444;' : ''}" data-i18n="track_final">FINAL TOTAL</span>
                            <small>${isCancelled ? fbT('track_refund_hint') : fbT('track_tax_hint')}</small>
                        </div>
                        <div class="total-amount-wrap" style="${isCancelled ? 'color: #991b1b;' : ''}">&#8377;${parseFloat(data.totalAmount).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</div>
                    </div>
                </div>
            </div>
        `;
        document.getElementById('trackingContent').innerHTML = html;
        if (window.fbInit) fbInit();
        document.querySelector('.tracking-page-wrapper').classList.add('visible');
    }

    function showError(msg) {
        document.getElementById('trackingContent').innerHTML = `
            <div class="error-state-card glass-morphism animate-in">
                <div class="error-icon">
                    <i class="fi fi-rr-exclamation"></i>
                </div>
                <h3 data-i18n="track_err_title">Journey Interrupted</h3>
                <p>${msg}</p>
                <button class="btn-premium" onclick="location.href='/Vendor/Orders'">
                    <i class="fi fi-rr-arrow-left"></i>
                    <span data-i18n="track_err_back">Return to My Orders</span>
                </button>
            </div>
        `; 
        if (window.fbInit) fbInit();
    }

    window.addEventListener('load', loadTracking);
</script>
}



