@using Razorpay.Api
@{
    Layout = "~/Views/Shared/Layouts/_VendorLayout.cshtml";
    ViewData["Title"] = "Track Order";
    var orderId = Context.Request.Query["id"].ToString();
}

<style>
    /* ========== ORDER TRACKING PAGE ENHANCED STYLING ========== */
    
    .tracking-header {
        margin-bottom: 28px;
    }

    .tracking-title {
        font-family: 'Playfair Display', serif;
        font-size: 32px;
        font-weight: 700;
        color: #0a2108;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .tracking-container {
        max-width: 900px;
        margin: 0 auto;
    }

    /* Info Card */
    .order-info-card {
        background: rgba(255, 255, 255, 0.82);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 28px;
        margin-bottom: 24px;
        box-shadow: 0 4px 24px rgba(21, 66, 18, 0.07), 0 1px 4px rgba(21, 66, 18, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.5);
    }

    .order-info-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--border-soft, rgba(45, 122, 39, 0.12));
        flex-wrap: wrap;
        gap: 12px;
    }

    .order-info-header h4 {
        font-family: 'Playfair Display', serif;
        font-size: 24px;
        font-weight: 700;
        color: #1b5e19;
        margin: 0;
    }

    .status-badge {
        display: inline-block;
        padding: 8px 16px;
        border-radius: 24px;
        font-size: 12px;
        font-weight: 700;
        background: linear-gradient(135deg, #2d7a27 0%, #1b5e19 100%);
        color: white;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 24px;
    }

    .info-item {
        display: flex;
        flex-direction: column;
    }

    .info-label {
        font-size: 11px;
        font-weight: 700;
        color: #5a7257;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
    }

    .info-value {
        font-weight: 700;
        color: #1b5e19;
        font-size: 18px;
        font-family: 'Playfair Display', serif;
    }

    /* Timeline */
    .timeline-container {
        background: rgba(255, 255, 255, 0.82);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 32px;
        box-shadow: 0 4px 24px rgba(21, 66, 18, 0.07), 0 1px 4px rgba(21, 66, 18, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.5);
        margin-bottom: 24px;
    }

    .timeline-title {
        font-family: 'Playfair Display', serif;
        font-size: 20px;
        font-weight: 700;
        color: #1b5e19;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .timeline-step {
        position: relative;
        padding-bottom: 32px;
        padding-left: 50px;
    }

    .timeline-step:last-child {
        padding-bottom: 0;
    }

    .timeline-dot {
        position: absolute;
        left: 0;
        top: 0;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        font-weight: 700;
        z-index: 2;
        border: 2px solid white;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .timeline-dot.completed {
        background: linear-gradient(135deg, #2d7a27 0%, #1b5e19 100%);
        color: white;
    }

    .timeline-dot.active {
        background: linear-gradient(135deg, #f4a621 0%, #E8720C 100%);
        color: white;
        animation: pulse 1.5s ease-in-out infinite;
    }

    .timeline-dot.pending {
        background: var(--green-50, #eaf7e8);
        color: #cbd5e1;
        border-color: var(--border-soft, rgba(45, 122, 39, 0.12));
    }

    @@keyframes pulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.15); box-shadow: 0 0 0 4px rgba(244, 166, 33, 0.2), 0 2px 8px rgba(0, 0, 0, 0.1); }
    }

    .timeline-line {
        position: absolute;
        left: 19px;
        top: 40px;
        bottom: -20px;
        width: 2px;
        background: var(--border-soft, rgba(45, 122, 39, 0.12));
        z-index: 1;
    }

    .timeline-dot.completed ~ .timeline-line {
        background: linear-gradient(180deg, #2d7a27 0%, var(--border-soft, rgba(45, 122, 39, 0.12)) 100%);
    }

    .timeline-step:last-child .timeline-line {
        display: none;
    }

    .timeline-content {
        padding-top: 4px;
    }

    .timeline-content-title {
        font-weight: 700;
        color: #1b5e19;
        margin-bottom: 4px;
        font-size: 15px;
    }

    .timeline-desc {
        font-size: 13px;
        color: #5a7257;
    }

    /* Items Card */
    .items-card {
        background: rgba(255, 255, 255, 0.82);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 28px;
        box-shadow: 0 4px 24px rgba(21, 66, 18, 0.07), 0 1px 4px rgba(21, 66, 18, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.5);
        margin-bottom: 24px;
    }

    .items-card h5 {
        font-family: 'Playfair Display', serif;
        font-size: 20px;
        font-weight: 700;
        color: #1b5e19;
        margin-bottom: 20px;
    }

    .items-table {
        width: 100%;
        border-collapse: collapse;
    }

    .items-table th {
        color: #5a7257;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 2px solid var(--border-soft, rgba(45, 122, 39, 0.12));
        padding: 12px 0;
        text-align: left;
    }

    .items-table td {
        padding: 16px 0;
        border-bottom: 1px solid var(--border-soft, rgba(45, 122, 39, 0.12));
        color: #5a7257;
        font-size: 14px;
    }

    .items-table tbody tr:hover {
        background: var(--green-50, #eaf7e8);
    }

    .items-table strong {
        color: #1b5e19;
    }

    .items-table small {
        color: #94a3b8;
    }

    .total-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 24px;
        padding-top: 16px;
        border-top: 2px solid var(--border-soft, rgba(45, 122, 39, 0.12));
    }

    .total-row span:first-child {
        font-size: 16px;
        font-weight: 700;
        color: #1b5e19;
        font-family: 'Playfair Display', serif;
    }

    .total-row span:last-child {
        font-size: 26px;
        font-weight: 800;
        color: #2d7a27;
        font-family: 'Playfair Display', serif;
    }

    /* Action Button */
    .tracking-actions {
        text-align: center;
        margin-top: 32px;
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 28px;
        border-radius: 24px;
        background: linear-gradient(135deg, #2d7a27 0%, #1b5e19 100%);
        color: white;
        text-decoration: none;
        font-weight: 700;
        font-size: 14px;
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
        font-family: 'Poppins', sans-serif;
    }

    .back-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(45, 122, 39, 0.3);
    }

    /* Error State */
    .tracking-error {
        text-align: center;
        padding: 80px 40px;
        background: rgba(255, 255, 255, 0.82);
        border-radius: 20px;
        box-shadow: 0 4px 24px rgba(21, 66, 18, 0.07);
    }

    .tracking-error i {
        font-size: 64px;
        color: #dc2626;
        margin-bottom: 20px;
    }

    .tracking-error h4 {
        color: #1b5e19;
        margin-bottom: 12px;
        font-family: 'Playfair Display', serif;
        font-size: 24px;
    }

    .tracking-error p {
        color: #5a7257;
        margin-bottom: 24px;
    }

    @@media (max-width: 768px) {
        .tracking-container {
            padding: 0;
        }

        .order-info-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .info-grid {
            grid-template-columns: 1fr;
        }

        .timeline-step {
            padding-left: 40px;
        }

        .timeline-line {
            left: 15px;
        }

        .items-table {
            font-size: 12px;
        }

        .items-table th, .items-table td {
            padding: 8px 0;
        }
    }
</style>

<div class="tracking-header">
    <h1 class="tracking-title">
        <i class="fi fi-rr-map-marker-check"></i>
        Track Your Order
    </h1>
</div>

<div class="tracking-container">
    <div id="trackingContent">
        <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 80px 40px; background: rgba(255, 255, 255, 0.82); border-radius: 20px; gap: 16px;">
            <div style="width: 48px; height: 48px; border: 3px solid rgba(45, 122, 39, 0.1); border-top-color: #2d7a27; border-radius: 50%; animation: spin 0.8s linear infinite;"></div>
            <span style="color: #5a7257; font-size: 14px;">Fetching your order journey...</span>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const API_URL = 'http://localhost:5020/api/Vendor';
    const orderId = '@orderId';

    function getCookie(name) {
        const value = `; ${document.cookie}`;
        const parts = value.split(`; ${name}=`);
        if (parts.length === 2) return parts.pop().split(';').shift();
        return null;
    }

    async function loadTracking() {
        if (!orderId) {
            showError("Order ID is missing.");
            return;
        }

        try {
            const token = getCookie('authToken');
            const response = await fetch(`${API_URL}/orders/track/${orderId}`, {
                method: 'GET',
                headers: {
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json'
                }
            });

            if (response.status === 401) {
                showError("Session expired. Please login again.");
                return;
            }

            const result = await response.json();
            if (result.success && result.data) {
                displayTracking(result.data);
            } else {
                showError(result.message || "Order details not found.");
            }
        } catch (error) {
            showError("Unable to connect to the server.");
        }
    }

    function displayTracking(data) {
        const statusSteps = [
            { key: 'placed', label: 'Order Placed', desc: 'We have received your order.' },
            { key: 'admin_confirmed', label: 'Confirmed', desc: 'Vendor has accepted the order.' },
            { key: 'dispatched', label: 'Dispatched', desc: 'Package is ready for transit.' },
            { key: 'in_transit', label: 'In Transit', desc: 'On the way to your location.' },
            { key: 'delivered', label: 'Delivered', desc: 'Successfully received.' }
        ];

        const statusOrder = ['placed', 'admin_confirmed', 'dispatched', 'in_transit', 'delivered'];
        const currentIdx = statusOrder.indexOf(data.status);

        let html = `
            <div class="order-info-card">
                <div class="order-info-header">
                    <h4><i class="fi fi-rr-tag"></i> Order #${data.orderId}</h4>
                    <span class="status-badge">${data.status.replace('_', ' ').toUpperCase()}</span>
                </div>
                <div class="info-grid">
                    <div class="info-item">
                        <span class="info-label">Placed On</span>
                        <span class="info-value">${new Date(data.orderDate).toLocaleDateString('en-IN')}</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Tracking ID</span>
                        <span class="info-value">${data.trackingId || 'TBA'}</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Est. Delivery</span>
                        <span class="info-value" style="color: #2d7a27;">${data.estimatedDelivery ? new Date(data.estimatedDelivery).toLocaleDateString('en-IN') : 'Updating...'}</span>
                    </div>
                </div>
            </div>

            <div class="timeline-container">
                <div class="timeline-title"><i class="fi fi-rr-navigation"></i>Delivery Progress</div>
                ${statusSteps.map((step, index) => {
                    let state = 'pending';
                    if (index < currentIdx) state = 'completed';
                    else if (index === currentIdx) state = 'active';

                    return `
                        <div class="timeline-step">
                            <div class="timeline-dot ${state}">
                                ${state === 'completed' ? '<i class="fi fi-rr-check"></i>' : (index + 1)}
                            </div>
                            <div class="timeline-line"></div>
                            <div class="timeline-content">
                                <div class="timeline-content-title">${step.label}</div>
                                <div class="timeline-desc">${state === 'pending' ? 'Waiting...' : step.desc}</div>
                            </div>
                        </div>
                    `;
                }).join('')}
            </div>

            <div class="items-card">
                <h5><i class="fi fi-rr-box"></i> Items Summary</h5>
                <table class="items-table">
                    <thead><tr><th>Product</th><th>Quantity</th><th>Price</th><th>Total</th></tr></thead>
                    <tbody>
                        ${data.items.map(item => `
                            <tr>
                                <td><strong>${item.productName}</strong><br><small>Farmer: ${item.farmerName || 'Market'}</small></td>
                                <td>${item.quantity} ${item.unit || 'kg'}</td>
                                <td>₹${item.price}</td>
                                <td><strong>₹${item.total}</strong></td>
                            </tr>
                        `).join('')}
                    </tbody>
                </table>
                <div class="total-row">
                    <span>Grand Total</span>
                    <span>₹${data.totalAmount.toLocaleString('en-IN')}</span>
                </div>
            </div>
            
            <div class="tracking-actions">
                <a href="/Vendor/Orders" class="back-btn">
                    <i class="fi fi-rr-arrow-left"></i> Back to Orders
                </a>
            </div>
        `;
        document.getElementById('trackingContent').innerHTML = html;
    }

    function showError(msg) {
        document.getElementById('trackingContent').innerHTML = `
            <div class="tracking-error">
                <i class="fi fi-rr-exclamation"></i>
                <h4>${msg}</h4>
                <a href="/Vendor/Orders" class="back-btn">
                    <i class="fi fi-rr-arrow-left"></i> Return to Orders
                </a>
            </div>
        `; 
    }

    window.addEventListener('load', loadTracking);
</script>
}

