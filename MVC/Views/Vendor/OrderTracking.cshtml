@using Razorpay.Api
@{
    Layout = "~/Views/Shared/Layouts/_VendorLayout.cshtml";
    ViewData["Title"] = "Track Order";
    var orderId = Context.Request.Query["id"].ToString();
}


<link rel="stylesheet" href="~/css/pages/vendor/ordertracking.css" asp-append-version="true" />


<div class="tracking-header">
    <h1 class="tracking-title">
        <i class="fi fi-rr-map-marker-check"></i>
        Track Your Order
    </h1>
</div>

<div class="tracking-container">
    <div id="trackingContent">
        <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 80px 40px; background: rgba(255, 255, 255, 0.82); border-radius: 20px; gap: 16px;">
            <div style="width: 48px; height: 48px; border: 3px solid rgba(45, 122, 39, 0.1); border-top-color: #2d7a27; border-radius: 50%; animation: spin 0.8s linear infinite;"></div>
            <span style="color: #5a7257; font-size: 14px;">Fetching your order journey...</span>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const API_URL = 'http://localhost:5020/api/Vendor';
    const orderId = '@orderId';

    function getCookie(name) {
        const value = `; ${document.cookie}`;
        const parts = value.split(`; ${name}=`);
        if (parts.length === 2) return parts.pop().split(';').shift();
        return null;
    }

    async function loadTracking() {
        if (!orderId) {
            showError("Order ID is missing.");
            return;
        }

        try {
            const token = getCookie('authToken');
            const response = await fetch(`${API_URL}/orders/track/${orderId}`, {
                method: 'GET',
                headers: {
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json'
                }
            });

            if (response.status === 401) {
                showError("Session expired. Please login again.");
                return;
            }

            const result = await response.json();
            if (result.success && result.data) {
                displayTracking(result.data);
            } else {
                showError(result.message || "Order details not found.");
            }
        } catch (error) {
            showError("Unable to connect to the server.");
        }
    }

    function displayTracking(data) {
        const statusSteps = [
            { key: 'placed', label: 'Order Placed', desc: 'We have received your order.' },
            { key: 'admin_confirmed', label: 'Confirmed', desc: 'Vendor has accepted the order.' },
            { key: 'dispatched', label: 'Dispatched', desc: 'Package is ready for transit.' },
            { key: 'in_transit', label: 'In Transit', desc: 'On the way to your location.' },
            { key: 'delivered', label: 'Delivered', desc: 'Successfully received.' }
        ];

        const statusOrder = ['placed', 'admin_confirmed', 'dispatched', 'in_transit', 'delivered'];
        const currentIdx = statusOrder.indexOf(data.status);

        let html = `
            <div class="order-info-card">
                <div class="order-info-header">
                    <h4><i class="fi fi-rr-tag"></i> Order #${data.orderId}</h4>
                    <span class="status-badge">${data.status.replace('_', ' ').toUpperCase()}</span>
                </div>
                <div class="info-grid">
                    <div class="info-item">
                        <span class="info-label">Placed On</span>
                        <span class="info-value">${new Date(data.orderDate).toLocaleDateString('en-IN')}</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Tracking ID</span>
                        <span class="info-value">${data.trackingId || 'TBA'}</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Est. Delivery</span>
                        <span class="info-value" style="color: #2d7a27;">${data.estimatedDelivery ? new Date(data.estimatedDelivery).toLocaleDateString('en-IN') : 'Updating...'}</span>
                    </div>
                </div>
            </div>

            <div class="timeline-container">
                <div class="timeline-title"><i class="fi fi-rr-navigation"></i>Delivery Progress</div>
                ${statusSteps.map((step, index) => {
                    let state = 'pending';
                    if (index < currentIdx) state = 'completed';
                    else if (index === currentIdx) state = 'active';

                    return `
                        <div class="timeline-step">
                            <div class="timeline-dot ${state}">
                                ${state === 'completed' ? '<i class="fi fi-rr-check"></i>' : (index + 1)}
                            </div>
                            <div class="timeline-line"></div>
                            <div class="timeline-content">
                                <div class="timeline-content-title">${step.label}</div>
                                <div class="timeline-desc">${state === 'pending' ? 'Waiting...' : step.desc}</div>
                            </div>
                        </div>
                    `;
                }).join('')}
            </div>

            <div class="items-card">
                <h5><i class="fi fi-rr-box"></i> Items Summary</h5>
                <table class="items-table">
                    <thead><tr><th>Product</th><th>Quantity</th><th>Price</th><th>Total</th></tr></thead>
                    <tbody>
                        ${data.items.map(item => `
                            <tr>
                                <td><strong>${item.productName}</strong><br><small>Farmer: ${item.farmerName || 'Market'}</small></td>
                                <td>${item.quantity} ${item.unit || 'kg'}</td>
                                <td>â‚¹${item.price}</td>
                                <td><strong>â‚¹${item.total}</strong></td>
                            </tr>
                        `).join('')}
                    </tbody>
                </table>
                <div class="total-row">
                    <span>Grand Total</span>
                    <span>â‚¹${data.totalAmount.toLocaleString('en-IN')}</span>
                </div>
            </div>
            
            <div class="tracking-actions">
                <a href="/Vendor/Orders" class="back-btn">
                    <i class="fi fi-rr-arrow-left"></i> Back to Orders
                </a>
            </div>
        `;
        document.getElementById('trackingContent').innerHTML = html;
    }

    function showError(msg) {
        document.getElementById('trackingContent').innerHTML = `
            <div class="tracking-error">
                <i class="fi fi-rr-exclamation"></i>
                <h4>${msg}</h4>
                <a href="/Vendor/Orders" class="back-btn">
                    <i class="fi fi-rr-arrow-left"></i> Return to Orders
                </a>
            </div>
        `; 
    }

    window.addEventListener('load', loadTracking);
</script>
}



