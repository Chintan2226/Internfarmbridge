@{
    Layout = "~/Views/Shared/Layouts/_VendorLayout.cshtml";
    ViewData["Title"] = "Checkout";
}

<link rel="stylesheet" href="~/css/pages/vendor/checkout.css" asp-append-version="true" />

<div class="checkout-root">

    <!-- Page Header -->
    <div class="checkout-page-header">
        <h1 class="checkout-title">
            <i class="fi fi-rr-shopping-cart"></i>
            Checkout &amp; Cart
        </h1>
        <p class="checkout-subtitle">Securely complete your procurement in 3 simple steps</p>
    </div>

    <!-- Stepper -->
    <div class="stepper-wrapper">
        <div class="stepper">
            <div class="step active" data-step="1">
                <div class="step-circle"><i class="fi fi-rr-shopping-bag"></i></div>
                <div class="step-label">Cart</div>
            </div>
            <div class="step" data-step="2">
                <div class="step-circle"><i class="fi fi-rr-map-marker"></i></div>
                <div class="step-label">Shipping</div>
            </div>
            <div class="step" data-step="3">
                <div class="step-circle"><i class="fi fi-rr-check"></i></div>
                <div class="step-label">Review</div>
            </div>
        </div>
    </div>

    <!-- Body -->
    <div class="checkout-body">

        <!-- LEFT: Step Content -->
        <div class="checkout-left">

            <!-- Step 1: Cart -->
            <div id="step1Content" class="checkout-card">
                <div class="checkout-card-header">
                    <h6><i class="fi fi-rr-shopping-cart"></i> Shopping Cart</h6>
                </div>
                <div class="checkout-card-body" id="cartContainer"></div>
                <div class="checkout-card-footer">
                    <button class="btn-next" id="continueToShipping" onclick="goToStep(2)">
                        <span>Continue to Shipping</span>
                        <i class="fi fi-rr-arrow-small-right"></i>
                    </button>
                </div>
            </div>

            <!-- Step 2: Shipping -->
            <div id="step2Content" class="checkout-card" style="display:none;">
                <div class="checkout-card-header">
                    <h6><i class="fi fi-rr-marker"></i> Select Delivery Address</h6>
                </div>
                <div class="checkout-card-body" id="addressList"></div>
                <div class="checkout-card-footer">
                    <button class="btn-back" onclick="goToStep(1)"><i class="fi fi-rr-arrow-small-left"></i> Back</button>
                    <button class="btn-next" onclick="goToStep(3)">
                        <span>Review Order</span>
                        <i class="fi fi-rr-arrow-small-right"></i>
                    </button>
                </div>
            </div>

            <!-- Step 3: Review -->
            <div id="step3Content" class="checkout-card" style="display:none;">
                <div class="checkout-card-header">
                    <h6><i class="fi fi-rr-checkbox"></i> Review Your Order</h6>
                </div>
                <div class="checkout-card-body" id="reviewOrderContainer"></div>
                <div class="checkout-card-footer">
                    <button class="btn-back" onclick="goToStep(2)"><i class="fi fi-rr-arrow-small-left"></i> Back</button>
                    <button class="btn-place" id="placeOrderBtn" onclick="placeOrder()">
                        <i class="fi fi-rr-lock"></i>
                        <span>Confirm &amp; Pay</span>
                    </button>
                </div>
            </div>

        </div>

        <!-- RIGHT: Order Summary -->
        <div class="checkout-right">
            <div class="summary-card">
                <div class="summary-header">
                    <p class="summary-title"><i class="fi fi-rr-receipt"></i> Order Summary</p>
                </div>
                <div class="summary-body">
                    <div class="summary-row">
                        <span class="s-label">Subtotal</span>
                        <span class="s-value" id="subtotal">₹0</span>
                    </div>
                    <div class="summary-row">
                        <span class="s-label">Delivery Fee</span>
                        <span class="s-value" id="deliveryFee">₹100</span>
                    </div>
                    <div class="summary-row">
                        <span class="s-label">Tax (GST 5%)</span>
                        <span class="s-value" id="tax">₹0</span>
                    </div>
                    <div class="summary-divider"></div>
                    <div class="summary-total">
                        <div>
                            <div class="total-label">Total Amount</div>
                            <div class="total-sub">Inc. all taxes</div>
                        </div>
                        <div class="total-value" id="total">₹0</div>
                    </div>
                </div>
                <div class="summary-trust">
                    <div class="trust-item"><i class="fi fi-rr-shield-check"></i><span>Secure Payment</span></div>
                    <div class="trust-item"><i class="fi fi-rr-truck-side"></i><span>Tracked Delivery</span></div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script src="~/js/pages/vendor/checkout.js" asp-append-version="true"></script>
}
