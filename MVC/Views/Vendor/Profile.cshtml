@{
    Layout = "~/Views/Shared/Layouts/_VendorLayout.cshtml";
    ViewData["Title"] = "Profile";
}


<link rel="stylesheet" href="~/css/pages/vendor/profile.css" asp-append-version="true" />


<!-- Location Modal -->
<div id="locationModal" class="location-modal">
    <div class="location-modal-content">
        <div class="location-modal-header">
            <div class="location-modal-title" id="locationModalTitle">Add Delivery Location</div>
            <button class="location-modal-close" onclick="closeLocationModal()">&times;</button>
        </div>
        <div class="form-group">
            <label class="form-label">Address Line <span class="required">*</span></label>
            <input type="text" class="form-control" id="modalAddress" placeholder="Street, Area">
        </div>
        <div class="form-row">
            <div class="form-group">
                <label class="form-label">City <span class="required">*</span></label>
                <input type="text" class="form-control" id="modalCity" placeholder="City">
            </div>
            <div class="form-group">
                <label class="form-label">State <span class="required">*</span></label>
                <input type="text" class="form-control" id="modalState" placeholder="State">
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label class="form-label">Pincode <span class="required">*</span></label>
                <input type="text" class="form-control" id="modalPincode" placeholder="Pincode">
            </div>
            <div class="form-group">
                <label class="form-label">Set as Default</label>
                <input type="checkbox" id="modalIsDefault" style="width: 20px; height: 20px; margin-top: 10px;">
            </div>
        </div>
        <div class="location-modal-footer">
            <button class="btn-modal-cancel" onclick="closeLocationModal()">Cancel</button>
            <button class="btn-modal-save" onclick="saveLocation()">Save Location</button>
        </div>
    </div>
</div>

<div class="profile-container">
    <!-- Left Card -->
    <div class="profile-card">
        <div class="profile-avatar" id="profileAvatar" onclick="document.getElementById('photoInput').click()">
            <div id="avatarPreview">V</div>
            <div class="upload-overlay">📸 Change Photo</div>
        </div>
        <input type="file" id="photoInput" accept="image/jpeg,image/png" style="display:none"
               onchange="uploadPhoto(this)">
        <div class="profile-name" id="profileName">Loading...</div>
        <div class="profile-role">Vendor Account</div>
        <span class="status-badge" id="profileStatus"></span>

        <div class="profile-stats">
            <div class="profile-stat">
                <span class="profile-stat-label">Member Since</span>
                <span class="profile-stat-value" id="memberSince">-</span>
            </div>
            <div class="profile-stat">
                <span class="profile-stat-label">Total Orders</span>
                <span class="profile-stat-value" id="totalOrders">-</span>
            </div>
            <div class="profile-stat">
                <span class="profile-stat-label">Total Spent</span>
                <span class="profile-stat-value" id="totalSpent">-</span>
            </div>
        </div>
    </div>

    <!-- Right Form -->
    <div class="form-card">
        <div class="form-title">📋 Business Information</div>

        <div class="form-row">
            <div class="form-group">
                <label class="form-label">Business Name <span class="required">*</span></label>
                <input type="text" class="form-control" id="businessName" placeholder="Business Name">
            </div>
            <div class="form-group">
                <label class="form-label">GSTIN</label>
                <input type="text" class="form-control readonly" id="gstin" placeholder="GSTIN" readonly>
                <div class="warning-text">⚠️ GST changes require admin approval</div>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label class="form-label">Contact Person <span class="required">*</span></label>
                <input type="text" class="form-control" id="contactPerson" placeholder="Contact Person">
            </div>
            <div class="form-group">
                <label class="form-label">Phone <span class="required">*</span></label>
                <input type="tel" class="form-control" id="phone" placeholder="Phone Number">
            </div>
        </div>

        <div class="form-group">
            <label class="form-label">Email</label>
            <input type="email" class="form-control readonly" id="email" placeholder="Email" readonly>
            <div class="warning-text">⚠️ Email changes require admin approval</div>
        </div>

        <!-- DELIVERY LOCATIONS SECTION -->
        <div class="delivery-locations">
            <div class="form-title" style="font-size: 16px;">🚚 Delivery Locations</div>
            <div id="deliveryLocationsList"></div>
            <button class="btn-add-location" onclick="openAddLocationModal()">+ Add New Location</button>
        </div>

        <button class="btn-save mt-4" onclick="saveProfile()">💾 Save Changes</button>

        <div class="password-section">
            <div class="form-title" style="font-size: 16px;">🔐 Change Password</div>
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Current Password</label>
                    <input type="password" class="form-control" id="currentPw" placeholder="Current Password">
                </div>
                <div class="form-group">
                    <label class="form-label">New Password</label>
                    <input type="password" class="form-control" id="newPw" placeholder="New Password"
                           onkeyup="checkPasswordStrength()">
                    <div class="password-strength" id="passwordStrength"></div>
                </div>
                <div class="form-group">
                    <label class="form-label">Confirm Password</label>
                    <input type="password" class="form-control" id="confirmPw" placeholder="Confirm Password">
                </div>
            </div>
            <button class="btn-save btn-outline" onclick="changePassword()">Update Password</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function getCookie(name) {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${name}=`);
            if (parts.length === 2) return parts.pop().split(';').shift();
            return null;
        }

        async function authorizedFetch(url, options = {}) {
            const token = getCookie("authToken");

            options.headers = {
                ...options.headers,
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
            };

            const response = await fetch(url, options);

            if (response.status === 401) {
                console.warn("Unauthorized → Redirecting to login");
                window.location.href = "/Vendor/Login";
                return null;
            }

            return response;
        }

        const API_URL = 'http://localhost:5020/api/Vendor';
        let vendorId = null;
        let deliveryLocations = [];
        let editingLocationId = null;

        async function loadProfile() {
            try {
                const response = await authorizedFetch(`${API_URL}/profile`);
                if (!response) return;

                const result = await response.json();

                if (result.success && result.data) {
                    const profile = result.data;
                    const stats = result.stats;

                    document.getElementById('profileName').innerText = profile.businessName || profile.contactPerson || 'Vendor';
                    updateAvatar(profile.profileImageUrl, profile.businessName || profile.contactPerson || 'V');

                    document.getElementById('memberSince').innerText =
                        profile.memberSince ? new Date(profile.memberSince).toLocaleDateString() : 'N/A';

                    document.getElementById('totalOrders').innerText = stats?.totalOrders || 0;
                    document.getElementById('totalSpent').innerText =
                        '₹' + (stats?.totalSpent || 0).toLocaleString('en-IN');

                    const status = profile.onboardingStatus || 'pending_approval';
                    const statusEl = document.getElementById('profileStatus');
                    
                    if (status === 'approved') {
                        statusEl.innerText = '✓ Active';
                        statusEl.className = 'status-badge status-active';
                    } else if (status === 'pending_approval') {
                        statusEl.innerText = '⏳ Pending Approval';
                        statusEl.className = 'status-badge status-pending';
                    } else {
                        statusEl.innerText = '⚠️ Suspended';
                        statusEl.className = 'status-badge status-suspended';
                    }

                    document.getElementById('businessName').value = profile.businessName || '';
                    document.getElementById('gstin').value = profile.gstin || '';
                    document.getElementById('contactPerson').value = profile.contactPerson || '';
                    document.getElementById('phone').value = profile.phone || '';
                    document.getElementById('email').value = profile.email || '';

                    vendorId = profile.vendorId;
                }

                await loadDeliveryLocations();

            } catch (error) {
                console.error('Error loading profile:', error);
                showToast('Error loading profile', 'error');
            }
        }

        async function loadDeliveryLocations() {
            try {
                const response = await authorizedFetch(`${API_URL}/addresses`);
                if (!response) return;

                const result = await response.json();

                if (result.success) {
                    deliveryLocations = result.data || [];
                    renderDeliveryLocations();
                } else {
                    deliveryLocations = [];
                    renderDeliveryLocations();
                }
            } catch (error) {
                console.error('Error loading locations:', error);
                deliveryLocations = [];
                renderDeliveryLocations();
            }
        }

        function renderDeliveryLocations() {
            const container = document.getElementById('deliveryLocationsList');
            if (!deliveryLocations.length) {
                container.innerHTML = '<div class="location-item"><span class="location-address">No delivery locations added</span></div>';
                return;
            }

            container.innerHTML = deliveryLocations.map(loc => `
                <div class="location-item">
                    <div class="location-address">
                        ${escapeHtml(loc.addressLine1 || loc.address || '')}, ${escapeHtml(loc.city || '')}, ${escapeHtml(loc.state || '')} - ${escapeHtml(loc.zipCode || loc.pincode || '')}
                        ${loc.isDefault ? '<span class="location-default">Default</span>' : ''}
                    </div>
                    <div class="location-actions">
                        <button onclick="openEditLocationModal(${loc.id})" title="Edit">✏️ </button>
                        <button onclick="deleteLocation(${loc.id})" title="Delete">🗑️ </button>
                    </div>
                </div>
            `).join('');
        }

        function openAddLocationModal() {
            editingLocationId = null;
            document.getElementById('locationModalTitle').innerText = 'Add Delivery Location';
            document.getElementById('modalAddress').value = '';
            document.getElementById('modalCity').value = '';
            document.getElementById('modalState').value = '';
            document.getElementById('modalPincode').value = '';
            document.getElementById('modalIsDefault').checked = false;
            document.getElementById('locationModal').style.display = 'flex';
        }

        function openEditLocationModal(id) {
            const location = deliveryLocations.find(l => l.id === id);
            if (!location) {
                console.error('Location not found for ID:', id);
                return;
            }

            editingLocationId = id;
            document.getElementById('locationModalTitle').innerText = 'Edit Delivery Location';
            document.getElementById('modalAddress').value = location.addressLine1 || location.address || '';
            document.getElementById('modalCity').value = location.city || '';
            document.getElementById('modalState').value = location.state || '';
            document.getElementById('modalPincode').value = location.zipCode || location.pincode || '';
            document.getElementById('modalIsDefault').checked = location.isDefault || false;
            document.getElementById('locationModal').style.display = 'flex';
        }

        function closeLocationModal() {
            document.getElementById('locationModal').style.display = 'none';
            editingLocationId = null;
        }

        async function saveLocation() {
            const address = document.getElementById('modalAddress').value.trim();
            const city = document.getElementById('modalCity').value.trim();
            const state = document.getElementById('modalState').value.trim();
            const pincode = document.getElementById('modalPincode').value.trim();
            const isDefault = document.getElementById('modalIsDefault').checked;

            if (!address || !city || !state || !pincode) {
                showToast('Please fill all fields', 'warning');
                return;
            }

            const locationData = {
                addressLine1: address,
                addressLine2: '',
                city: city,
                state: state,
                zipCode: pincode,
                isDefault: isDefault
            };

            try {
                let response;
                let url;

                if (editingLocationId) {
                    url = `${API_URL}/addresses/update/${editingLocationId}`;
                    response = await authorizedFetch(url, {
                        method: 'PUT',
                        body: JSON.stringify(locationData)
                    });
                } else {
                    url = `${API_URL}/addresses/save`;
                    response = await authorizedFetch(url, {
                        method: 'POST',
                        body: JSON.stringify(locationData)
                    });
                }

                if (!response) {
                    showToast('No response from server', 'error');
                    return;
                }

                const result = await response.json();

                if (result.success) {
                    showToast(result.message, 'success');
                    closeLocationModal();
                    await loadDeliveryLocations();
                } else {
                    showToast(result.message || 'Error saving location', 'error');
                }
            } catch (error) {
                console.error('Error saving location:', error);
                showToast('Error saving location: ' + error.message, 'error');
            }
        }

        async function deleteLocation(id) {
            if (!confirm('Are you sure you want to delete this location?')) return;
            
            try {
                const response = await authorizedFetch(`${API_URL}/addresses/delete/${id}`, {
                    method: 'DELETE'
                });

                if (!response) return;

                const result = await response.json();
                if (result.success) {
                    showToast(result.message, 'success');
                    await loadDeliveryLocations();
                } else {
                    showToast(result.message || 'Error deleting location', 'error');
                }
            } catch (error) {
                showToast('Error deleting location', 'error');
            }
        }

        function updateAvatar(imageUrl, name) {
            const avatarDiv = document.getElementById('avatarPreview');
            if (imageUrl && (imageUrl.startsWith('data:image') || imageUrl.startsWith('http'))) {
                avatarDiv.innerHTML = `<img src="${imageUrl}" style="width:100%;height:100%;object-fit:cover;border-radius:50%">`;
            } else {
                avatarDiv.innerHTML = (name || 'V')[0].toUpperCase();
            }
        }

        async function uploadPhoto(input) {
            const file = input.files[0];
            if (!file) return;

            if (file.size > 2 * 1024 * 1024) {
                showToast('Photo must be less than 2MB', 'error');
                return;
            }

            if (!file.type.match('image/jpeg') && !file.type.match('image/png')) {
                showToast('Only JPG and PNG files are allowed', 'error');
                return;
            }

            const reader = new FileReader();
            reader.onload = async function (e) {
                const base64 = e.target.result;

                try {
                    const response = await authorizedFetch(`${API_URL}/profile/upload-photo`, {
                        method: 'POST',
                        body: JSON.stringify({ imageBase64: base64 })
                    });
                    const result = await response.json();

                    if (result.success) {
                        showToast(result.message, 'success');
                        updateAvatar(base64, document.getElementById('profileName').innerText);
                    } else {
                        showToast(result.message, 'error');
                    }
                } catch (error) {
                    console.error('Error uploading photo:', error);
                    showToast('Error uploading photo', 'error');
                }
            };
            reader.readAsDataURL(file);
        }

        async function saveProfile() {
            const profileData = {
                vendorId: vendorId,
                businessName: document.getElementById('businessName').value,
                contactPerson: document.getElementById('contactPerson').value,
                phone: document.getElementById('phone').value
            };

            if (!profileData.businessName) {
                showToast('Business Name is required', 'warning');
                return;
            }
            if (!profileData.phone) {
                showToast('Phone number is required', 'warning');
                return;
            }

            try {
                const response = await authorizedFetch(`${API_URL}/profile/update`, {
                    method: 'PUT',
                    body: JSON.stringify(profileData)
                });
                
                if (!response) return;
                
                const result = await response.json();

                if (result.success) {
                    showToast(result.message, 'success');
                    loadProfile(); // Reload to refresh data
                } else {
                    showToast(result.message, 'error');
                }
            } catch (error) {
                console.error('Error saving profile:', error);
                showToast('Error saving profile: ' + error.message, 'error');
            }
        }

        function checkPasswordStrength() {
            const password = document.getElementById('newPw').value;
            const strengthDiv = document.getElementById('passwordStrength');

            if (!password) {
                strengthDiv.innerHTML = '';
                return;
            }

            let strength = 0;
            let message = '';
            let className = '';

            if (password.length >= 8) strength++;
            if (password.match(/[a-z]/)) strength++;
            if (password.match(/[A-Z]/)) strength++;
            if (password.match(/[0-9]/)) strength++;
            if (password.match(/[^a-zA-Z0-9]/)) strength++;

            switch (strength) {
                case 0: case 1: message = 'Weak'; className = 'strength-weak'; break;
                case 2: case 3: message = 'Fair'; className = 'strength-fair'; break;
                case 4: message = 'Good'; className = 'strength-good'; break;
                case 5: message = 'Strong'; className = 'strength-strong'; break;
            }

            strengthDiv.innerHTML = `<span class="${className}">🔐 Password Strength: ${message}</span>`;
            strengthDiv.innerHTML += `<span style="font-size:10px;color:#64748b;display:block;">Min 8 chars with letters, numbers & special character</span>`;
        }

        async function changePassword() {
            const current = document.getElementById('currentPw').value;
            const newPw = document.getElementById('newPw').value;
            const confirm = document.getElementById('confirmPw').value;

            if (!current) {
                showToast('Enter current password', 'warning');
                return;
            }

            const passwordRegex = /^(?=.*[A-Za-z])(?=.*\d)(?=.*[\x40$!%*#?&])[A-Za-z\d\x40$!%*#?&]{8,}$/;
            if (!passwordRegex.test(newPw)) {
                showToast('Password must be 8+ characters with letters, numbers & special character', 'warning');
                return;
            }

            if (newPw !== confirm) {
                showToast('Passwords do not match!', 'error');
                return;
            }

            try {
                const token = getCookie("authToken");
                const response = await fetch(`${API_URL}/profile/change-password`, {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({
                        currentPassword: current,
                        newPassword: newPw
                    })
                });
                const result = await response.json();

                if (result.success) {
                    showToast(result.message, 'success');
                    document.getElementById('currentPw').value = '';
                    document.getElementById('newPw').value = '';
                    document.getElementById('confirmPw').value = '';
                    document.getElementById('passwordStrength').innerHTML = '';
                } else {
                    showToast(result.message, 'error');
                }
            } catch (error) {
                console.error('Error changing password:', error);
                showToast('Error changing password', 'error');
            }
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/[&<>]/g, function (m) {
                if (m === '&') return '&amp;';
                if (m === '<') return '&lt;';
                if (m === '>') return '&gt;';
                return m;
            });
        }

        function showToast(message, type) {
            let container = document.getElementById('fbToastContainer');
            if (!container) {
                container = document.createElement('div');
                container.id = 'fbToastContainer';
                container.className = 'fb-toast-container';
                document.body.appendChild(container);
            }

            const icons = { success: '✅', error: '❌', warning: '⚠️', info: 'ℹ️' };
            const titles = { success: 'Success!', error: 'Error!', warning: 'Warning!', info: 'Info' };

            const toast = document.createElement('div');
            toast.className = `fb-toast ${type}`;
            toast.innerHTML = `
                <div class="fb-toast-icon">${icons[type] || icons.info}</div>
                <div class="fb-toast-content">
                    <div class="fb-toast-title">${titles[type] || titles.info}</div>
                    <div class="fb-toast-message">${escapeHtml(message)}</div>
                </div>
                <button class="fb-toast-close" onclick="this.closest('.fb-toast').remove()">âœ•</button>
            `;

            container.appendChild(toast);
            setTimeout(() => {
                toast.classList.add('fade-out');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // Load profile on page load
        loadProfile();
    </script>
}

