@{
    Layout = "~/Views/Shared/Layouts/_VendorLayout.cshtml";
    ViewData["Title"] = "Business Profile";
}

<link rel="stylesheet" href="~/css/pages/vendor/profile.css" asp-append-version="true" />

<!-- Location Modal -->
<div id="locationModal" class="location-modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3 class="section-title" id="locationModalTitle" data-i18n="prof_add_loc_title" style="margin:0">Add Delivery Location</h3>
            <button onclick="closeLocationModal()" style="background:none; border:none; font-size:24px; color:#94a3b8; cursor:pointer">&times;</button>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label class="form-label"><span data-i18n="prof_addr_label">Address Line</span> <span style="color:#ef4444">*</span></label>
                <div class="input-wrapper">
                    <i class="fi fi-rr-map-marker input-icon"></i>
                    <input type="text" class="form-control" id="modalAddress" data-i18n-placeholder="prof_addr_ph" placeholder="Street, Area, Building">
                </div>
            </div>
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label"><span data-i18n="prof_city_label">City</span> <span style="color:#ef4444">*</span></label>
                    <div class="input-wrapper">
                        <i class="fi fi-rr-city input-icon"></i>
                        <input type="text" class="form-control" id="modalCity" data-i18n-placeholder="prof_city_ph" placeholder="City">
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label"><span data-i18n="prof_state_label">State</span> <span style="color:#ef4444">*</span></label>
                    <div class="input-wrapper">
                        <i class="fi fi-rr-map input-icon"></i>
                        <input type="text" class="form-control" id="modalState" data-i18n-placeholder="prof_state_ph" placeholder="State">
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label"><span data-i18n="prof_pin_label">Pincode</span> <span style="color:#ef4444">*</span></label>
                    <div class="input-wrapper">
                        <i class="fi fi-rr-mailbox input-icon"></i>
                        <input type="text" class="form-control" id="modalPincode" data-i18n-placeholder="prof_pin_ph" placeholder="Pincode">
                    </div>
                </div>
                <div class="form-group" style="display: flex; align-items: center; gap: 10px; padding-top: 30px;">
                    <input type="checkbox" id="modalIsDefault" style="width: 20px; height: 20px; cursor: pointer;">
                    <label for="modalIsDefault" class="form-label" style="margin:0; cursor: pointer;" data-i18n="prof_set_default">Set as Default Address</label>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn-premium btn-outline" style="padding: 10px 20px;" onclick="closeLocationModal()" data-i18n="prof_cancel">Cancel</button>
            <button class="btn-premium btn-emerald" style="padding: 10px 20px;" onclick="saveLocation()" data-i18n="prof_save_loc">Save Location</button>
        </div>
    </div>
</div>

<div class="profile-container">
    <!-- Left Sidebar: Profile Summary -->
    <aside class="glass-card profile-card">
        <div class="avatar-wrapper">
            <div class="profile-avatar" id="profileAvatar" onclick="document.getElementById('photoInput').click()">
                <div id="avatarPreview" class="skeleton" style="width:100%; height:100%; border-radius: 50%;"></div>
            </div>
            <div class="upload-overlay" onclick="document.getElementById('photoInput').click()">
                <i class="fi fi-rr-camera"></i>
            </div>
        </div>
        <input type="file" id="photoInput" accept="image/jpeg,image/png" style="display:none" onchange="uploadPhoto(this)">
        
        <h2 class="profile-name" id="profileName"><div class="skeleton" style="height:28px; width:150px; margin:0 auto"></div></h2>
        <p class="profile-role" data-i18n="prof_role">Registered Vendor</p>

        <div class="profile-stats">
            <div class="profile-stat">
                <span class="stat-label" data-i18n="prof_member_since">Member Since</span>
                <span class="stat-value" id="memberSince">-</span>
            </div>
            <div class="profile-stat">
                <span class="stat-label" data-i18n="prof_total_orders">Total Orders</span>
                <span class="stat-value" id="totalOrders">-</span>
            </div>
            <div class="profile-stat">
                <span class="stat-label" data-i18n="prof_total_spent">Total Spent</span>
                <span class="stat-value" id="totalSpent">-</span>
            </div>
        </div>
    </aside>

    <!-- Right Content: Forms -->
    <main class="content-area">
        <!-- Business Info -->
        <section class="glass-card section-card">
            <div class="section-header">
                <h2 class="section-title">
                    <i class="fi fi-rr-briefcase"></i> <span data-i18n="prof_biz_info">Business Information</span>
                </h2>
                <div class="header-actions">
                    <button class="btn-premium btn-emerald" onclick="saveProfile()">
                        <i class="fi fi-rr-disk"></i> <span data-i18n="prof_save">Save Profile</span>
                    </button>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label" data-i18n="prof_biz_name">Business Name <span style="color:#ef4444">*</span></label>
                    <div class="input-wrapper">
                        <i class="fi fi-rr-building input-icon"></i>
                        <input type="text" class="form-control" id="businessName" data-i18n-placeholder="prof_biz_name_ph" placeholder="Enter business name">
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label" data-i18n="prof_gstin">GSTIN / Tax ID</label>
                    <div class="input-wrapper">
                        <i class="fi fi-rr-document input-icon"></i>
                        <input type="text" class="form-control" id="gstin" data-i18n-placeholder="prof_gstin_ph" placeholder="Enter GSTIN number">
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label" data-i18n="prof_contact">Contact Person <span style="color:#ef4444">*</span></label>
                    <div class="input-wrapper">
                        <i class="fi fi-rr-user input-icon"></i>
                        <input type="text" class="form-control" id="contactPerson" data-i18n-placeholder="prof_contact_ph" placeholder="Primary contact name">
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label" data-i18n="prof_phone">Phone Number <span style="color:#ef4444">*</span></label>
                    <div class="input-wrapper">
                        <i class="fi fi-rr-phone-call input-icon"></i>
                        <input type="tel" class="form-control" id="phone" data-i18n-placeholder="prof_phone_ph" placeholder="+91 XXXX-XXXXXX">
                    </div>
                </div>
                <div class="form-group full-width">
                    <label class="form-label" data-i18n="prof_email">Official Email Address</label>
                    <div class="input-wrapper">
                        <i class="fi fi-rr-envelope input-icon"></i>
                        <input type="email" class="form-control readonly" id="email" readonly>
                    </div>
                    <div class="warning-hint">
                        <i class="fi fi-rr-info" style="font-size:14px"></i> <span data-i18n="prof_email_hint">Verified email address cannot be changed directly.</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Delivery Locations -->
        <section class="glass-card section-card">
            <div class="section-header">
                <h2 class="section-title">
                    <i class="fi fi-rr-truck-side"></i> <span data-i18n="prof_delivery">Delivery Locations</span>
                </h2>
                <div class="header-actions">
                    <button class="btn-premium btn-outline" onclick="openLocationModal()">
                        <i class="fi fi-rr-add"></i> <span data-i18n="prof_add_new">Add New</span>
                    </button>
                </div>
            </div>

            <div id="deliveryLocationsList" class="locations-list">
                <!-- Skeleton Loading -->
                <div class="location-item skeleton" style="height:180px"></div>
                <div class="location-item skeleton" style="height:180px"></div>
            </div>
        </section>

        <!-- Security -->
        <section class="glass-card section-card">
            <div class="section-header">
                <h2 class="section-title">
                    <i class="fi fi-rr-shield-check"></i> <span data-i18n="prof_security">Security & Password</span>
                </h2>
                <div class="header-actions">
                    <button class="btn-premium btn-emerald" onclick="changePassword()">
                        <i class="fi fi-rr-refresh"></i> <span data-i18n="prof_update_pw">Update Password</span>
                    </button>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label" data-i18n="prof_curr_pw">Current Password</label>
                    <div class="input-wrapper">
                        <i class="fi fi-rr-lock input-icon"></i>
                        <input type="password" class="form-control" id="currentPw" placeholder="••••••••">
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label" data-i18n="prof_new_pw">New Password</label>
                    <div class="input-wrapper">
                        <i class="fi fi-rr-key input-icon"></i>
                        <input type="password" class="form-control" id="newPw" data-i18n-placeholder="prof_pw_len_hint" placeholder="8+ chars with special char" onkeyup="checkPasswordStrength()">
                    </div>
                    <div class="strength-meter">
                        <div id="strengthBar" class="strength-bar"></div>
                    </div>
                    <div id="strengthText" class="strength-text"></div>
                </div>
                <div class="form-group">
                    <label class="form-label" data-i18n="prof_conf_pw">Confirm New Password</label>
                    <div class="input-wrapper">
                        <i class="fi fi-rr-shield-check input-icon"></i>
                        <input type="password" class="form-control" id="confirmPw" placeholder="Confirm password">
                    </div>
                </div>
            </div>
        </section>
    </main>
</div>

@section Scripts {
    <script src="~/js/Vendor/vendor_dashboard.js"></script>
    <script src="~/js/pages/vendor/profile.js" asp-append-version="true"></script>
}