@{
    Layout = "~/Views/Shared/Layouts/_VendorLayout.cshtml";
    ViewData["Title"] = "Payment History";
}

<link rel="stylesheet" href="~/css/pages/vendor/payments.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdn-uicons.flaticon.com/uicons-regular-rounded/css/uicons-regular-rounded.css">

<div class="payments-page-wrapper">
    <!-- Header Section -->
    <header class="payments-main-header">
        <div class="header-left">
            <div class="header-icon-gradient">
                <i class="fi fi-rr-wallet"></i>
            </div>
            <div>
                <h1 class="page-title" data-i18n="pay_title">Payment History</h1>
                <p class="page-subtitle" data-i18n="pay_subtitle">Track your transactions and download settlement receipts</p>
            </div>
        </div>
        <div class="header-right d-none d-md-block">
            <button class="btn-receipt" onclick="loadPayments()">
                <i class="fi fi-rr-refresh"></i> <span data-i18n="pay_refresh">Refresh History</span>
            </button>
        </div>
    </header>

    <!-- Stats Section -->
    <div id="statsContainer" class="payments-stats-grid">
        <div class="payment-stat-card skeleton-active">
            <div class="skeleton-icon"></div>
            <div style="flex:1">
                <div class="skeleton-line" style="width: 40%; height: 10px; margin-bottom: 8px;"></div>
                <div class="skeleton-line" style="width: 70%; height: 20px;"></div>
            </div>
        </div>
        <div class="payment-stat-card skeleton-active">
            <div class="skeleton-icon"></div>
            <div style="flex:1">
                <div class="skeleton-line" style="width: 40%; height: 10px; margin-bottom: 8px;"></div>
                <div class="skeleton-line" style="width: 70%; height: 20px;"></div>
            </div>
        </div>
        <div class="payment-stat-card skeleton-active">
            <div class="skeleton-icon"></div>
            <div style="flex:1">
                <div class="skeleton-line" style="width: 40%; height: 10px; margin-bottom: 8px;"></div>
                <div class="skeleton-line" style="width: 70%; height: 20px;"></div>
            </div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="payments-filter-bar">
        <h2 class="section-title">
            <i class="fi fi-rr-list-check" style="color: var(--emerald-primary)"></i> 
            <span data-i18n="pay_recent_transactions">Recent Transactions</span>
        </h2>
        <div class="filter-group">
            <select id="payStatusFilter" class="payment-select">
                <option value="all" data-i18n="pay_status_all">All Statuses</option>
                <option value="success" data-i18n="pay_status_success">Successful</option>
                <option value="pending" data-i18n="pay_status_pending">Pending</option>
                <option value="failed" data-i18n="pay_status_failed">Failed</option>
            </select>
            <select id="payMethodFilter" class="payment-select">
                <option value="all" data-i18n="pay_method_all">All Methods</option>
                <option value="upi" data-i18n="pay_method_upi">UPI Payments</option>
                <option value="card" data-i18n="pay_method_card">Card / NetBanking</option>
            </select>
        </div>
    </div>

    <!-- Table Section -->
    <div class="payments-table-card">
        <div id="tableContainer">
            <div class="skeleton-table skeleton-active"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/Vendor/vendor_dashboard.js"></script>
    
    <script src="~/js/pages/vendor/payments.js" asp-append-version="true"></script>
}
