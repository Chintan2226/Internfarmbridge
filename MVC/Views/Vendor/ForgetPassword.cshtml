@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = "Recover Account - FarmBridge";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <link rel="icon" type="image/png" href="~/Logo/Logo_Without_Bg.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://kendo.cdn.telerik.com/2022.1.119/styles/kendo.common.min.css" rel="stylesheet" />
    <link href="https://kendo.cdn.telerik.com/2022.1.119/styles/kendo.default.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/pages/vendor/auth.css" />
    
<link rel="stylesheet" href="~/css/pages/vendor/forgetpassword.css" asp-append-version="true" />

</head>
<body>

<div class="container-auth">
    <div class="auth-banner">
        <div class="banner-logo">
            <img src="~/Logo/Logo_Without_Bg.png" alt="FarmBridge Logo" />
        </div>
        <h1 class="banner-title">Vendor Portal</h1>
        <p class="banner-description">Recover your account access to manage your catalog and orders.</p>
    </div>

    <div class="form-container">
        <div class="form-card">

            <div id="requestOtpSection">
                <h2>@Localizer["ForgotPassword"]</h2>
                <p class="form-subtitle">Enter your email to receive a verification code.</p>

                <span id="notificationRequest"></span>
                <form id="requestOtpForm"></form>

                <div class="form-footer">
                    <p>Remember your password? <a href="/vendor/login">Sign In</a></p>
                    <div class="back-home">
                        <a href="/">← Back to Home</a>
                    </div>
                </div>
            </div>

            <div id="resetPasswordSection" style="display: none;">
                <h2>Reset Password</h2>
                <p class="form-subtitle">Enter the OTP sent to your email and your new password.</p>

                <span id="notificationReset"></span>
                <form id="verifyResetForm"></form>

                <a href="javascript:void(0)" class="resend-link" id="resendOtpBtn">Didn't receive a code? Resend</a>

                <div class="form-footer">
                    <div class="back-home">
                        <a href="#" id="backToStep1">← Use a different email</a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script src="https://kendo.cdn.telerik.com/2022.1.119/js/jquery.min.js"></script>
<script src="https://kendo.cdn.telerik.com/2022.1.119/js/kendo.all.min.js"></script>

    <script src="~/js/pages/vendor/forgetpassword.js" asp-append-version="true"></script>
</body>
</html>


