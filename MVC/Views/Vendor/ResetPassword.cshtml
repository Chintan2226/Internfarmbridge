@{
    Layout = "~/Views/Shared/Layouts/_VendorLayout.cshtml";
    ViewData["Title"] = "Reset Password - FarmBridge";
}

<link href="https://kendo.cdn.telerik.com/2022.1.119/styles/kendo.common.min.css" rel="stylesheet" />
<link href="https://kendo.cdn.telerik.com/2022.1.119/styles/kendo.default.min.css" rel="stylesheet" />
<link rel="stylesheet" href="~/css/pages/vendor/auth.css" />


<link rel="stylesheet" href="~/css/pages/vendor/resetpassword.css" asp-append-version="true" />


<div class="container-auth">
    <div class="auth-banner">
        <div class="banner-logo">
            <img src="~/Logo/Logo_Without_Bg.png" alt="FarmBridge Logo" />
        </div>
        <h1 class="banner-title">Vendor Portal</h1>
        <p class="banner-description">Browse catalog, manage orders, and track your transactions.</p>
    </div>

    <div class="form-container">
        <div class="form-card">
            <h2>Reset Password</h2>
            <p class="form-subtitle">Enter OTP and new password</p>
            
            <span id="notificationReset"></span>
            <form id="resetPasswordForm"></form>
            
            <div class="form-footer">
                <div class="back-home">
                    <a href="/vendor/login">â† Back to Login</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://kendo.cdn.telerik.com/2022.1.119/js/jquery.min.js"></script>
    <script src="https://kendo.cdn.telerik.com/2022.1.119/js/kendo.all.min.js"></script>

    <script>window.FB_RESET_EMAIL = '@ViewBag.Email' || localStorage.getItem("resetEmail") || '';</script>
    <script src="~/js/pages/vendor/resetpassword.js" asp-append-version="true"></script>
}


