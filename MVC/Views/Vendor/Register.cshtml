@{
    Layout = null; 
    ViewData["Title"] = "Vendor Registration - FarmBridge";
}

<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <link rel="icon" type="image/png" href="~/Logo/Logo_Without_Bg.png" />
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"]</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    
    <script src="~/js/pages/vendor/register.js" asp-append-version="true"></script>
    
<link rel="stylesheet" href="~/css/pages/vendor/register.css" asp-append-version="true" />

</head>
<body class="bg-[#faf9f5] text-[#1a1c1a] min-h-screen relative m-0 p-0 overflow-x-hidden">

    <div id="notificationArea" class="fixed top-4 right-4 z-[9999] w-full max-w-sm flex flex-col gap-2 pointer-events-none"></div>

    <a href="/" class="fixed top-4 left-4 sm:top-6 sm:left-6 z-[100] flex items-center gap-2 text-white/90 hover:text-white bg-white/15 hover:bg-white/25 px-4 py-2 rounded-full backdrop-blur-md border border-white/30 shadow-lg transition-all duration-300 hover:scale-105 group text-decoration-none">
        <span class="material-symbols-outlined text-[18px] group-hover:-translate-x-1 transition-transform">arrow_back</span>
        <span class="text-sm font-bold tracking-wide">Home</span>
    </a>

    <div class="fixed top-4 right-4 sm:top-6 sm:right-6 z-[100]">
        <button onclick="document.getElementById('langMenu').classList.toggle('hidden')" class="flex items-center gap-2 text-primary hover:text-white bg-white/70 hover:bg-primary/90 px-4 py-2 sm:py-2.5 rounded-full backdrop-blur-md border border-primary/20 shadow-lg transition-all duration-300 hover:scale-105">
            <span class="material-symbols-outlined text-[18px]">language</span>
            <span class="text-sm font-bold tracking-wide">Language</span>
        </button>
        <div id="langMenu" class="absolute right-0 mt-2 w-36 bg-white rounded-xl shadow-xl border border-black/5 flex flex-col hidden overflow-hidden transition-all duration-300">
            <button class="text-left px-4 py-2 hover:bg-gray-100 text-sm font-semibold transition-colors text-on-surface" onclick="changeLanguage('en')">🇺🇸 English</button>
            <button class="text-left px-4 py-2 hover:bg-gray-100 text-sm font-semibold transition-colors text-on-surface" onclick="changeLanguage('hi')">🇮🇳 हिन्दी</button>
            <button class="text-left px-4 py-2 hover:bg-gray-100 text-sm font-semibold transition-colors text-on-surface" onclick="changeLanguage('gu')">🇮🇳 ગુજરાતી</button>
        </div>
    </div>

    <div class="fixed inset-0 z-0">
        <img alt="Agricultural Landscape" class="w-full h-full object-cover" 
             src="https://lh3.googleusercontent.com/aida-public/AB6AXuAGuojvyu-oeyMgGglh4NWSycQm2aRpks8yk2xMCp3uxu6cL9MXK1d5ge58JsPPS9VocAgDbHKBTSd032lujmkLoyxtW6CvOXMH7nlWznORbCo2NVbMzW9ujJgUyXflGJOCqr9cU6KIsHQGsO7QidVQHxLyydbbY-roHNcbHnFzhTJMMBNpuAbTQQLj3GhPZqVhux8bY1LG4FKaIR0X3nekDpNqPlqgwnjLmjFN8eHBaSiveKQmAbof87W0kjqPMEQEwZYXc0A_9U8" />
        <div class="absolute inset-0 bg-gradient-to-tr from-primary/30 to-black/20 backdrop-blur-[2px]"></div>
    </div>

    <main class="relative z-10 flex items-center justify-center min-h-screen w-full px-4 py-2 sm:px-6">
        
        <div class="glass-card w-full max-w-[600px] p-5 sm:p-6 rounded-[2rem] shadow-2xl">
            
            <div class="mb-3 text-center flex flex-col items-center">
                <div class="inline-flex items-center justify-center w-10 h-10 mb-1 rounded-full bg-primary shadow-lg">
                    <span class="material-symbols-outlined text-white text-xl" style="font-variation-settings: 'FILL' 1;">agriculture</span>
                </div>
                <h1 class="text-xl sm:text-2xl font-extrabold tracking-tight text-primary mb-1">Vendor Portal</h1>
                <p class="text-on-surface-variant font-medium text-xs sm:text-sm">Join our network of sustainable agricultural partners</p>
            </div>

            <form id="vendorRegisterForm" class="grid grid-cols-1 sm:grid-cols-2 gap-2 sm:gap-3" onsubmit="event.preventDefault(); handleVendorRegister(); return false;" novalidate>
                
                <div class="col-span-1 sm:col-span-2 space-y-1">
                    <label class="block text-[10px] font-bold tracking-widest text-primary/80 uppercase ml-2">Business Name <span class="text-red-600">*</span></label>
                    <input id="businessName" type="text" required
                           class="w-full bg-white/60 border border-black/5 rounded-xl px-4 py-2.5 focus:bg-white focus:ring-2 focus:ring-primary/30 focus:border-primary placeholder:text-black/30 text-sm shadow-inner transition-all" 
                           placeholder="Organic Farms Ltd." />
                </div>

                <div class="col-span-1 space-y-1">
                    <label class="block text-[10px] font-bold tracking-widest text-primary/80 uppercase ml-2">Contact Person <span class="text-red-600">*</span></label>
                    <input id="contactPerson" type="text" required
                           class="w-full bg-white/60 border border-black/5 rounded-xl px-4 py-2.5 focus:bg-white focus:ring-2 focus:ring-primary/30 focus:border-primary placeholder:text-black/30 text-sm shadow-inner transition-all" 
                           placeholder="John Doe" />
                </div>

                <div class="col-span-1 space-y-1">
                    <label class="block text-[10px] font-bold tracking-widest text-primary/80 uppercase ml-2">Mobile Number <span class="text-red-600">*</span></label>
                    <input id="phone" type="tel" required
                           class="w-full bg-white/60 border border-black/5 rounded-xl px-4 py-2.5 focus:bg-white focus:ring-2 focus:ring-primary/30 focus:border-primary placeholder:text-black/30 text-sm shadow-inner transition-all" 
                           placeholder="+91 9876543210" />
                </div>

                <div class="col-span-1 sm:col-span-2 space-y-1">
                    <label class="block text-[10px] font-bold tracking-widest text-primary/80 uppercase ml-2">Email Address <span class="text-red-600">*</span></label>
                    <input id="email" type="email" required
                           class="w-full bg-white/60 border border-black/5 rounded-xl px-4 py-2.5 focus:bg-white focus:ring-2 focus:ring-primary/30 focus:border-primary placeholder:text-black/30 text-sm shadow-inner transition-all" 
                           placeholder="contact@business.com" />
                </div>

                <div class="col-span-1 sm:col-span-2 space-y-1">
                    <label class="block text-[10px] font-bold tracking-widest text-primary/80 uppercase ml-2">GST Number (Optional)</label>
                    <input id="gstin" type="text" 
                           class="w-full bg-white/60 border border-black/5 rounded-xl px-4 py-2.5 focus:bg-white focus:ring-2 focus:ring-primary/30 focus:border-primary placeholder:text-black/30 text-sm shadow-inner transition-all uppercase" 
                           placeholder="22AAAAA0000A1Z5" />
                </div>

                <div class="col-span-1 space-y-1">
                    <label class="block text-[10px] font-bold tracking-widest text-primary/80 uppercase ml-2">Password <span class="text-red-600">*</span></label>
                    <div class="relative">
                        <input id="password" type="password" required
                               class="w-full bg-white/60 border border-black/5 rounded-xl pl-4 pr-10 py-2.5 focus:bg-white focus:ring-2 focus:ring-primary/30 focus:border-primary placeholder:text-black/30 text-sm shadow-inner transition-all" 
                               placeholder="••••••••" />
                        <button type="button" onclick="togglePassword('password', 'eye1')" class="absolute right-3 top-1/2 -translate-y-1/2 text-black/40 hover:text-primary transition-colors">
                            <span id="eye1" class="material-symbols-outlined text-[18px]">visibility</span>
                        </button>
                    </div>
                </div>

                <div class="col-span-1 space-y-1">
                    <label class="block text-[10px] font-bold tracking-widest text-primary/80 uppercase ml-2">Confirm <span class="text-red-600">*</span></label>
                    <div class="relative">
                        <input id="confirmPassword" type="password" required
                               class="w-full bg-white/60 border border-black/5 rounded-xl pl-4 pr-10 py-2.5 focus:bg-white focus:ring-2 focus:ring-primary/30 focus:border-primary placeholder:text-black/30 text-sm shadow-inner transition-all" 
                               placeholder="••••••••" />
                        <button type="button" onclick="togglePassword('confirmPassword', 'eye2')" class="absolute right-3 top-1/2 -translate-y-1/2 text-black/40 hover:text-primary transition-colors">
                            <span id="eye2" class="material-symbols-outlined text-[18px]">visibility</span>
                        </button>
                    </div>
                </div>

                <div class="col-span-1 sm:col-span-2 mt-1">
                    <button id="registerBtn" type="submit" class="w-full py-2.5 rounded-full bg-gradient-to-br from-primary to-primary-container text-white font-bold text-base shadow-[0_10px_20px_-5px_rgba(0,69,13,0.4)] hover:shadow-xl hover:scale-[1.02] active:scale-[0.98] transition-all duration-300">
                        Register Account
                    </button>
                </div>
            </form>

            <p class="mt-3 text-center text-sm text-on-surface-variant font-medium">
                Already registered? <a href="/vendor/login" class="text-primary font-bold hover:text-primary-container hover:underline underline-offset-4 ml-1 transition-all">Sign In</a>
            </p>
        </div>
    </main>

    <script src="~/js/layouts/platform_i18n.js" asp-append-version="true"></script>
    <script src="~/js/layouts/site.js" asp-append-version="true"></script>
</body>
</html>

