@{
    Layout = "~/Views/Shared/Layouts/_VendorLayout.cshtml";
    ViewData["Title"] = "Wishlist";
}

<link rel="stylesheet" href="~/css/pages/vendor/wishlist.css" asp-append-version="true" />

<div class="wishlist-header-area">
    <h1 class="wishlist-title">
        <i class="fi fi-rr-heart"></i>
        <span data-i18n="wish_title">My Wishlist</span>
    </h1>
    <button class="btn-clear-all" id="btnClearAll" onclick="clearAllWishlist()" style="display: none;">
        <i class="fi fi-rr-trash"></i> <span data-i18n="wish_clear">Clear All</span>
    </button>
</div>

<div id="wishlistGrid">
</div>

<div id="wishlistQuantityModal" style="display: none; padding: 0;">
    <div class="premium-modal-card">
        <div id="wishlistModalIcon" style="margin-bottom: 24px;"></div>
        <h3 id="wishlistModalProductName" style="font-family: var(--font-display); color: var(--green-900); margin-bottom: 8px; font-weight: 800; font-size: 22px;">Product Name</h3>
        <div id="wishlistModalStock" style="font-family: var(--font-body); color: #64748b; font-size: 14px; font-weight: 600; background: #f1f5f9; display: inline-block; padding: 4px 12px; border-radius: 20px;">
            <span data-i18n="wish_qty_avail">Available</span>: 0 kg
        </div>
        
        <div class="quantity-stepper">
            <button id="wishlistQtyMinus" class="step-btn"><i class="fi fi-rr-minus-small"></i></button>
            <input type="number" id="wishlistPopupQuantity" value="20" min="20" step="5" 
                   style="width: 100px; text-align: center; font-size: 24px; font-weight: 800; border: 2px solid #e2e8f0; border-radius: 14px; padding: 10px; color: var(--green-900);">
            <button id="wishlistQtyPlus" class="step-btn"><i class="fi fi-rr-plus-small"></i></button>
        </div>

        <div class="price-display">
            <div style="font-size: 11px; color: #64748b; font-weight: 800; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 1.5px;" data-i18n="wish_qty_total">Estimated Investment</div>
            <span id="wishlistModalTotalPrice">₹0</span>
        </div>

        <div class="popup-actions" style="display: flex; gap: 16px; justify-content: center; margin-top: 10px;">
            <button id="cancelWishlistQtyBtn" class="premium-modal-btn btn-cancel" data-i18n="wish_qty_cancel">Cancel</button>
            <button id="confirmWishlistQtyBtn" class="premium-modal-btn btn-confirm">
                <i class="fi fi-rr-shopping-cart-add"></i>
                <span data-i18n="wish_qty_add">Add to Cart</span>
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = 'http://localhost:5020/api/Vendor';
        let wishlistItems = [];
        let currentWishlistProduct = null;

        function getCookie(name) {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${name}=`);
            if (parts.length === 2) return parts.pop().split(';').shift();
            return null;
        }

        async function authorizedFetch(url, options = {}) {
            const token = getCookie("authToken");
            options.headers = {
                ...options.headers,
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
            };

            const response = await fetch(url, options);
            if (response.status === 401) {
                window.location.href = "/Vendor/Login";
                return null;
            }
            return response;
        }

        async function loadWishlist() {
            try {
                if (typeof window.FBSkeleton === 'object') {
                    FBSkeleton.show('#wishlistGrid', 4, 'product');
                }
                const response = await authorizedFetch(`${API_URL}/wishlist`);
                if (!response) return;

                const result = await response.json();
                if (result.success && result.data) {
                    wishlistItems = result.data;
                    renderWishlist();
                    document.getElementById('btnClearAll').style.display = wishlistItems.length > 0 ? 'block' : 'none';
                } else {
                    renderEmptyState('Failed to load wishlist items');
                }
            } catch (error) {
                console.error('Wishlist load error:', error);
                renderEmptyState('Error loading wishlist');
            }
        }

        function renderWishlist() {
            const container = document.getElementById('wishlistGrid');
            if (!wishlistItems.length) {
                renderEmptyState();
                return;
            }

            const groupedByCategory = {};
            wishlistItems.forEach(item => {
                const category = item.category || 'Other';
                if (!groupedByCategory[category]) groupedByCategory[category] = [];
                groupedByCategory[category].push(item);
            });

            let html = '';
            Object.keys(groupedByCategory).sort().forEach(category => {
                html += `
                <div class="wishlist-category-section">
                    <div class="wishlist-category-title">
                        <div class="wishlist-category-icon"><i class="fi fi-rr-apps"></i></div>
                        <span>${fbT('cat_cat_' + category.toLowerCase()) || escapeHtml(category)}</span>
                    </div>
                    <div class="wishlist-grid">`;

                groupedByCategory[category].forEach(item => {
                    const img = item.imageUrl || null;
                    const grade = item.grade || '';
                    const cleanName = item.productName;
                    const media = img ? `<img src="${img}" alt="${escapeHtml(cleanName)}">` : `
                        <div class="no-image-placeholder">
                            <div class="placeholder-icon-wrapper">
                                <i class="fi fi-rr-leaf"></i>
                                <div class="placeholder-text">FarmBridge</div>
                            </div>
                        </div>`;

                    html += `
                    <div class="wishlist-card">
                        <button class="wishlist-card-remove" onclick="removeFromWishlist(${item.productId}, '${grade}')" title="${fbT('wish_remove')}">
                            <i class="fi fi-rr-cross-small"></i>
                        </button>
                        <div class="wishlist-card-img">
                            ${media}
                            ${grade ? `<div class="wishlist-grade-badge">${fbT('wish_grade')} ${grade}</div>` : ''}
                        </div>
                        <div class="wishlist-card-body">
                            <div class="wishlist-card-name">${escapeHtml(cleanName)}</div>
                            <div class="wishlist-card-category">
                                <i class="fi fi-rr-tag"></i> ${escapeHtml(item.category || fbT('cat_cat_other'))}
                            </div>
                            <div class="wishlist-card-price">
                                ₹${(item.avgPrice || 0).toLocaleString('en-IN')}<small>/${item.unit || 'kg'}</small>
                            </div>
                            <div class="wishlist-card-stock">
                                <i class="fi fi-rr-box"></i> ${(item.quantityAvailable || 0).toLocaleString()} ${item.unit || 'kg'} ${fbT('wish_in_stock')}
                            </div>
                            <button class="btn-wishlist-add-cart" onclick="openWishlistQuantityModal(${item.productId}, '${escapeHtml(cleanName)}', ${item.avgPrice || 0}, ${item.quantityAvailable || 0}, '${grade}', '${img || ''}')">
                                <i class="fi fi-rr-shopping-cart-add"></i> ${fbT('wish_add_cart')}
                            </button>
                        </div>
                    </div>`;
                });
                html += `</div></div>`;
            });

            container.innerHTML = html;
            if (typeof syncGlobalBadges === 'function') syncGlobalBadges();
        }

        function renderEmptyState(message = "") {
            const emptyMsg = message || fbT('wish_empty');
            document.getElementById('btnClearAll').style.display = 'none';
            const container = document.getElementById('wishlistGrid');
            container.innerHTML = `
            <div class="wishlist-empty">
                <i class="fi fi-rr-heart"></i>
                <h4>${fbT('wish_empty')}</h4>
                <p>${emptyMsg}</p>
                <a href="/Vendor/Catalog" class="btn-browse-catalog">
                    <i class="fi fi-rr-shop"></i> ${fbT('wish_browse')}
                </a>
            </div>`;
            if (typeof syncGlobalBadges === 'function') syncGlobalBadges();
        }

        async function removeFromWishlist(productId, grade) {
            try {
                const gradeParam = grade ? `?grade=${encodeURIComponent(grade)}` : '';
                const response = await authorizedFetch(`${API_URL}/wishlist/remove/${productId}${gradeParam}`, { method: 'DELETE' });
                if (response?.ok) {
                    wishlistItems = wishlistItems.filter(item => !(item.productId === productId && (item.grade || '') === (grade || '')));
                    renderWishlist();
                    showToast(fbT('wish_removed'), 'success');
                }
            } catch (error) { showToast(fbT('wish_remove_fail'), 'error'); }
        }

        async function clearAllWishlist() {
            const confirmed = await Swal.fire({
                title: fbT('wish_confirm_clear'),
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#10b981',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes'
            }).then(r => r.isConfirmed);
            if (!confirmed) return;
            showToast(fbT('wish_clearing'), 'info');
            try {
                for (const item of wishlistItems) {
                    const gradeParam = item.grade ? `?grade=${encodeURIComponent(item.grade)}` : '';
                    await authorizedFetch(`${API_URL}/wishlist/remove/${item.productId}${gradeParam}`, { method: 'DELETE' });
                }
                wishlistItems = [];
                renderWishlist();
                showToast('Wishlist cleared', 'success');
            } catch (error) { showToast('Error clearing wishlist', 'error'); }
        }

        function openWishlistQuantityModal(productId, productName, price, maxQuantity, grade, img) {
            currentWishlistProduct = { id: productId, name: productName, price: price, max: maxQuantity, grade: grade };
            document.getElementById('wishlistModalProductName').innerText = grade ? `${productName} (Grade ${grade})` : productName;
            document.getElementById('wishlistModalStock').innerText = `Available: ${maxQuantity} kg`;

            const iconDiv = document.getElementById('wishlistModalIcon');
            iconDiv.innerHTML = img && img !== 'null'
                ? `<img src="${img}" style="width: 80px; height: 80px; border-radius: 16px; object-fit: cover; box-shadow: 0 8px 16px rgba(0,0,0,0.1);">`
                : `<div style="font-size: 40px;">🌾</div>`;

            document.getElementById('wishlistPopupQuantity').value = 20;
            updateWishlistModalPrice();
            
            if (!$("#wishlistQuantityModal").data("kendoWindow")) {
                $("#wishlistQuantityModal").kendoWindow({ title: "Select Quantity", modal: true, visible: false, width: 420 });
            }
            $("#wishlistQuantityModal").data("kendoWindow").center().open();
        }

        function updateWishlistModalPrice() {
            const qty = parseFloat(document.getElementById('wishlistPopupQuantity').value) || 0;
            const total = Math.round(qty * (currentWishlistProduct?.price || 0));
            document.getElementById('wishlistModalTotalPrice').innerText = `₹${total.toLocaleString('en-IN')}`;
        }

        async function confirmAddToCart() {
            const qty = parseInt($('#wishlistPopupQuantity').val());
            try {
                const response = await authorizedFetch(`${API_URL}/cart/add`, {
                    method: 'POST',
                    body: JSON.stringify({ cropId: currentWishlistProduct.id, quantity: qty })
                });
                if (response?.ok) {
                    showToast('Added to cart successfully!', 'success');
                    $("#wishlistQuantityModal").data("kendoWindow").close();
                    if (typeof syncGlobalBadges === 'function') syncGlobalBadges();
                }
            } catch (e) { showToast('Error adding to cart', 'error'); }
        }

        function escapeHtml(text) {
            return text ? text.replace(/[&<>]/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[m])) : '';
        }

        function showToast(message, type) {
            const toast = document.createElement('div');
            toast.className = `toast-message toast-${type}`;
            const icon = type === 'success' ? 'fi-rr-check' : type === 'error' ? 'fi-rr-exclamation' : 'fi-rr-info';
            toast.innerHTML = `<i class="fi ${icon}"></i> ${message}`;
            document.body.appendChild(toast);
            setTimeout(() => { toast.style.opacity = '0'; setTimeout(() => toast.remove(), 400); }, 3000);
        }

        $(document).ready(() => {
            loadWishlist();
            
            $(document).on('click', '#wishlistQtyPlus', () => {
                const input = $('#wishlistPopupQuantity');
                input.val(Math.min(currentWishlistProduct.max, parseInt(input.val()) + 5));
                updateWishlistModalPrice();
            });
            
            $(document).on('click', '#wishlistQtyMinus', () => {
                const input = $('#wishlistPopupQuantity');
                input.val(Math.max(20, parseInt(input.val()) - 5));
                updateWishlistModalPrice();
            });
            
            $(document).on('input', '#wishlistPopupQuantity', updateWishlistModalPrice);
            $(document).on('click', '#cancelWishlistQtyBtn', () => $("#wishlistQuantityModal").data("kendoWindow").close());
            $(document).on('click', '#confirmWishlistQtyBtn', confirmAddToCart);
        });
    </script>
}
