@{
    Layout = "~/Views/Shared/Layouts/_VendorLayout.cshtml";
    ViewData["Title"] = "Wishlist";
}

<link rel="stylesheet" href="~/css/pages/vendor/catalog.css" asp-append-version="true" />

<!-- Page Header (same as catalog) -->
<div class="catalog-page-header">
    <div>
        <h1 class="catalog-page-title">
            <i class="fi fi-sr-heart" style="color:#ef4444;"></i>
            <span data-i18n="wish_title">My Wishlist</span>
        </h1>
        <p class="catalog-page-subtitle" data-i18n="wish_subtitle">Your saved crops — ready to add to cart</p>
    </div>
    <div class="header-buttons">
        <button class="btn-clear-all" id="btnClearAll" onclick="clearAllWishlist()" style="display:none;background:white;border:1px solid rgba(0,0,0,.08);color:#dc2626;padding:10px 20px;border-radius:50px;font-weight:700;font-size:13px;cursor:pointer;display:none;align-items:center;gap:8px;box-shadow:0 4px 12px rgba(0,0,0,.05);">
            <i class="fi fi-rr-trash"></i> <span data-i18n="wish_clear">Clear All</span>
        </button>
        <button class="cart-redirect-btn" onclick="location.href='/Vendor/Catalog'">
            <i class="fi fi-rr-seedling"></i>
            <span data-i18n="wish_browse">Browse Catalog</span>
        </button>
        <button class="cart-redirect-btn" onclick="location.href='/Vendor/Checkout'" style="background:#10b981;">
            <i class="fi fi-rr-shopping-cart"></i>
            <span>Cart</span>
            <span class="cart-badge" id="headerCartCount">0</span>
        </button>
    </div>
</div>

<!-- Grid -->
<div id="wishlistGrid"></div>

<!-- Quantity Modal (same premium modal as catalog) -->
<div id="wishlistQuantityModal" style="display:none; padding:0;">
    <div class="premium-modal-card">
        <div class="modal-product-info">
            <div id="wishlistModalIcon" class="modal-icon-wrap"></div>
            <div class="modal-text-wrap">
                <h3 id="wishlistModalProductName">Product Name</h3>
                <div id="wishlistModalStock" class="stock-badge">
                    <span data-i18n="wish_qty_avail">Available</span>: 0 kg
                </div>
            </div>
        </div>

        <div class="quantity-control-section">
            <label class="qty-label" data-i18n="cat_qty_title">Order Quantity</label>
            <div class="modern-stepper-pill">
                <button id="wishlistQtyMinus" class="pill-step-btn" onclick="wishlistStepQty(-1)"><i class="fi fi-rr-minus-small"></i></button>
                <div class="pill-input-area">
                    <input type="number" id="wishlistPopupQuantity" value="20" min="20" step="5" oninput="clampWishlistInput()">
                    <span class="pill-unit">kg</span>
                </div>
                <button id="wishlistQtyPlus" class="pill-step-btn" onclick="wishlistStepQty(1)"><i class="fi fi-rr-plus-small"></i></button>
            </div>
        </div>

        <div class="price-display-card">
            <div class="price-label" data-i18n="wish_qty_total">Estimated Investment</div>
            <div id="wishlistModalTotalPrice" class="total-price-value">₹0</div>
        </div>

        <div class="modal-footer-actions">
            <button id="cancelWishlistQtyBtn" class="btn-modal-cancel" onclick="closeWishlistModal()">
                <i class="fi fi-rr-cross-small"></i> <span data-i18n="wish_qty_cancel">Cancel</span>
            </button>
            <button id="confirmWishlistQtyBtn" class="btn-modal-confirm" onclick="confirmAddToCart()">
                <i class="fi fi-rr-shopping-cart-add"></i> <span data-i18n="wish_qty_add">Add to Cart</span>
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/vendor/wishlist.js" asp-append-version="true"></script>
}
