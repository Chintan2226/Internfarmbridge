@{
    Layout = "~/Views/Shared/Layouts/_VendorLayout.cshtml";
    ViewData["Title"] = "Dashboard Overview";
}

<link rel="stylesheet" href="~/css/pages/vendor/vendor_dashboard.css" asp-append-version="true" />

<div class="dashboard-page-wrapper reveal">
    <!-- Premium Header -->
    <div class="dashboard-main-header glass-morphism animate-in">
        <div class="header-left">
            <div class="header-icon-gradient">
                <i class="fi fi-rr-chart-histogram"></i>
            </div>
            <div class="header-text">
                <h1 class="page-title" data-i18n="db_title">Business Overview</h1>
                <p class="page-subtitle" data-i18n="db_subtitle">Track your orders, spending, and procurement trends</p>
            </div>
        </div>
        <div class="header-right">
            <div class="live-status-pill">
                <span class="pulse-dot"></span>
                <span data-i18n="db_live">Live Dashboard</span>
            </div>
        </div>
    </div>

    <div id="dashboardContent">
        <!-- Dashboard Content or Skeletons will be injected here -->
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/pages/vendor/dashboard.js" asp-append-version="true"></script>
}



