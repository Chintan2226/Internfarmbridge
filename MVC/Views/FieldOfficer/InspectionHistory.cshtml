@{
    Layout = "~/Views/Shared/Layouts/_FOLayout.cshtml";
    ViewData["Title"] = "Inspection History";
}

<div class="qc-wrapper">
    <div class="card">
        <div class="card-header">
            <h3>Inspection History</h3>
            <div class="badge-group">
                <span class="hdr-badge hdr-complete" id="completedCount">0 Completed</span>
            </div>
        </div>
        <div id="inspectionSkeletonWrap">
            <div class="skeleton chart-skeleton" style="height:320px;"></div>
        </div>
        <div id="inspectionGridWrap" style="display:none;">
            <table class="ih-table">
                <thead>
                    <tr>
                        <th>Farmer</th>
                        <th>Crop</th>
                        <th>Qty</th>
                        <th>Asking Price</th>
                        <th>Status</th>
                        <th>Date &amp; Time</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="inspectionGrid"></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    
<link rel="stylesheet" href="~/css/pages/fieldofficer/inspectionhistory.css" asp-append-version="true" />

    <script>
        $(document).ready(function () {
            function normalizeStatus(status) {
                return (status || "").toLowerCase();
            }

            window.downloadReport = function (id) {
                if (!id) {
                    foError('Invalid ID', 'Invalid inspection ID');
                    return;
                }
                foOpenAuthorizedWindow("/inspection-report/" + id);
            };

            window.viewInspectionDetail = function (procurementRequestId) {
                if (!procurementRequestId) {
                    return;
                }
                window.location.href = "/FieldOfficer/InspectionDetail?id=" + procurementRequestId;
            };

            function statusPill(status) {
                const s = normalizeStatus(status);
                return "<span class='status-pill pill-completed'>Completed</span>";
            }

            function fmtDateTime(item) {
                if (!item.slotDate) return "â€”";
                try {
                    var date = new Date(item.slotDate);
                    var timeStr = item.startTime ? (" &#64; " + item.startTime.substring(0, 5)) : "";
                    return date.toLocaleDateString("en-IN", {
                        year: "numeric",
                        month: "short",
                        day: "2-digit"
                    }) + timeStr;
                } catch (e) {
                    return "N/A";
                }
            }

            function renderRows(rows) {
                if (!rows || rows.length === 0) {
                    $("#inspectionGrid").html('<tr><td colspan="7" class="ih-empty">No completed inspections found</td></tr>');
                    return;
                }

                const html = rows.map(function (item) {
                    return `
                        <tr>
                            <td data-label="Farmer">${item.farmerName || "N/A"}</td>
                            <td data-label="Crop">${item.cropType || "N/A"}</td>
                            <td data-label="Qty">${item.quantity || 0} ${item.unit || "kg"}</td>
                            <td data-label="Asking Price">â‚¹${Number(item.askingPrice || 0).toLocaleString('en-IN')}</td>
                            <td data-label="Status">${statusPill(item.status)}</td>
                            <td data-label="Date & Time">${fmtDateTime(item)}</td>
                            <td data-label="Action">
                                <div class="ih-action-wrap">
                                    <button class="ih-report-btn" onclick="viewInspectionDetail(${item.procurementRequestId})">
                                        <i class="fa fa-eye"></i> View Details
                                    </button>
                                    <button class="ih-report-btn" onclick="downloadReport(${item.procurementRequestId})">
                                        <i class="fa fa-download"></i> Report
                                    </button>
                                </div>
                            </td>
                        </tr>
                    `;
                }).join("");

                $("#inspectionGrid").html(html);
            }

            // Load completed inspections only
            $.ajax({
                url: foApiUrl("/qc-requests"),
                type: "GET",
                success: function (data) {
                    const rows = Array.isArray(data)
                        ? data
                        : (data && Array.isArray(data.data) ? data.data : []);
                    const completed = rows.filter(x => normalizeStatus(x.status) === "completed");
                    $("#completedCount").text(completed.length + " Completed");
                    $("#inspectionSkeletonWrap").hide();
                    $("#inspectionGridWrap").show();
                    renderRows(completed);
                },
                error: function (xhr) {
                    $("#inspectionSkeletonWrap").hide();
                    $("#inspectionGridWrap").show();
                    if (handleFoUnauthorized(xhr)) return;
                    $("#inspectionGrid").html('<tr><td colspan="7" class="ih-empty">Failed to load inspection history</td></tr>');
                    showFoLoadFailedAlert("inspection history");
                }
            });
        });
    </script>
}


