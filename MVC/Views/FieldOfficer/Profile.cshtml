@{
    ViewData["Title"] = "Profile";
    Layout = "~/Views/Shared/Layouts/_FOLayout.cshtml";
}

<div id="toast"></div>

<div class="profile-page">
    <div class="k-card">

        <div class="profile-header">
            <h3>Field Officer Profile</h3>
        </div>

        <div class="k-card-body">
            <div class="row">

                <!-- LEFT -->
                <div class="col-md-4 text-center">

                    <!-- ✅ LABEL TRICK (NO JS CLICK NEEDED) -->
                    <label for="profileUpload" class="profile-image-wrapper">

                        <img id="profileImg"
                             src="/images/default.png"
                             class="profile-img" />

                        <div class="upload-overlay">
                            <span>Change Photo</span>
                        </div>

                        <input id="profileUpload"
                               type="file"
                               accept="image/*"
                               style="display:none;" />

                    </label>

                    <h4 id="fullName" class="skeleton" style="margin-top:15px;font-weight:600;min-width:120px;min-height:22px;"></h4>

                    <p class="text-muted">Field Officer</p>

                    <p class="text-muted">
                        Member since <span id="memberSince">-</span>
                    </p>

                </div>

                <!-- RIGHT -->
                <div class="col-md-8">

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label>First Name</label>
                            <input id="firstName" class="form-control skeleton" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label>Last Name</label>
                            <input id="lastName" class="form-control skeleton" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label>Email</label>
                        <input id="email" class="form-control skeleton" readonly />
                    </div>

                    <div class="mb-3">
                        <label>Phone</label>
                        <input id="phone" class="form-control skeleton" placeholder="Enter phone number" />
                    </div>

                    <div class="mb-3">
                        <label>Region</label>
                        <input id="region" class="form-control skeleton" readonly />
                    </div>

                    <div class="mb-3">
                        <label>Warehouse</label>
                        <input id="warehouse" class="form-control skeleton" readonly />
                    </div>

                    <div class="mb-3">
                        <label>Address</label>
                        <textarea id="warehouseAddress" class="form-control skeleton" readonly></textarea>
                    </div>

                    <div class="profile-action-row">
                        <button class="btn btn-success profile-action-btn profile-update-btn" onclick="updateProfile()">Update Profile</button>
                        <button class="btn btn-success profile-action-btn profile-password-btn" onclick="openPasswordPopup()">Change Password</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Custom Change Password Modal -->
<div id="changePasswordModal" style="display:none; position:fixed; inset:0; z-index:9999; align-items:center; justify-content:center; background:rgba(0,0,0,0.5);">
    <div style="background:#fff; border-radius:12px; width:380px; max-width:95vw; overflow:hidden; box-shadow:0 20px 60px rgba(0,0,0,0.3);">
        <!-- Header -->
        <div style="background:#1b5e20; padding:16px 20px; display:flex; align-items:center; justify-content:space-between;">
            <span style="color:white; font-weight:600; font-size:16px;">Change Password</span>
            <button onclick="closePasswordPopup()" style="background:none; border:none; color:white; font-size:22px; cursor:pointer; line-height:1; padding:0 4px;">&times;</button>
        </div>
        <!-- Body -->
        <div style="padding:24px;">
            <div class="mb-3">
                <label>Email</label>
                <input id="cpEmail" class="form-control" readonly />
            </div>
            <div class="mb-3">
                <label>New Password</label>
                <input id="cpPassword" type="password" class="form-control" placeholder="Enter new password" />
            </div>
            <button class="btn btn-success profile-action-btn profile-update-btn" style="width:100%;" onclick="changePassword()">
                Update Password
            </button>
        </div>
    </div>
</div>
@section Scripts {
<script>
    let FO_ID = 0;
    let toast;

    $(document).ready(function () {

        loadProfile();

        // ❌ REMOVE ALL CLICK HANDLERS (NO LOOP ANYMORE)

        // ✅ IMAGE CHANGE
        $("#profileUpload").change(function () {

            let file = this.files[0];
            if (!file) return;

            // preview
            let reader = new FileReader();
            reader.onload = function (e) {
                $("#profileImg").attr("src", e.target.result);
            };
            reader.readAsDataURL(file);

            // upload
            let formData = new FormData();
            formData.append("image", file);

            $.ajax({
                url: foApiUrl("/upload-image"),
                type: "POST",
                data: formData,
                contentType: false,
                processData: false,

                success: function (res) {
                    $("#profileImg").attr(
                        "src",
                        res.imageUrl + "?t=" + new Date().getTime()
                    );
                    showToast("Image updated", "success");
                },

                error: function (xhr) {
                    if (handleFoUnauthorized(xhr)) return;
                    showToast("Upload failed", "error");
                }
            });

        });

    });

    function showToast(msg, type) {
        if (type === 'success') foSuccess('Success', msg);
        else if (type === 'error') foError('Error', msg);
        else if (type === 'warning') foWarning('Warning', msg);
        else foAlert(msg);
    }
    let passwordWindow = null; // kept for legacy compat

    function openPasswordPopup() {
        $("#cpEmail").val($("#email").val());
        $("#cpPassword").val("");
        var modal = document.getElementById("changePasswordModal");
        modal.style.display = "flex";
        // Close when clicking the backdrop
        modal.onclick = function(e) {
            if (e.target === modal) closePasswordPopup();
        };
    }

    function closePasswordPopup() {
        document.getElementById("changePasswordModal").style.display = "none";
    }

    function changePassword() {

        let formData = new FormData();
        formData.append("email", $("#cpEmail").val());
        formData.append("newPassword", $("#cpPassword").val());

        $.ajax({
            url: foApiUrl("/change-password"),
            type: "POST",
            data: formData,
            processData: false,
            contentType: false,

            success: function (res) {
                showToast(res.message, "success");
                $("#cpPassword").val("");
                closePasswordPopup();
            },

            error: function (err) {
                if (handleFoUnauthorized(err)) return;
                showToast(err.responseJSON?.message || "Failed", "error");
            }
        });
    }
    function loadProfile() {
        $.get(foApiUrl("/profile/me"), function (response) {
            if (response.success && response.data) {
                let p = response.data;

                FO_ID = p.id || p.Id || 0;

                // Remove skeleton & fill values
                $("#firstName").removeClass('skeleton').val(p.firstName || p.FirstName);
                $("#lastName").removeClass('skeleton').val(p.lastName || p.LastName);
                $("#email").removeClass('skeleton').val(p.email || p.Email);
                $("#phone").removeClass('skeleton').val(p.phone || p.Phone);
                $("#region").removeClass('skeleton').val(p.assignedRegion || p.AssignedRegion);
                $("#warehouse").removeClass('skeleton').val(p.warehouseName || p.WarehouseName);
                $("#warehouseAddress").removeClass('skeleton').val(p.warehouseAddress || p.WarehouseAddress);

                let fname = p.firstName || p.FirstName || "";
                let lname = p.lastName || p.LastName || "";
                $("#fullName").removeClass('skeleton').text(fname + " " + lname);

                let imgUrl = p.profileImageUrl || p.ProfileImageUrl;
                if (imgUrl) {
                    $("#profileImg").attr("src", imgUrl + "?t=" + new Date().getTime());
                }

                let date = p.createdAt || p.CreatedAt;
                if (date) {
                    $("#memberSince").removeClass('skeleton').text(new Date(date).toLocaleDateString());
                } else {
                    $("#memberSince").removeClass('skeleton').text('-');
                }
            }
        }).fail(function (err) {
            // Remove skeletons even on error
            $('#firstName, #lastName, #email, #phone, #region, #warehouse, #warehouseAddress')
                .removeClass('skeleton');
            $('#fullName, #memberSince').removeClass('skeleton');
            if (handleFoUnauthorized(err)) return;
            showToast("Failed to load profile data", "error");
            showFoLoadFailedAlert("profile data");
        });
    }
    function updateProfile() {

        let model = {
            id: FO_ID,
            firstName: $("#firstName").val().trim(),
            lastName: $("#lastName").val().trim(),
            phone: $("#phone").val().trim()
        };

        $.ajax({
            url: foApiUrl("/update-profile"),
            type: "PUT",
            contentType: "application/json",
            data: JSON.stringify(model),

            success: function () {
                showToast("Profile updated successfully", "success");
                loadProfile();
            },

            error: function (err) {
                if (handleFoUnauthorized(err)) return;
                showToast(err.responseJSON?.message || "Update failed", "error");
            }
        });
    }
</script>
}
