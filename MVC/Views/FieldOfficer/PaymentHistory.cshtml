@{
    Layout = "~/Views/Shared/Layouts/_FOLayout.cshtml";
    ViewData["Title"] = "Payment History";
}

<div class="ph-wrapper">
    <!-- Page Header -->
    <div class="ph-header">
        <div class="ph-title-section">
            <button class="ph-back-btn" onclick="history.back()">
                <i class="fa fa-arrow-left"></i>
            </button>
            <div>
                <h2>Payment History</h2>
                <p>All your payment transactions</p>
            </div>
        </div>
        <div id="summaryCards" class="ph-summary-cards">
            <!-- Will be populated by JS -->
        </div>
    </div>

    <!-- Filters -->
    <div class="ph-filters">
        <div class="ph-filter-group">
            <label>Filter by Status:</label>
            <select id="statusFilter" onchange="filterPayments()">
                <option value="">All</option>
                <option value="success">Completed</option>
                <option value="initiated">Initiated</option>
                <option value="failed">Failed</option>
            </select>
        </div>
        <div class="ph-filter-group">
            <label>Payment Type:</label>
            <select id="typeFilter" onchange="filterPayments()">
                <option value="">All</option>
                <option value="1">Advance (30%)</option>
                <option value="2">Remaining (70%)</option>
            </select>
        </div>
    </div>

    <!-- Payments Table -->
    <div class="ph-table-container">
        <table class="ph-table">
            <thead>
                <tr>
                    <th>UTR / Reference</th>
                    <th>Crop</th>
                    <th>Amount</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Date</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody id="paymentsList">
                <tr>
                    <td colspan="7" style="text-align:center;padding:20px;">
                        <i class="fa fa-spinner fa-spin"></i> Loading...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div class="ph-pagination" id="pagination" style="display:none;"></div>

</div>

<!-- Payment Detail Modal -->
<div id="paymentDetailModal" class="ph-modal" style="display:none;">
    <div class="ph-modal-content">
        <div class="ph-modal-header">
            <h3>Payment Details</h3>
            <button class="ph-modal-close" onclick="closePaymentDetail()">
                <i class="fa fa-times"></i>
            </button>
        </div>
        <div class="ph-modal-body" id="paymentDetailContent">
            <!-- Will be populated by JS -->
        </div>
    </div>
</div>

@section Scripts {

<link rel="stylesheet" href="~/css/pages/fieldofficer/paymenthistory.css" asp-append-version="true" />


<script>
    var allPayments = [];

    $(document).ready(function () {
        loadPaymentHistory();
    });

    function loadPaymentHistory() {
        // NOTE: Field Officers don't typically receive payments
        // This endpoint returns an empty state with proper message
        // If you need to track farmer payments associated with this FO's inspections,
        // that would require a different endpoint design
        $.ajax({
            url: foApiUrl('/fo-payment-summary'),
            type: 'GET',
            success: function (response) {
                if (response.success && response.payments) {
                    allPayments = response.payments;
                    renderSummary();
                    renderPayments(allPayments);
                } else if (response.success && (!response.payments || response.payments.length === 0)) {
                    showEmptyState('No payment history available');
                } else {
                    showEmptyState('No payment history available');
                }
            },
            error: function (xhr, status, error) {
                if (handleFoUnauthorized(xhr)) return;
                console.error('Payment history error:', error);
                showEmptyState('No payment history available');
                showFoLoadFailedAlert('payment history');
            }
        });
    }

    function renderSummary() {
        if (allPayments.length === 0) return;

        var totalCompleted = allPayments.filter(p => p.status === 'success').length;
        var totalAmount = allPayments
            .filter(p => p.status === 'success')
            .reduce((sum, p) => sum + p.amount, 0);

        var summaryHtml = `
            <div class="ph-card">
                <div class="ph-card-label">Total Payments</div>
                <div class="ph-card-value">${allPayments.length}</div>
            </div>
            <div class="ph-card">
                <div class="ph-card-label">Completed</div>
                <div class="ph-card-value">${totalCompleted}</div>
            </div>
            <div class="ph-card">
                <div class="ph-card-label">Total Amount</div>
                <div class="ph-card-value">â‚¹${Number(totalAmount).toLocaleString('en-IN')}</div>
            </div>
        `;

        $('#summaryCards').html(summaryHtml);
    }

    function renderPayments(payments) {
        if (payments.length === 0) {
            showEmptyState();
            return;
        }

        var html = '';
        payments.forEach(function (p) {
            var statusClass = 'ph-status-' + p.status;
            var typeClass = 'ph-type-' + (p.paymentNumber === 1 ? 'advance' : 'remaining');
            var typeText = p.paymentNumber === 1 ? 'Advance (30%)' : 'Remaining (70%)';

            var date = new Date(p.createdAt).toLocaleDateString('en-IN', {
                year: 'numeric',
                month: 'short',
                day: '2-digit'
            });

            var statusText = p.status.charAt(0).toUpperCase() + p.status.slice(1);

            html += `
                <tr>
                    <td data-label="UTR / Reference"><strong>${p.utrReference}</strong></td>
                    <td data-label="Crop">${p.cropName}</td>
                    <td data-label="Amount" class="ph-amount">â‚¹${Number(p.amount).toLocaleString('en-IN')}</td>
                    <td data-label="Type"><span class="ph-type-badge ${typeClass}">${typeText}</span></td>
                    <td data-label="Status"><span class="ph-status-badge ${statusClass}">${statusText}</span></td>
                    <td data-label="Date">${date}</td>
                    <td data-label="Action">
                        <button class="ph-btn-view" onclick="viewPaymentDetail(${p.paymentId})">
                            View
                        </button>
                    </td>
                </tr>
            `;
        });

        $('#paymentsList').html(html);
    }

    function filterPayments() {
        var statusFilter = $('#statusFilter').val();
        var typeFilter = $('#typeFilter').val();

        var filtered = allPayments.filter(function (p) {
            var matchStatus = !statusFilter || p.status === statusFilter;
            var matchType = !typeFilter || p.paymentNumber == typeFilter;
            return matchStatus && matchType;
        });

        renderPayments(filtered);
    }

    function viewPaymentDetail(paymentId) {
        $.ajax({
            url: foApiUrl('/payment/' + paymentId),
            type: 'GET',
            success: function (payment) {
                showPaymentDetail(payment);
            },
            error: function (xhr) {
                if (handleFoUnauthorized(xhr)) return;
                foError('Load Failed', 'Failed to load payment details. Please try again.');
            }
        });
    }

    function showPaymentDetail(payment) {
        var statusClass = 'ph-status-' + payment.status;
        var typeText = payment.paymentNumber === 1 ? 'Advance (30%)' : 'Remaining (70%)';
        var date = new Date(payment.createdAt).toLocaleString('en-IN');
        var settledDate = payment.settledAt 
            ? new Date(payment.settledAt).toLocaleString('en-IN') 
            : 'Pending';

        var html = `
            <div class="ph-detail-row">
                <span class="ph-detail-label">UTR Reference</span>
                <span class="ph-detail-value">${payment.utrReference}</span>
            </div>
            <div class="ph-detail-row">
                <span class="ph-detail-label">Farmer</span>
                <span class="ph-detail-value">${payment.farmerName}</span>
            </div>
            <div class="ph-detail-row">
                <span class="ph-detail-label">Crop</span>
                <span class="ph-detail-value">${payment.cropName}</span>
            </div>
            <div class="ph-detail-row">
                <span class="ph-detail-label">Type</span>
                <span class="ph-detail-value">${typeText}</span>
            </div>
            <div class="ph-detail-row">
                <span class="ph-detail-label">Amount</span>
                <span class="ph-detail-value">â‚¹${Number(payment.amount).toLocaleString('en-IN')}</span>
            </div>
            <div class="ph-detail-row">
                <span class="ph-detail-label">Payment Mode</span>
                <span class="ph-detail-value">${payment.paymentMode}</span>
            </div>
            <div class="ph-detail-row">
                <span class="ph-detail-label">Status</span>
                <span class="ph-detail-value">
                    <span class="ph-status-badge ${statusClass}">
                        ${payment.status.charAt(0).toUpperCase() + payment.status.slice(1)}
                    </span>
                </span>
            </div>
            <div class="ph-detail-row">
                <span class="ph-detail-label">Created At</span>
                <span class="ph-detail-value">${date}</span>
            </div>
            <div class="ph-detail-row">
                <span class="ph-detail-label">Settled At</span>
                <span class="ph-detail-value">${settledDate}</span>
            </div>
            ${payment.farmerPhone ? `
                <div class="ph-detail-row">
                    <span class="ph-detail-label">Farmer Phone</span>
                    <span class="ph-detail-value">${payment.farmerPhone}</span>
                </div>
            ` : ''}
        `;

        $('#paymentDetailContent').html(html);
        $('#paymentDetailModal').show();
    }

    function closePaymentDetail() {
        $('#paymentDetailModal').hide();
    }

    function showEmptyState(message) {
        message = message || 'No payments found';
        $('#paymentsList').html(`
            <tr>
                <td colspan="7" style="text-align:center;padding:40px;color:#999;">
                    <i class="fa fa-inbox" style="font-size:32px;margin-bottom:12px;display:block;"></i>
                    ${message}
                </td>
            </tr>
        `);
    }

    // Close modal when clicking outside
    $(document).click(function (e) {
        if (e.target.id === 'paymentDetailModal') {
            closePaymentDetail();
        }
    });
</script>
}


