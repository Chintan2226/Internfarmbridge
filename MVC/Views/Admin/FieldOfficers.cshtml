@{
    ViewData["Title"] = "Field Officer Management";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}


<link rel="stylesheet" href="~/css/pages/admin/fieldofficers.css" asp-append-version="true" />


<!-- PAGE BODY -->
<div class="fo-page">

    <div class="page-top">
        <div>
            <div class="page-label">User Management</div>
            <div class="page-title">Field Officer Management</div>
            <div class="page-sub">Assign, monitor, and manage field officers across warehouses and regions</div>
        </div>
        <div class="page-actions">
            <button class="fo-btn fo-btn-outline" onclick="foLoadAuditLog()">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                Audit Log
            </button>
            <button class="fo-btn fo-btn-primary" onclick="foExportCSV()">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                Export CSV
            </button>
        </div>
    </div>

    <!-- API Status Banner -->
    <div class="api-banner" id="fo-api-banner">
        <span id="fo-api-banner-msg"></span>
    </div>

    <!-- Stats -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-strip" style="background:var(--green-main)"></div>
            <div class="stat-icon-wrap" style="background:var(--green-light)">👷</div>
            <div class="stat-label">Total Field Officers</div>
            <div class="stat-value" id="stat-total"><div class="fb-skeleton fb-skeleton-text" style="width:50%; height:28px;"></div></div>
            <div class="stat-note green" id="stat-total-note"><div class="fb-skeleton fb-skeleton-text" style="width:70%; height:12px;"></div></div>
        </div>
        <div class="stat-card">
            <div class="stat-strip" style="background:var(--green-main)"></div>
            <div class="stat-icon-wrap" style="background:var(--green-light)">✅</div>
            <div class="stat-label">Active Officers</div>
            <div class="stat-value" id="stat-active"><div class="fb-skeleton fb-skeleton-text" style="width:50%; height:28px;"></div></div>
            <div class="stat-note green" id="stat-active-note"><div class="fb-skeleton fb-skeleton-text" style="width:70%; height:12px;"></div></div>
        </div>
        <div class="stat-card">
            <div class="stat-strip" style="background:#3B82F6"></div>
            <div class="stat-icon-wrap" style="background:var(--blue-bg)">🏫</div>
            <div class="stat-label">Warehouses Covered</div>
            <div class="stat-value" id="stat-warehouses"><div class="fb-skeleton fb-skeleton-text" style="width:50%; height:28px;"></div></div>
            <div class="stat-note blue" id="stat-warehouse-note"><div class="fb-skeleton fb-skeleton-text" style="width:70%; height:12px;"></div></div>
        </div>
        <div class="stat-card">
            <div class="stat-strip" style="background:var(--amber)"></div>
            <div class="stat-icon-wrap" style="background:var(--amber-bg)">🔍</div>
            <div class="stat-label">Inspections Done</div>
            <div class="stat-value" id="stat-inspections"><div class="fb-skeleton fb-skeleton-text" style="width:50%; height:28px;"></div></div>
            <div class="stat-note amber">This month</div>
        </div>
    </div>

    <!-- Toolbar -->
    <div class="toolbar">
        <div class="search-wrap">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0"/></svg>
            <input type="text" id="fo-search" class="search-input" placeholder="Search by name, region, or warehouse..." oninput="foFilterData()" />
        </div>
        <select id="fo-status-filter" class="filter-select" onchange="foFilterData()">
            <option value="">All Status</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
        </select>
        <select id="fo-region-filter" class="filter-select" onchange="foFilterData()">
            <option value="">All Regions</option>
        </select>
        <button class="fo-btn fo-btn-outline fo-btn-sm" onclick="foClearFilters()">Clear</button>
        <span class="result-count" id="fo-result-count">Showing 0 officers</span>
        <div class="view-toggle">
            <button class="view-btn active" id="btn-card-view" onclick="foSetView('card')">
                <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                Cards
            </button>
            <button class="view-btn" id="btn-table-view" onclick="foSetView('table')">
                <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18M10 4v16M6 4h12a2 2 0 012 2v12a2 2 0 01-2 2H6a2 2 0 01-2-2V6a2 2 0 012-2z"/></svg>
                Table
            </button>
        </div>
    </div>

    <!-- Card View -->
    <div id="fo-card-view">
        <div class="cards-grid" id="fo-cards-container">
            <div class="empty-state" style="grid-column:1/-1"></div>
        </div>
        <div style="display:flex;align-items:center;justify-content:space-between;margin-top:16px">
            <div class="fo-pagination" style="border:none;padding:0">
                <button class="pg-btn" id="c-pg-first" onclick="foGoPage(1)" disabled>&#171;</button>
                <button class="pg-btn" id="c-pg-prev"  onclick="foGoPage(currentFoPage-1)" disabled>&#8249;</button>
                <span id="c-pg-nums"></span>
                <button class="pg-btn" id="c-pg-next"  onclick="foGoPage(currentFoPage+1)" disabled>&#8250;</button>
                <button class="pg-btn" id="c-pg-last"  onclick="foGoPage(totalFoPages)" disabled>&#187;</button>
            </div>
            <span class="pg-total" id="c-pg-total"></span>
        </div>
    </div>

    <!-- Table View -->
    <div id="fo-table-view" style="display:none">
        <div class="table-card">
            <div class="table-head-row">
                <div>
                    <span class="table-title">Field Officer Directory</span>
                    <span class="table-badge" id="t-badge">0 officers</span>
                </div>
                <span style="font-size:12px;color:var(--text-light)">25 records / page</span>
            </div>
            <table class="fo-table">
                <thead>
                    <tr>
                        <th>Officer</th><th>Phone</th><th>Assigned Region</th>
                        <th>Warehouse</th><th>Inspections</th><th>Joined</th>
                        <th>Status</th><th>Actions</th>
                    </tr>
                </thead>
                <tbody id="fo-tbody">
                    <tr><td colspan="8" style="text-align:center;padding:30px;color:var(--text-light)"></td></tr>
                </tbody>
            </table>
            <div class="fo-pagination">
                <button class="pg-btn" id="t-pg-first" onclick="foGoPage(1)" disabled>&#171;</button>
                <button class="pg-btn" id="t-pg-prev"  onclick="foGoPage(currentFoPage-1)" disabled>&#8249;</button>
                <span id="t-pg-nums"></span>
                <button class="pg-btn" id="t-pg-next"  onclick="foGoPage(currentFoPage+1)" disabled>&#8250;</button>
                <button class="pg-btn" id="t-pg-last"  onclick="foGoPage(totalFoPages)" disabled>&#187;</button>
                <select class="pg-select" onchange="foChangePageSize(this.value)">
                    <option value="25">25</option><option value="50">50</option>
                </select>
                <span class="pg-label">items per page</span>
                <span class="pg-total" id="t-pg-total"></span>
            </div>
        </div>
    </div>

</div><!-- /fo-page -->


<!-- MODAL -->
<div class="fo-modal-overlay" id="fo-modal-overlay" onclick="foCloseModalOnOverlay(event)">
    <div class="fo-modal" onclick="event.stopPropagation()">
        <div class="fo-modal-header">
            <span class="fo-modal-title" id="fo-modal-title">Field Officer Profile</span>
            <button class="fo-modal-close" onclick="foCloseModal()">&#215;</button>
        </div>
        <div class="fo-modal-body">

            <div class="profile-hero">
                <div class="profile-hero-avatar" id="m-avatar">FO</div>
                <div style="flex:1;min-width:0">
                    <div class="profile-hero-name" id="m-name">—</div>
                    <div class="profile-hero-meta" id="m-meta">—</div>
                    <div class="profile-hero-status" id="m-status-badge"></div>
                </div>
                <div class="profile-hero-actions">
                    <button class="fo-btn fo-btn-sm fo-btn-activate"   onclick="foChangeStatus(true)">✓ Activate</button>
                    <button class="fo-btn fo-btn-sm fo-btn-deactivate" onclick="foChangeStatus(false)">⊘ Deactivate</button>
                </div>
            </div>

            <div class="perf-grid">
                <div class="perf-card"><div class="perf-val" id="m-perf-inspections">—</div><div class="perf-label">Total Inspections</div></div>
                <div class="perf-card"><div class="perf-val" id="m-perf-passed">—</div><div class="perf-label">Passed</div></div>
                <div class="perf-card"><div class="perf-val" id="m-perf-lots">—</div><div class="perf-label">Lots Managed</div></div>
            </div>

            <div class="fo-tabs">
                <div class="fo-tab-item active" onclick="foSwitchTab(this,'tab-profile')">
                    <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                    Profile
                </div>
                <div class="fo-tab-item" onclick="foSwitchTab(this,'tab-inspections')">
                    <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                    Inspections <span class="tab-badge" id="tab-insp-count">0</span>
                </div>
                <div class="fo-tab-item" onclick="foSwitchTab(this,'tab-slots')">
                    <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    Warehouse Slots <span class="tab-badge" id="tab-slots-count">0</span>
                </div>
            </div>

            <div id="tab-profile">
                <div class="info-cards-grid">
                    <div class="info-card">
                        <div class="info-card-icon-label"><div class="info-card-icon"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg></div><div class="info-card-label">Full Name</div></div>
                        <div class="info-card-val" id="m-fullname">—</div>
                    </div>
                    <div class="info-card">
                        <div class="info-card-icon-label"><div class="info-card-icon"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg></div><div class="info-card-label">Phone</div></div>
                        <div class="info-card-val" id="m-phone">—</div>
                    </div>
                    <div class="info-card">
                        <div class="info-card-icon-label"><div class="info-card-icon"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/></svg></div><div class="info-card-label">Email</div></div>
                        <div class="info-card-val" id="m-email">—</div>
                    </div>
                    <div class="info-card">
                        <div class="info-card-icon-label"><div class="info-card-icon"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg></div><div class="info-card-label">Assigned Region</div></div>
                        <div class="info-card-val" id="m-region">—</div>
                    </div>
                    <div class="info-card">
                        <div class="info-card-icon-label"><div class="info-card-icon"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg></div><div class="info-card-label">Warehouse</div></div>
                        <div class="info-card-val" id="m-warehouse">—</div>
                    </div>
                    <div class="info-card">
                        <div class="info-card-icon-label"><div class="info-card-icon"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg></div><div class="info-card-label">Joined</div></div>
                        <div class="info-card-val" id="m-joined">—</div>
                    </div>
                    <div class="info-card info-card-full">
                        <div class="info-card-icon-label"><div class="info-card-icon"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></div><div class="info-card-label">Account Status</div></div>
                        <div class="info-card-val" id="m-acc-status">—</div>
                    </div>
                </div>
                <div class="info-note">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                    Status changes are logged with Admin ID:1 in <strong style="margin-left:3px">t_notifications</strong>.
                </div>
            </div>

            <div id="tab-inspections" style="display:none">
                <div id="inspections-content"><div class="empty-state"></div></div>
            </div>
            <div id="tab-slots" style="display:none">
                <div id="slots-content"><div class="empty-state"></div></div>
            </div>

        </div>
    </div>
</div>

<div class="fo-toast" id="fo-toast"></div>


@section Scripts {
<script>
(function () {
    'use strict';

    /* -- CONFIG -- */
    var API_BASE = 'http://localhost:5020/api/Admin';

    /* -- Token helper -- */
    function getToken() {
        var keys = ['authToken', 'token', 'jwt', 'accessToken'];
        try { for (var k of keys) { var v = localStorage.getItem(k);   if (v) return v; } } catch(e){}
        try { for (var k of keys) { var v = sessionStorage.getItem(k); if (v) return v; } } catch(e){}
        return '';
    }
    function buildHeaders() {
        var h = { 'Content-Type': 'application/json' };
        var t = getToken();
        if (t) h['Authorization'] = 'Bearer ' + t;
        return h;
    }

    /* -- State -- */
    var allOfficers      = [];
    var filteredOfficers = [];
    var currentFoPage    = 1;
    var foPageSize       = 9;
    var totalFoPages     = 1;
    var currentFoView    = 'card';
    var currentFoId      = null;

    window.currentFoPage = currentFoPage;
    window.totalFoPages  = totalFoPages;

    /* == INIT == */
    document.addEventListener('DOMContentLoaded', function () { loadOfficers(); });

    async function loadOfficers() {
        if (typeof FBSkeleton !== 'undefined') {
            FBSkeleton.show('#fo-cards-container', 9, 'farmer');
        }
        if (typeof window.showGridSkeleton === 'function') {
            window.showGridSkeleton('#fo-tbody', 10);
        }
        setBanner('loading', '⏳ Connecting to API...');
        try {
            var controller = new AbortController();
            var tid = setTimeout(function () { controller.abort(); }, 10000);

            var res = await fetch(API_BASE + '/field-officers', {
                method: 'GET',
                headers: buildHeaders(),
                signal: controller.signal
            });
            clearTimeout(tid);

            if (res.status === 401) {
                setBanner('error', '🔒 401 Unauthorized — your session may have expired.');
                allOfficers = [];
            } else if (res.status === 403) {
                setBanner('error', '⛔ 403 Forbidden — admin access required.');
                allOfficers = [];
            } else if (!res.ok) {
                var text = await res.text();
                setBanner('error', '❌ HTTP ' + res.status + (text ? ': ' + text.substring(0, 120) : ''));
                allOfficers = [];
            } else {
                var json = await res.json();
                allOfficers = json.data || json.items || (Array.isArray(json) ? json : []);
                allOfficers = allOfficers.map(normaliseOfficer);
                hideBanner();
                foShowToast('✅ Loaded ' + allOfficers.length + ' field officers');
            }
        } catch (err) {
            if (err.name === 'AbortError') {
                setBanner('error', '⌛ Request timed out — is the backend running?');
            } else {
                setBanner('error', '🔗 Cannot connect to API — ' + err.message);
            }
            console.error('[FO] loadOfficers:', err);
            allOfficers = [];
        }

        filteredOfficers = allOfficers.slice();
        foPopulateRegionFilter();
        foUpdateStats();
        foRender();
    }

    function normaliseOfficer(o) {
        return {
            id:              o.id              ?? o.Id,
            foCode:          o.foCode          ?? o.FoCode          ?? ('FO-' + (o.id ?? o.Id)),
            fullName:        o.fullName        ?? o.FullName        ?? '',
            email:           o.email           ?? o.Email           ?? '',
            phone:           o.phone           ?? o.Phone           ?? '',
            assignedRegion:  o.assignedRegion  ?? o.AssignedRegion  ?? '',
            warehouseName:   o.warehouseName   ?? o.WarehouseName   ?? '',
            warehouseId:     o.warehouseId     ?? o.WarehouseId,
            inspectionCount: o.inspectionCount ?? o.InspectionCount ?? o.totalInspections ?? o.TotalInspections ?? 0,
            passedCount:     o.passedCount     ?? o.PassedCount     ?? 0,
            lotsManaged:     o.lotsManaged     ?? o.LotsManaged     ?? 0,
            isActive:        o.isActive        ?? o.IsActive        ?? false,
            createdAt:       o.createdAt       ?? o.CreatedAt       ?? null
        };
    }

    /* == BANNER == */
    function setBanner(type, msg) {
        var b = document.getElementById('fo-api-banner');
        b.className = 'api-banner ' + type;
        document.getElementById('fo-api-banner-msg').innerHTML = msg;
    }
    function hideBanner() { document.getElementById('fo-api-banner').className = 'api-banner'; }

    /* == STATS == */
    function foUpdateStats() {
        var total       = allOfficers.length;
        var active      = allOfficers.filter(function (o) { return o.isActive; }).length;
        var warehouses  = new Set(allOfficers.map(function (o) { return o.warehouseId; }).filter(Boolean)).size;
        var inspections = allOfficers.reduce(function (s, o) { return s + (o.inspectionCount || 0); }, 0);

        document.getElementById('stat-total').textContent        = total;
        document.getElementById('stat-active').textContent       = active;
        document.getElementById('stat-warehouses').textContent   = warehouses;
        document.getElementById('stat-inspections').textContent  = inspections;
        document.getElementById('stat-total-note').textContent   = total + ' registered';
        document.getElementById('stat-active-note').textContent  = total > 0 ? Math.round((active / total) * 100) + '% active rate' : '—';
        document.getElementById('stat-warehouse-note').textContent = 'Across ' + warehouses + ' locations';
    }

    /* == FILTERS == */
    function foPopulateRegionFilter() {
        var regions = [...new Set(allOfficers.map(function (o) { return o.assignedRegion; }).filter(Boolean))].sort();
        var sel = document.getElementById('fo-region-filter');
        sel.innerHTML = '<option value="">All Regions</option>';
        regions.forEach(function (r) { var op = document.createElement('option'); op.value = r; op.textContent = r; sel.appendChild(op); });
    }

    window.foFilterData = function () {
        var q      = document.getElementById('fo-search').value.toLowerCase();
        var status = document.getElementById('fo-status-filter').value;
        var region = document.getElementById('fo-region-filter').value;
        filteredOfficers = allOfficers.filter(function (o) {
            var mq = !q || (o.fullName + o.assignedRegion + o.warehouseName).toLowerCase().includes(q);
            var ms = !status || (status === 'active' ? o.isActive : !o.isActive);
            var mr = !region || o.assignedRegion === region;
            return mq && ms && mr;
        });
        currentFoPage = 1;
        foRender();
    };

    window.foClearFilters = function () {
        document.getElementById('fo-search').value = '';
        document.getElementById('fo-status-filter').value = '';
        document.getElementById('fo-region-filter').value = '';
        filteredOfficers = allOfficers.slice();
        currentFoPage = 1;
        foRender();
    };

    /* == VIEW == */
    window.foSetView = function (v) {
        currentFoView = v;
        foPageSize = v === 'card' ? 9 : 25;
        currentFoPage = 1;
        document.getElementById('fo-card-view').style.display  = v === 'card'  ? 'block' : 'none';
        document.getElementById('fo-table-view').style.display = v === 'table' ? 'block' : 'none';
        document.getElementById('btn-card-view').className  = 'view-btn' + (v === 'card'  ? ' active' : '');
        document.getElementById('btn-table-view').className = 'view-btn' + (v === 'table' ? ' active' : '');
        foRender();
    };

    /* == RENDER == */
    function foRender() {
        totalFoPages = Math.max(1, Math.ceil(filteredOfficers.length / foPageSize));
        window.totalFoPages  = totalFoPages;
        window.currentFoPage = currentFoPage;

        var start = (currentFoPage - 1) * foPageSize;
        var slice = filteredOfficers.slice(start, start + foPageSize);

        document.getElementById('fo-result-count').textContent = 'Showing ' + filteredOfficers.length + ' of ' + allOfficers.length + ' officers';

        if (currentFoView === 'card') foRenderCards(slice);
        else foRenderTable(slice);
        foRenderPagination(start);
    }

    function foRenderCards(slice) {
        var c = document.getElementById('fo-cards-container');
        if (!slice.length) { c.innerHTML = '<div class="empty-state" style="grid-column:1/-1">No field officers found</div>'; return; }
        c.innerHTML = slice.map(function (o) {
            return '<div class="fo-card">' +
                '<div class="fo-card-header">' +
                    '<div class="fo-avatar">' + foGetInitials(o.fullName) + '</div>' +
                    '<div style="min-width:0"><div class="fo-card-name">' + foEsc(o.fullName) + '</div><div class="fo-card-id">#' + foEsc(o.foCode) + '</div></div>' +
                    '<div class="fo-card-status">' + foGetPill(o.isActive) + '</div>' +
                '</div>' +
                '<div class="fo-card-body">' +
                    '<div class="fo-info-row"><div class="fo-info-icon"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg></div><div><div class="fo-info-label">Phone</div><div class="fo-info-val">' + foEsc(o.phone || '—') + '</div></div></div>' +
                    '<div class="fo-info-row"><div class="fo-info-icon"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg></div><div><div class="fo-info-label">Assigned Region</div><div class="fo-info-val">' + foEsc(o.assignedRegion || '—') + '</div></div></div>' +
                    '<div class="fo-info-row"><div class="fo-info-icon"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg></div><div><div class="fo-info-label">Warehouse</div><div class="fo-info-val">' + foEsc(o.warehouseName || '—') + '</div></div></div>' +
                '</div>' +
                '<div class="fo-card-footer">' +
                    '<button class="fo-btn fo-btn-sm fo-btn-view" onclick="foOpenModal(' + o.id + ')">View Details</button>' +
                    (o.isActive
                        ? '<button class="fo-btn fo-btn-sm fo-btn-deactivate" onclick="foQuickStatus(' + o.id + ',false)">Deactivate</button>'
                        : '<button class="fo-btn fo-btn-sm fo-btn-activate" onclick="foQuickStatus(' + o.id + ',true)">Activate</button>') +
                '</div>' +
            '</div>';
        }).join('');
    }

    function foRenderTable(slice) {
        var tbody = document.getElementById('fo-tbody');
        document.getElementById('t-badge').textContent = filteredOfficers.length + ' officers';
        if (!slice.length) { tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:32px;color:var(--text-light)">No field officers found</td></tr>'; return; }
        tbody.innerHTML = slice.map(function (o) {
            return '<tr>' +
                '<td><div class="fo-cell"><div class="avatar-sm">' + foGetInitials(o.fullName) + '</div><div><div class="fo-name">' + foEsc(o.fullName) + '</div><div class="fo-code">#' + foEsc(o.foCode) + '</div></div></div></td>' +
                '<td>' + foEsc(o.phone || '—') + '</td>' +
                '<td>' + foEsc(o.assignedRegion || '—') + '</td>' +
                '<td>' + foEsc(o.warehouseName || '—') + '</td>' +
                '<td>' + foFormatDate(o.createdAt) + '</td>' +
                '<td>' + foGetPill(o.isActive) + '</td>' +
                '<td><div class="actions-cell">' +
                    '<button class="fo-btn fo-btn-sm fo-btn-view" onclick="foOpenModal(' + o.id + ')">View</button>' +
                    (o.isActive
                        ? '<button class="fo-btn fo-btn-sm fo-btn-deactivate" onclick="foQuickStatus(' + o.id + ',false)">Deactivate</button>'
                        : '<button class="fo-btn fo-btn-sm fo-btn-activate" onclick="foQuickStatus(' + o.id + ',true)">Activate</button>') +
                '</div></td>' +
            '</tr>';
        }).join('');
    }

    function foRenderPagination(start) {
        var p = currentFoView === 'card' ? 'c' : 't';
        var numsEl  = document.getElementById(p + '-pg-nums');
        var totalEl = document.getElementById(p + '-pg-total');
        var html = '';
        var maxP = Math.min(totalFoPages, 5);
        for (var i = 1; i <= maxP; i++) html += '<button class="pg-btn' + (i === currentFoPage ? ' active' : '') + '" onclick="foGoPage(' + i + ')">' + i + '</button>';
        if (numsEl) numsEl.innerHTML = html;
        if (totalEl) totalEl.textContent = filteredOfficers.length > 0
            ? 'Showing ' + (start + 1) + '–' + Math.min(start + foPageSize, filteredOfficers.length) + ' of ' + filteredOfficers.length
            : '';
        ['first', 'prev', 'next', 'last'].forEach(function (t) {
            var el = document.getElementById(p + '-pg-' + t);
            if (el) el.disabled = (t === 'first' || t === 'prev') ? currentFoPage === 1 : currentFoPage === totalFoPages;
        });
    }

    window.foGoPage = function (pg) { if (pg < 1 || pg > totalFoPages) return; currentFoPage = pg; window.currentFoPage = pg; foRender(); };
    window.foChangePageSize = function (v) { foPageSize = parseInt(v); currentFoPage = 1; foRender(); };

    /* == MODAL — open == */
    window.foOpenModal = function (id) {
        currentFoId = id;
        var o = allOfficers.find(function (x) { return x.id === id; });
        if (!o) return;

        document.getElementById('fo-modal-title').textContent     = 'Field Officer — ' + o.fullName;
        document.getElementById('m-avatar').textContent           = foGetInitials(o.fullName);
        document.getElementById('m-name').textContent             = o.fullName || '—';
        document.getElementById('m-meta').textContent             = '#' + o.foCode + ' · Joined ' + foFormatDate(o.createdAt);
        document.getElementById('m-status-badge').innerHTML       = foGetPill(o.isActive);
        document.getElementById('m-fullname').textContent         = o.fullName || '—';
        document.getElementById('m-phone').textContent            = o.phone || '—';
        document.getElementById('m-email').textContent            = o.email || '—';
        document.getElementById('m-region').textContent           = o.assignedRegion || '—';
        document.getElementById('m-warehouse').textContent        = o.warehouseName || '—';
        document.getElementById('m-joined').textContent           = foFormatDate(o.createdAt);
        document.getElementById('m-acc-status').textContent       = o.isActive ? 'Active' : 'Inactive';

        document.getElementById('m-perf-inspections').textContent = o.inspectionCount || 0;
        document.getElementById('m-perf-passed').textContent      = o.passedCount     || 0;
        document.getElementById('m-perf-lots').textContent        = o.lotsManaged     || 0;

        foSwitchTabByName('tab-profile');
        document.getElementById('fo-modal-overlay').classList.add('open');

        foLoadDetail(id);
        foLoadInspections(id);
        foLoadSlots(id);
    };

    async function foLoadDetail(id) {
        try {
            var res  = await fetch(API_BASE + '/FoDetail/' + id, { headers: buildHeaders() });
            if (!res.ok) return;
            var json = await res.json();
            if (!json.success || !json.data) return;
            var d = json.data;

            document.getElementById('m-perf-inspections').textContent = d.totalInspections  ?? 0;
            document.getElementById('m-perf-passed').textContent      = d.passedInspections ?? 0;
            document.getElementById('m-perf-lots').textContent        = d.lotsManaged       ?? 0;
        } catch (e) {
            console.warn('[FO] foLoadDetail:', e);
        }
    }

    async function foLoadInspections(id) {
        var el = document.getElementById('inspections-content');
        if (typeof window.showGridSkeleton === 'function') {
            window.showGridSkeleton(el, 3);
        }
        try {
            var res = await fetch(API_BASE + '/FoInspections/' + id, { headers: buildHeaders() });
            if (!res.ok) throw new Error('HTTP ' + res.status);
            var json = await res.json();

            document.getElementById('tab-insp-count').textContent = json.total || 0;

            var rows = json.data || [];
            if (!rows.length) {
                el.innerHTML = '<div class="empty-state">No inspections recorded</div>';
                return;
            }

            el.innerHTML =
                '<table class="mini-table">' +
                '<thead><tr>' +
                  '<th>Insp. ID</th><th>Crop</th><th>Farmer</th>' +
                  '<th>Grade</th><th>Weight (kg)</th><th>Accepted</th>' +
                  '<th>Passed</th><th>Submitted</th>' +
                '</tr></thead><tbody>' +
                rows.map(function (d) {
                    var gradeKey = (d.grade || '').toUpperCase().charAt(0) || 'A';
                    return '<tr>' +
                        '<td>#' + (d.inspectionId || d.InspectionId) + '</td>' +
                        '<td>' + foEsc(d.cropName || d.CropName || '—') +
                            (d.variety || d.Variety ? ' <small style="color:var(--text-muted)">(' + foEsc(d.variety || d.Variety) + ')</small>' : '') +
                        '</td>' +
                        '<td>' + foEsc(d.farmerName || d.FarmerName || '—') + '</td>' +
                        '<td><span class="grade-badge grade-' + gradeKey + '">' + foEsc(d.grade || d.Grade || '—') + '</span></td>' +
                        '<td>' + (d.weightCheckedKg ?? d.WeightCheckedKg ?? '—') + '</td>' +
                        '<td>' + (d.acceptedQuantity ?? d.AcceptedQuantity ?? '—') + ' kg</td>' +
                        '<td>' + ((d.passed ?? d.Passed)
                            ? '<span class="status-pill pill-active"><span class="pill-dot"></span>Yes</span>'
                            : '<span class="status-pill pill-inactive"><span class="pill-dot"></span>No</span>') +
                        '</td>' +
                        '<td>' + foFormatDate(d.submittedAt || d.SubmittedAt) + '</td>' +
                    '</tr>';
                }).join('') +
                '</tbody></table>';
        } catch (e) {
            el.innerHTML = '<div class="empty-state">Could not load inspections.<br><small>' + foEsc(e.message) + '</small></div>';
            console.warn('[FO] foLoadInspections:', e);
        }
    }

    async function foLoadSlots(id) {
        var el = document.getElementById('slots-content');
        if (typeof window.showGridSkeleton === 'function') {
            window.showGridSkeleton(el, 3);
        }
        try {
            var res = await fetch(API_BASE + '/FoWarehouseSlots/' + id, { headers: buildHeaders() });
            if (!res.ok) throw new Error('HTTP ' + res.status);
            var json = await res.json();

            document.getElementById('tab-slots-count').textContent = json.total || 0;

            var rows = json.data || [];
            if (!rows.length) {
                el.innerHTML = '<div class="empty-state">No warehouse slots found</div>';
                return;
            }

            el.innerHTML =
                '<table class="mini-table">' +
                '<thead><tr>' +
                  '<th>Farmer</th><th>Crop</th><th>Slot Date</th>' +
                  '<th>Time</th><th>Warehouse</th>' +
                  '<th>Booking</th><th>Check-In</th><th>Lot</th>' +
                '</tr></thead><tbody>' +
                rows.map(function (s) {
                    var lotCell = (s.lotId || s.LotId)
                        ? '<span class="status-pill pill-active" style="font-size:10px">' +
                              'Grade ' + foEsc(s.lotGrade || s.LotGrade || '—') +
                              ' · ' + (s.quantityAccepted ?? s.QuantityAccepted ?? 0) + ' kg' +
                          '</span>'
                        : '<span style="color:var(--text-light);font-size:12px">—</span>';

                    return '<tr>' +
                        '<td>' + foEsc(s.farmerName || s.FarmerName || '—') + '</td>' +
                        '<td>' + foEsc(s.cropName   || s.CropName   || '—') + '</td>' +
                        '<td>' + foFormatDate(s.slotDate   || s.SlotDate)   + '</td>' +
                        '<td style="white-space:nowrap">' +
                            foEsc((s.slotTimeStart || s.SlotTimeStart || '—') + ' – ' + (s.slotTimeEnd || s.SlotTimeEnd || '—')) +
                        '</td>' +
                        '<td>' + foEsc(s.warehouseName || s.WarehouseName || '—') + '</td>' +
                        '<td>' + foEsc(s.bookingStatus || s.BookingStatus || '—') + '</td>' +
                        '<td>' + foEsc((s.checkInStatus || s.CheckInStatus || '—').replace(/_/g,' ')) + '</td>' +
                        '<td>' + lotCell + '</td>' +
                    '</tr>';
                }).join('') +
                '</tbody></table>';
        } catch (e) {
            el.innerHTML = '<div class="empty-state">Could not load warehouse slots.<br><small>' + foEsc(e.message) + '</small></div>';
            console.warn('[FO] foLoadSlots:', e);
        }
    }

    /* == MODAL — close / tabs == */
    window.foCloseModal = function () { document.getElementById('fo-modal-overlay').classList.remove('open'); currentFoId = null; };
    window.foCloseModalOnOverlay = function (e) { if (e.target === document.getElementById('fo-modal-overlay')) foCloseModal(); };

    window.foSwitchTab = function (el, id) {
        document.querySelectorAll('.fo-tab-item').forEach(function (t) { t.classList.remove('active'); });
        el.classList.add('active');
        foSwitchTabByName(id);
    };
    function foSwitchTabByName(id) {
        ['tab-profile', 'tab-inspections', 'tab-slots'].forEach(function (t) {
            document.getElementById(t).style.display = t === id ? 'block' : 'none';
        });
    }

    /* == STATUS TOGGLE == */
    window.foChangeStatus = async function (active) { if (!currentFoId) return; await foQuickStatus(currentFoId, active); foCloseModal(); };

    window.foQuickStatus = async function (id, active) {
        try {
            var res = await fetch(API_BASE + '/' + id + '/update-status', {
                method: 'PATCH',
                headers: buildHeaders(),
                body: JSON.stringify({ isActive: active })
            });
            
            if (!res.ok) throw new Error('HTTP ' + res.status);
            
            var o = allOfficers.find(function (x) { return x.id === id; });
            if (o) o.isActive = active;
            filteredOfficers = filteredOfficers.map(function (x) { return x.id === id ? Object.assign({}, x, { isActive: active }) : x; });
            
            foUpdateStats();
            foRender();
            foShowToast('Officer ' + (active ? 'activated' : 'deactivated') + ' successfully');
        } catch (e) {
            foShowToast('Failed to update status: ' + e.message, true);
        }
    };

    /* == EXPORT / AUDIT == */
    window.foExportCSV = function () {
        var headers = ['Code', 'Full Name', 'Phone', 'Email', 'Region', 'Warehouse', 'Status', 'Joined'];
        var rows = filteredOfficers.map(function (o) {
            return [o.foCode, o.fullName, o.phone, o.email, o.assignedRegion, o.warehouseName,
                    o.isActive ? 'Active' : 'Inactive', foFormatDate(o.createdAt)]
                .map(function (c) { return '"' + String(c || '').replace(/"/g, '""') + '"'; }).join(',');
        });
        var csv = [headers.join(',')].concat(rows).join('\n');
        var a = document.createElement('a');
        a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' }));
        a.download = 'field_officers_' + new Date().toISOString().slice(0, 10) + '.csv';
        a.click();
        foShowToast('CSV exported successfully');
    };

    window.foLoadAuditLog = function () { foShowToast('Audit log module triggered'); };

    /* == HELPERS == */
    function foGetInitials(name) { return (name || 'FO').split(' ').map(function (w) { return w[0]; }).join('').substring(0, 2).toUpperCase(); }
    function foGetPill(active) {
        return active
            ? '<span class="status-pill pill-active"><span class="pill-dot"></span>Active</span>'
            : '<span class="status-pill pill-inactive"><span class="pill-dot"></span>Inactive</span>';
    }
    function foFormatDate(d) {
        if (!d) return '—';
        var dt = new Date(d);
        return isNaN(dt) ? String(d) : dt.toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });
    }
    function foEsc(s) { return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
    function foShowToast(msg, err) {
        var el = document.getElementById('fo-toast');
        el.innerHTML = msg;
        el.className = 'fo-toast' + (err ? ' error' : '') + ' show';
        setTimeout(function () { el.classList.remove('show'); }, 3500);
    }

})();
</script>
}
