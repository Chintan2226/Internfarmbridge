@{
    ViewData["Title"] = "Field Officer Management";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}


<link rel="stylesheet" href="~/css/pages/admin/fieldofficers.css" asp-append-version="true" />


<!-- PAGE BODY -->
<div class="fo-page">

    <div class="page-top">
        <div>
            <div class="page-label">User Management</div>
            <div class="page-title">Field Officer Management</div>
            <div class="page-sub">Assign, monitor, and manage field officers across warehouses and regions</div>
        </div>
        <div class="page-actions">
            <button class="fo-btn fo-btn-outline" onclick="foLoadAuditLog()">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                Audit Log
            </button>
            <button class="fo-btn fo-btn-primary" onclick="foExportCSV()">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                Export CSV
            </button>
        </div>
    </div>

    <!-- API Status Banner -->
    <div class="api-banner" id="fo-api-banner">
        <span id="fo-api-banner-msg"></span>
    </div>

    <!-- Stats -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-strip" style="background:var(--green-main)"></div>
            <div class="stat-icon-wrap" style="background:var(--green-light)">👷</div>
            <div class="stat-label">Total Field Officers</div>
            <div class="stat-value" id="stat-total"><div class="fb-skeleton fb-skeleton-text" style="width:50%; height:28px;"></div></div>
            <div class="stat-note green" id="stat-total-note"><div class="fb-skeleton fb-skeleton-text" style="width:70%; height:12px;"></div></div>
        </div>
        <div class="stat-card">
            <div class="stat-strip" style="background:var(--green-main)"></div>
            <div class="stat-icon-wrap" style="background:var(--green-light)">✅</div>
            <div class="stat-label">Active Officers</div>
            <div class="stat-value" id="stat-active"><div class="fb-skeleton fb-skeleton-text" style="width:50%; height:28px;"></div></div>
            <div class="stat-note green" id="stat-active-note"><div class="fb-skeleton fb-skeleton-text" style="width:70%; height:12px;"></div></div>
        </div>
        <div class="stat-card">
            <div class="stat-strip" style="background:#3B82F6"></div>
            <div class="stat-icon-wrap" style="background:var(--blue-bg)">🏫</div>
            <div class="stat-label">Warehouses Covered</div>
            <div class="stat-value" id="stat-warehouses"><div class="fb-skeleton fb-skeleton-text" style="width:50%; height:28px;"></div></div>
            <div class="stat-note blue" id="stat-warehouse-note"><div class="fb-skeleton fb-skeleton-text" style="width:70%; height:12px;"></div></div>
        </div>
        <div class="stat-card">
            <div class="stat-strip" style="background:var(--amber)"></div>
            <div class="stat-icon-wrap" style="background:var(--amber-bg)">🔍</div>
            <div class="stat-label">Inspections Done</div>
            <div class="stat-value" id="stat-inspections"><div class="fb-skeleton fb-skeleton-text" style="width:50%; height:28px;"></div></div>
            <div class="stat-note amber">This month</div>
        </div>
    </div>

    <!-- Toolbar -->
    <div class="toolbar">
        <div class="search-wrap">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0"/></svg>
            <input type="text" id="fo-search" class="search-input" placeholder="Search by name, region, or warehouse..." oninput="foFilterData()" />
        </div>
        <select id="fo-status-filter" class="filter-select" onchange="foFilterData()">
            <option value="">All Status</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
        </select>
        <select id="fo-region-filter" class="filter-select" onchange="foFilterData()">
            <option value="">All Regions</option>
        </select>
        <button class="fo-btn fo-btn-outline fo-btn-sm" onclick="foClearFilters()">Clear</button>
        <span class="result-count" id="fo-result-count">Showing 0 officers</span>
        <div class="view-toggle">
            <button class="view-btn active" id="btn-card-view" onclick="foSetView('card')">
                <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                Cards
            </button>
            <button class="view-btn" id="btn-table-view" onclick="foSetView('table')">
                <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18M10 4v16M6 4h12a2 2 0 012 2v12a2 2 0 01-2 2H6a2 2 0 01-2-2V6a2 2 0 012-2z"/></svg>
                Table
            </button>
        </div>
    </div>

    <!-- Card View -->
    <div id="fo-card-view">
        <div class="cards-grid" id="fo-cards-container">
            <div class="empty-state" style="grid-column:1/-1"></div>
        </div>
        <div style="display:flex;align-items:center;justify-content:space-between;margin-top:16px">
            <div class="fo-pagination" style="border:none;padding:0">
                <button class="pg-btn" id="c-pg-first" onclick="foGoPage(1)" disabled>&#171;</button>
                <button class="pg-btn" id="c-pg-prev"  onclick="foGoPage(currentFoPage-1)" disabled>&#8249;</button>
                <span id="c-pg-nums"></span>
                <button class="pg-btn" id="c-pg-next"  onclick="foGoPage(currentFoPage+1)" disabled>&#8250;</button>
                <button class="pg-btn" id="c-pg-last"  onclick="foGoPage(totalFoPages)" disabled>&#187;</button>
            </div>
            <span class="pg-total" id="c-pg-total"></span>
        </div>
    </div>

    <!-- Table View -->
    <div id="fo-table-view" style="display:none">
        <div class="table-card">
            <div class="table-head-row">
                <div>
                    <span class="table-title">Field Officer Directory</span>
                    <span class="table-badge" id="t-badge">0 officers</span>
                </div>
                <span style="font-size:12px;color:var(--text-light)">25 records / page</span>
            </div>
            <table class="fo-table">
                <thead>
                    <tr>
                        <th>Officer</th><th>Phone</th><th>Assigned Region</th>
                        <th>Warehouse</th><th>Inspections</th><th>Joined</th>
                        <th>Status</th><th>Actions</th>
                    </tr>
                </thead>
                <tbody id="fo-tbody">
                    <tr><td colspan="8" style="text-align:center;padding:30px;color:var(--text-light)"></td></tr>
                </tbody>
            </table>
            <div class="fo-pagination">
                <button class="pg-btn" id="t-pg-first" onclick="foGoPage(1)" disabled>&#171;</button>
                <button class="pg-btn" id="t-pg-prev"  onclick="foGoPage(currentFoPage-1)" disabled>&#8249;</button>
                <span id="t-pg-nums"></span>
                <button class="pg-btn" id="t-pg-next"  onclick="foGoPage(currentFoPage+1)" disabled>&#8250;</button>
                <button class="pg-btn" id="t-pg-last"  onclick="foGoPage(totalFoPages)" disabled>&#187;</button>
                <select class="pg-select" onchange="foChangePageSize(this.value)">
                    <option value="25">25</option><option value="50">50</option>
                </select>
                <span class="pg-label">items per page</span>
                <span class="pg-total" id="t-pg-total"></span>
            </div>
        </div>
    </div>

</div><!-- /fo-page -->


<!-- MODAL -->
<div class="fo-modal-overlay" id="fo-modal-overlay" onclick="foCloseModalOnOverlay(event)">
    <div class="fo-modal" onclick="event.stopPropagation()">
        <div class="fo-modal-header">
            <span class="fo-modal-title" id="fo-modal-title">Field Officer Profile</span>
            <button class="fo-modal-close" onclick="foCloseModal()">&#215;</button>
        </div>
        <div class="fo-modal-body">

            <div class="profile-hero">
                <div class="profile-hero-avatar" id="m-avatar">FO</div>
                <div style="flex:1;min-width:0">
                    <div class="profile-hero-name" id="m-name">—</div>
                    <div class="profile-hero-meta" id="m-meta">—</div>
                    <div class="profile-hero-status" id="m-status-badge"></div>
                </div>
                <div class="profile-hero-actions">
                    <button class="fo-btn fo-btn-sm fo-btn-activate"   onclick="foChangeStatus(true)">✓ Activate</button>
                    <button class="fo-btn fo-btn-sm fo-btn-deactivate" onclick="foChangeStatus(false)">⊘ Deactivate</button>
                </div>
            </div>

            <div class="perf-grid">
                <div class="perf-card"><div class="perf-val" id="m-perf-inspections">—</div><div class="perf-label">Total Inspections</div></div>
                <div class="perf-card"><div class="perf-val" id="m-perf-passed">—</div><div class="perf-label">Passed</div></div>
                <div class="perf-card"><div class="perf-val" id="m-perf-lots">—</div><div class="perf-label">Lots Managed</div></div>
            </div>

            <div class="fo-tabs">
                <div class="fo-tab-item active" onclick="foSwitchTab(this,'tab-profile')">
                    <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                    Profile
                </div>
                <div class="fo-tab-item" onclick="foSwitchTab(this,'tab-inspections')">
                    <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                    Inspections <span class="tab-badge" id="tab-insp-count">0</span>
                </div>
                <div class="fo-tab-item" onclick="foSwitchTab(this,'tab-slots')">
                    <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    Warehouse Slots <span class="tab-badge" id="tab-slots-count">0</span>
                </div>
            </div>

            <div id="tab-profile">
                <div class="info-cards-grid">
                    <div class="info-card">
                        <div class="info-card-icon-label"><div class="info-card-icon"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg></div><div class="info-card-label">Full Name</div></div>
                        <div class="info-card-val" id="m-fullname">—</div>
                    </div>
                    <div class="info-card">
                        <div class="info-card-icon-label"><div class="info-card-icon"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg></div><div class="info-card-label">Phone</div></div>
                        <div class="info-card-val" id="m-phone">—</div>
                    </div>
                    <div class="info-card">
                        <div class="info-card-icon-label"><div class="info-card-icon"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/></svg></div><div class="info-card-label">Email</div></div>
                        <div class="info-card-val" id="m-email">—</div>
                    </div>
                    <div class="info-card">
                        <div class="info-card-icon-label"><div class="info-card-icon"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg></div><div class="info-card-label">Assigned Region</div></div>
                        <div class="info-card-val" id="m-region">—</div>
                    </div>
                    <div class="info-card">
                        <div class="info-card-icon-label"><div class="info-card-icon"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg></div><div class="info-card-label">Warehouse</div></div>
                        <div class="info-card-val" id="m-warehouse">—</div>
                    </div>
                    <div class="info-card">
                        <div class="info-card-icon-label"><div class="info-card-icon"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg></div><div class="info-card-label">Joined</div></div>
                        <div class="info-card-val" id="m-joined">—</div>
                    </div>
                    <div class="info-card info-card-full">
                        <div class="info-card-icon-label"><div class="info-card-icon"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></div><div class="info-card-label">Account Status</div></div>
                        <div class="info-card-val" id="m-acc-status">—</div>
                    </div>
                </div>
                <div class="info-note">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                    Status changes are logged with Admin ID:1 in <strong style="margin-left:3px">t_notifications</strong>.
                </div>
            </div>

            <div id="tab-inspections" style="display:none">
                <div id="inspections-content"><div class="empty-state"></div></div>
            </div>
            <div id="tab-slots" style="display:none">
                <div id="slots-content"><div class="empty-state"></div></div>
            </div>

        </div>
    </div>
</div>

<div class="fo-toast" id="fo-toast"></div>

@section Scripts {
    <script src="~/js/pages/admin/fieldofficers.js" asp-append-version="true"></script>
}
