@{
    ViewData["Title"] = "Market Intelligence";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
@* Kendo/jQuery/Chart.js are already loaded by `_AdminLayout.cshtml`.
   Keeping a single version prevents flaky dropdown/grid behavior. *@

<link rel="stylesheet" href="~/css/pages/admin/marketintelligence.css" asp-append-version="true" />

<div class="mi-wrap">

    <!-- Header -->
    <div class="mi-header">
        <div>
            <h1>
                <span class="chart-icon">
                    <i class="bi bi-graph-up-arrow" style="font-size:13px; color:white;"></i>
                </span>
                Market Intelligence
            </h1>
            <p>Analyze market trends and discover top demand crops</p>
        </div>
        <span class="src-tag" id="srcTag"></span>
    </div>

    <!-- KPI tiles -->
    <div class="kpi-row">
        <div class="kpi-tile">
            <div class="kpi-label">Crops analyzed</div>
            <div class="kpi-value primary" id="kpiTotal">—</div>
            <div class="kpi-sub">across selected market</div>
        </div>
        <div class="kpi-tile">
            <div class="kpi-label">High demand</div>
            <div class="kpi-value green" id="kpiHigh">—</div>
            <div class="kpi-sub">score &gt; 10%</div>
        </div>
        <div class="kpi-tile">
            <div class="kpi-label">Avg trend score</div>
            <div class="kpi-value amber" id="kpiAvg">—</div>
            <div class="kpi-sub">weighted mean</div>
        </div>
    </div>

    <div class="mi-main-grid">

        <!-- Filters sidebar -->
        <div class="mi-card">
            <div class="mi-card-header">
                <span class="mi-card-title">Filters</span>
            </div>
            <div class="mi-card-body">
                <div class="field-group">
                    <label class="field-label" for="state">State</label>
                    <select id="state" class="mi-select">
                        <option value="">Select state...</option>
                    </select>
                </div>
                <div class="field-group">
                    <label class="field-label" for="market">Market</label>
                    <select id="market" class="mi-select">
                        <option value="">Select market...</option>
                    </select>
                </div>
                <button id="loadBtn" class="load-btn">
                    <i class="bi bi-arrow-repeat"></i>
                    <span id="btnText">Load Insights</span>
                    <div class="mi-spinner" id="spinner"></div>
                </button>
                <p class="mi-err" id="adminErr"></p>
            </div>
        </div>

        <!-- All Crop Predictions -->
        <div class="mi-card">
            <div class="mi-card-header">
                <span class="mi-card-title">All Crop Predictions</span>
                <div class="mi-toolbar">
                    <div class="search-wrap">
                        <i class="bi bi-search search-icon"></i>
                        <input type="text" id="searchInput" class="search-input" placeholder="Search crops...">
                    </div>
                </div>
            </div>

            <!-- Table view -->
            <div id="tableView">
                <div class="empty-state" id="tableEmpty">
                    <i class="bi bi-table"></i>
                    <p>Select state and market, then load insights</p>
                </div>
                <div id="predGrid" style="display:none; border:none; margin-top:10px; font-family:'DM Sans', sans-serif;"></div>
            </div>
        </div>

    </div>

    <!-- Top Demand Crops -->
    <div class="mi-card">
        <div class="mi-card-header">
            <span class="mi-card-title">Top Demand Crops</span>
            <span class="src-tag" id="demandCount"></span>
        </div>
        <div class="empty-state" id="demandEmpty">
            <i class="bi bi-flower2"></i>
            <p>Top demand crops will appear after loading insights</p>
        </div>
        <div class="demand-grid" id="demandGrid" style="display:none;"></div>
    </div>

</div>

@section Scripts {
<script src="~/js/pages/admin/marketintelligence.js" asp-append-version="true"></script>
}
