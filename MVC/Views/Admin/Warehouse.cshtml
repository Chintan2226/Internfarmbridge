@{
    ViewData["Title"] = "Warehouse Management";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}
<style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --green-dark:   #14532D;
            --green-main:   #1B7A3E;
            --green-mid:    #34C759;
            --green-light:  #EAF5EC;
            --amber:        #D97706;
            --amber-bg:     #FFF7ED;
            --amber-border: #FDE68A;
            --red:          #991B1B;
            --red-bg:       #FEF2F2;
            --blue:         #1E40AF;
            --text-primary: #111827;
            --text-muted:   #6B7280;
            --text-light:   #9CA3AF;
            --bg-page:      #F3F4F6;
            --bg-white:     #ffffff;
            --border:       #E5E7EB;
            --radius-sm:    8px;
            --radius-md:    12px;
            --radius-lg:    16px;
            --shadow-sm:    0 1px 3px rgba(0,0,0,0.06);
            --shadow-md:    0 4px 20px rgba(0,0,0,0.1);
        }

        .page { flex: 1; padding: 28px 32px; overflow-y: auto; }
        .page-top { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 24px; }
        .page-title { font-size: 26px; font-weight: 800; margin-bottom: 4px; }
        .page-sub { font-size: 13px; color: var(--text-muted); }

        .btn-primary { background: var(--green-main); color: #fff; padding: 8px 16px; border-radius: var(--radius-sm); font-size: 13px; font-weight: 600; border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; font-family: 'Manrope', sans-serif; transition: background .2s; }
        .btn-primary:hover { background: var(--green-dark); }
        .btn-primary:disabled { opacity: .6; cursor: not-allowed; }

        .stats-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 16px; margin-bottom: 24px; }
        .stat-card { background: var(--bg-white); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 20px; position: relative; overflow: hidden; box-shadow: var(--shadow-sm); }
        .stat-strip { position: absolute; top: 0; left: 0; right: 0; height: 4px; }
        .stat-label { font-size: 13px; font-weight: 500; color: var(--text-muted); margin-bottom: 4px; }
        .stat-value { font-size: 28px; font-weight: 800; }

        .toolbar { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; }
        .search-wrap { position: relative; flex: 1; }
        .search-input { width: 100%; padding: 10px 12px 10px 34px; border: 1px solid var(--border); border-radius: var(--radius-sm); font-size: 13px; outline: none; font-family: 'Manrope', sans-serif; transition: border-color .2s; }
        .search-input:focus { border-color: var(--green-main); }
        .search-wrap svg { position: absolute; left: 11px; top: 50%; transform: translateY(-50%); width: 15px; height: 15px; color: var(--text-light); pointer-events: none; }

        .wh-grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(340px,1fr)); gap: 20px; padding-bottom: 20px; }
        .wh-card { background: var(--bg-white); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 20px; transition: .2s; display: flex; flex-direction: column; gap: 16px; }
        .wh-card.inactive { opacity: .6; filter: grayscale(50%); }
        .wh-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); border-color: var(--green-main); }
        .wh-header { display: flex; justify-content: space-between; align-items: flex-start; }
        .wh-name { font-weight: 800; font-size: 16px; color: var(--green-dark); }
        .wh-id { font-size: 11px; color: var(--text-muted); margin-top: 2px; }
        .wh-status { font-size: 10px; font-weight: 700; padding: 4px 10px; border-radius: 12px; white-space: nowrap; }
        .wh-status.operational   { background: var(--green-light); color: var(--green-main); }
        .wh-status.stopped       { background: var(--red-bg);      color: var(--red); }
        .wh-status.near-capacity { background: var(--red-bg);      color: var(--red); }
        .wh-status.high-load     { background: var(--amber-bg);    color: var(--amber); }

        .wh-body { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; font-size: 13px; background: #F9FAFB; padding: 12px; border-radius: var(--radius-sm); }
        .wh-label { font-size: 10px; font-weight: 700; color: var(--text-light); text-transform: uppercase; margin-bottom: 2px; }
        .wh-val { font-weight: 700; }

        .progress-sec { display: flex; flex-direction: column; gap: 6px; }
        .progress-text { display: flex; justify-content: space-between; font-size: 11px; font-weight: 600; color: var(--text-muted); }
        .progress-bar-bg { width: 100%; height: 6px; background: var(--border); border-radius: 4px; overflow: hidden; }
        .progress-bar-fill { height: 100%; border-radius: 4px; transition: width .5s ease; }

        .card-actions { display: flex; gap: 8px; margin-top: auto; }
        .btn-outline { padding: 8px; border: 1px solid var(--border); background: var(--bg-white); border-radius: var(--radius-sm); font-weight: 600; font-size: 13px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 6px; color: var(--text-primary); transition: .2s; font-family: 'Manrope', sans-serif; }
        .btn-outline:hover { border-color: var(--green-main); color: var(--green-main); }
        .btn-outline:disabled { opacity: .4; cursor: not-allowed; pointer-events: none; }
        .btn-edit { width: 42px; flex-shrink: 0; color: var(--amber); border-color: var(--amber-border); }
        .btn-edit:hover { background: var(--amber-bg); border-color: var(--amber); color: var(--amber); }
        .btn-manage { flex: 1; }

        /* FIXED MODAL CLASSES (Avoids Bootstrap Conflict) */
        .fb-modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.6); display: none; align-items: center; justify-content: center; z-index: 1000; padding: 20px; }
        .fb-modal-overlay.open { display: flex !important; }
        .fb-modal { background: var(--bg-white); border-radius: var(--radius-lg); width: 800px; max-width: 100%; max-height: 90vh; display: flex; flex-direction: column; box-shadow: var(--shadow-md); overflow: hidden; }
        .fb-modal-sm { width: 650px; }
        .fb-modal-header { background: var(--green-main); padding: 16px 24px; display: flex; justify-content: space-between; align-items: center; color: #fff; flex-shrink: 0; }
        .fb-modal-header-title { font-weight: 800; font-size: 18px; }
        .fb-modal-header-sub { font-size: 12px; margin-top: 2px; color: rgba(255,255,255,.75); }
        .fb-modal-body { padding: 24px; overflow-y: auto; flex: 1; }
        .fb-modal-footer { display: flex; justify-content: flex-end; gap: 12px; padding: 16px 24px; border-top: 1px solid var(--border); background: #f9fafb; flex-shrink: 0; }
        .close-btn { cursor: pointer; background: none; border: none; color: #fff; font-size: 24px; font-weight: 300; line-height: 1; padding: 0; }

        .m-stats { display: flex; gap: 12px; margin-bottom: 20px; flex-wrap: wrap; }
        .m-stat-box { flex: 1; min-width: 100px; border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 16px; text-align: center; }
        .m-stat-val { font-size: 20px; font-weight: 800; }
        .m-stat-lbl { font-size: 11px; color: var(--text-muted); font-weight: 600; margin-top: 4px; }
        .tabs { display: flex; border-bottom: 1px solid var(--border); margin-bottom: 20px; }
        .tab-item { padding: 10px 20px; font-size: 13px; font-weight: 700; cursor: pointer; color: var(--text-muted); border-bottom: 2px solid transparent; transition: .2s; user-select: none; }
        .tab-item.active { color: var(--green-main); border-bottom-color: var(--green-main); }
        .stock-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
        .stock-card { border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 16px; }
        .stock-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px; }
        .stock-name { font-weight: 700; font-size: 14px; }
        .stock-cat { font-size: 11px; color: var(--text-muted); }
        .stock-grade { font-size: 12px; font-weight: 700; color: var(--green-main); }
        .stock-grade.grade-b { color: var(--blue); }
        .stock-qty { font-size: 20px; font-weight: 800; color: var(--green-dark); }
        .stock-qty span { font-size: 12px; font-weight: 600; color: var(--text-muted); }
        .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .info-box { border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 14px 16px; }
        .info-box-lbl { font-size: 10px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 4px; }
        .info-box-val { font-size: 14px; font-weight: 700; }

        .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
        .form-col-full { grid-column: 1/-1; }
        .form-label { font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 6px; display: block; }
        .form-input { width: 100%; padding: 10px 12px; border: 1px solid var(--border); border-radius: var(--radius-sm); font-size: 13px; font-family: 'Manrope', sans-serif; outline: none; transition: border-color .2s; background: #fff; }
        .form-input:focus { border-color: var(--green-main); }
        .form-input.warn { border-color: var(--amber); }
        select.form-input { cursor: pointer; }

        .toast { position: fixed; bottom: 24px; right: 24px; background: var(--green-dark); color: #fff; padding: 12px 18px; border-radius: var(--radius-sm); font-size: 13px; font-weight: 600; z-index: 10000; transform: translateY(80px); opacity: 0; transition: .3s; max-width: 320px; pointer-events: none; }
        .toast.show { transform: translateY(0); opacity: 1; }

        .empty-state { grid-column: 1/-1; text-align: center; padding: 60px 20px; color: var(--text-muted); }
        .empty-state svg { width: 48px; height: 48px; opacity: .3; margin: 0 auto 12px; display: block; }
        .empty-state p { font-size: 14px; font-weight: 600; }

        @@media (max-width:700px) {
            .stats-grid { grid-template-columns: repeat(2,1fr); }
            .form-grid { grid-template-columns: 1fr; }
            .form-col-full { grid-column: 1; }
        }
    </style>
<div class="page">
            <div class="page-top">
                <div>
                    <div class="page-title">Warehouse Inventory</div>
                    <div class="page-sub">Monitor capacity, stock levels and regional operations</div>
                </div>
                <button class="btn-primary" onclick="openAddModal()">+ Add New Warehouse</button>
            </div>

            <div class="stats-grid">
                <div class="stat-card"><div class="stat-strip" style="background:var(--green-main)"></div><div class="stat-label">Total Warehouses</div><div class="stat-value" style="color:var(--green-main)" id="kpi-total">—</div></div>
                <div class="stat-card"><div class="stat-strip" style="background:var(--blue)"></div><div class="stat-label">Total Capacity</div><div class="stat-value" style="color:var(--blue)" id="kpi-cap">—</div></div>
                <div class="stat-card"><div class="stat-strip" style="background:var(--amber)"></div><div class="stat-label">Avg. Utilization</div><div class="stat-value" style="color:var(--amber)" id="kpi-util">—</div></div>
                <div class="stat-card"><div class="stat-strip" style="background:var(--red)"></div><div class="stat-label">Near Capacity (&gt;85%)</div><div class="stat-value" style="color:var(--red)" id="kpi-near">—</div></div>
            </div>

            <div class="toolbar">
                <div class="search-wrap">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0"/></svg>
                    <input type="text" id="search-input" class="search-input" placeholder="Search by name, state or district…" oninput="filterData()" />
                </div>
                <select id="filter-status" class="form-input" style="width:160px;" onchange="filterData()">
                    <option value="">All Status</option>
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                </select>
            </div>

            <div id="wh-grid" class="wh-grid">
                <div style="grid-column:1/-1;text-align:center;padding:40px;color:var(--text-muted);">Loading warehouses…</div>
            </div>
</div>

<div class="fb-modal-overlay" id="whModalOverlay" onclick="closeModal('whModalOverlay')">
    <div class="fb-modal" onclick="event.stopPropagation()">
        <div class="fb-modal-header">
            <div>
                <div class="fb-modal-header-title" id="m-title">—</div>
                <div class="fb-modal-header-sub"   id="m-subtitle">—</div>
            </div>
            <button class="close-btn" onclick="closeModal('whModalOverlay')">&times;</button>
        </div>
        <div class="fb-modal-body">
            <div class="m-stats">
                <div class="m-stat-box"><div class="m-stat-val" id="m-cap">—</div><div class="m-stat-lbl">Total Capacity</div></div>
                <div class="m-stat-box"><div class="m-stat-val" id="m-used">—</div><div class="m-stat-lbl">Used</div></div>
                <div class="m-stat-box"><div class="m-stat-val" id="m-avail">—</div><div class="m-stat-lbl">Available</div></div>
                <div class="m-stat-box"><div class="m-stat-val" style="color:var(--amber)" id="m-util">—</div><div class="m-stat-lbl">Utilization</div></div>
            </div>
            <div class="tabs">
                <div class="tab-item active" id="tab-btn-stock" onclick="switchTab('tab-stock',this)">Stock Catalog</div>
                <div class="tab-item"        id="tab-btn-info"  onclick="switchTab('tab-info', this)">Warehouse Info</div>
            </div>
            <div id="tab-stock" class="stock-grid"></div>
            <div id="tab-info"  class="info-grid"  style="display:none;"></div>
        </div>
        <div class="fb-modal-footer">
            <button class="btn-outline" style="padding:8px 20px;" onclick="closeModal('whModalOverlay')">Close</button>
            <button class="btn-primary" id="btnDownloadInv" style="padding:8px 20px;">Download Inventory</button>
        </div>
    </div>
</div>

<div class="fb-modal-overlay" id="addWhModalOverlay" onclick="closeModal('addWhModalOverlay')">
    <div class="fb-modal fb-modal-sm" onclick="event.stopPropagation()">
        <div class="fb-modal-header">
            <span class="fb-modal-header-title">Add New Warehouse</span>
            <button class="close-btn" onclick="closeModal('addWhModalOverlay')">&times;</button>
        </div>
        <form id="addWhForm" onsubmit="submitWarehouse(event,'POST')">
            <div class="fb-modal-body">
                <div class="form-grid">
                    <div class="form-col-full">
                        <label class="form-label">Warehouse Name *</label>
                        <input type="text" class="form-input" name="Name" required placeholder="e.g. Ahmedabad Central Cold Store" />
                    </div>
                    <div>
                        <label class="form-label">State / Region</label>
                        <input type="text" class="form-input" name="Region" placeholder="e.g. Gujarat" />
                    </div>
                    <div>
                        <label class="form-label">District</label>
                        <input type="text" class="form-input" name="Type" placeholder="e.g. Ahmedabad" />
                    </div>
                    <div>
                        <label class="form-label">Daily Capacity (MT) *</label>
                        <input type="number" class="form-input" name="CapacityMt" required min="1" placeholder="e.g. 500" />
                    </div>
                    <div>
                        <label class="form-label">Manager Name</label>
                        <input type="text" class="form-input" name="ManagerName" placeholder="e.g. Ramesh Patel" />
                    </div>
                    <div class="form-col-full">
                        <label class="form-label">Full Address</label>
                        <input type="text" class="form-input" name="LocationAddress" placeholder="Street, City, PIN" />
                    </div>
                    <div>
                        <label class="form-label">Temperature Range</label>
                        <input type="text" class="form-input" name="TemperatureRange" placeholder="e.g. 2°C – 8°C" />
                    </div>
                    <div>
                        <label class="form-label">Certification</label>
                        <input type="text" class="form-input" name="Certification" placeholder="e.g. FSSAI, ISO 9001" />
                    </div>
                </div>
            </div>
            <div class="fb-modal-footer">
                <button type="button" class="btn-outline" style="padding:8px 20px;" onclick="closeModal('addWhModalOverlay')">Cancel</button>
                <button type="submit" class="btn-primary" id="saveWhBtn" style="padding:8px 20px;">Save Warehouse</button>
            </div>
        </form>
    </div>
</div>

<div class="fb-modal-overlay" id="editWhModalOverlay" onclick="closeModal('editWhModalOverlay')">
    <div class="fb-modal fb-modal-sm" onclick="event.stopPropagation()">
        <div class="fb-modal-header">
            <div>
                <span class="fb-modal-header-title">Edit Warehouse</span>
                <div class="fb-modal-header-sub" id="edit-wh-id-label">—</div>
            </div>
            <button class="close-btn" onclick="closeModal('editWhModalOverlay')">&times;</button>
        </div>
        <form id="editWhForm" onsubmit="submitWarehouse(event,'PUT')">
            <input type="hidden" name="Id" id="editWhId" />
            <div class="fb-modal-body">
                <div class="form-grid">
                    <div class="form-col-full">
                        <label class="form-label">Warehouse Name *</label>
                        <input type="text" class="form-input" name="Name" id="eName" required />
                    </div>
                    <div>
                        <label class="form-label">State / Region</label>
                        <input type="text" class="form-input" name="Region" id="eRegion" />
                    </div>
                    <div>
                        <label class="form-label">District</label>
                        <input type="text" class="form-input" name="Type" id="eType" />
                    </div>
                    <div>
                        <label class="form-label">Daily Capacity (MT) *</label>
                        <input type="number" class="form-input" name="CapacityMt" id="eCap" required min="1" />
                    </div>
                    <div>
                        <label class="form-label">Operational Status</label>
                        <select class="form-input warn" name="Status" id="eStatus">
                            <option value="Operational">Operational</option>
                            <option value="Deactivated">Stopped Temporarily</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label">Manager Name</label>
                        <input type="text" class="form-input" name="ManagerName" id="eMgr" />
                    </div>
                    <div>
                        <label class="form-label">Temperature Range</label>
                        <input type="text" class="form-input" name="TemperatureRange" id="eTemp" />
                    </div>
                    <div class="form-col-full">
                        <label class="form-label">Full Address</label>
                        <input type="text" class="form-input" name="LocationAddress" id="eLoc" />
                    </div>
                    <div class="form-col-full">
                        <label class="form-label">Certification</label>
                        <input type="text" class="form-input" name="Certification" id="eCert" />
                    </div>
                </div>
            </div>
            <div class="fb-modal-footer">
                <button type="button" class="btn-outline" style="padding:8px 20px;" onclick="closeModal('editWhModalOverlay')">Cancel</button>
                <button type="submit" class="btn-primary" id="updateWhBtn" style="padding:8px 20px;">Update Warehouse</button>
            </div>
        </form>
    </div>
</div>

<div id="toast" class="toast"></div>

<script>
    (() => {
    const WAREHOUSE_API_BASE = 'http://localhost:5020/api';
    let allWarehouses = [];

    document.addEventListener('DOMContentLoaded', loadData);

    // ── LOAD ──────────────────────────────────────────
    async function loadData() {
        try {
            const [kpiRes, gridRes] = await Promise.all([
                fetch(`${WAREHOUSE_API_BASE}/admin/kpi`),   // ✅ correct KPI url
                fetch(`${WAREHOUSE_API_BASE}/admin/warehouses/all`) // <-- Fixed endpoint name
            ]);

            if (kpiRes.ok) {
                const kpi = (await kpiRes.json()).data;
                document.getElementById('kpi-total').textContent = kpi.totalWarehouses;
                document.getElementById('kpi-cap').textContent   = Number(kpi.totalCapacityMt).toLocaleString('en-IN') + ' MT';
                document.getElementById('kpi-util').textContent  = kpi.averageUtilization + '%';
                document.getElementById('kpi-near').textContent  = kpi.nearCapacityCount;
            }

            if (gridRes.ok) {
                const response = await gridRes.json();

                allWarehouses = (response.data || []).map(w => {
                    const cap = Number(w.capacityMt ?? w.CapacityMt ?? w.totalCapacity ?? w.TotalCapacity ?? 0);
                    const used = Number(w.usedMt ?? w.UsedMt ?? w.used ?? w.Used ?? 0);
                    const avail = Number(w.availableMt ?? w.AvailableMt ?? w.available ?? w.Available ?? 0);
                    const util = Number(w.utilizationPercentage ?? w.UtilizationPercentage ?? w.utilization ?? w.Utilization ?? 0);

                    return {
                        ...w,
                        id: w.id || w.warehouseId || w.Id,
                        name: w.name || w.Name || 'Unknown Warehouse',
                        region: w.region || w.Region || w.state || w.State || '',
                        type: w.type || w.Type || w.district || w.District || '',
                        status: (w.status || w.Status || '').toLowerCase(),
                        capacityMt: cap,
                        usedMt: used,
                        availableMt: avail,
                        utilizationPercentage: util
                    };
                });

                renderGrid(allWarehouses);
            } else {
                renderEmpty('Failed to load warehouses.');
            }
        } catch (err) {
            renderEmpty('API connection error.');
            showToast('API connection error', true);
        }
    }

    // ── RENDER GRID ────────────────────────────────────
    function renderGrid(data) {
        const container = document.getElementById('wh-grid');
        if (!data || !data.length) {
            container.innerHTML = `
                <div class="empty-state">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 10V11"/></svg>
                    <p>No warehouses found.</p>
                </div>`;
            return;
        }

        container.innerHTML = data.map(w => {
            const isInactive = (w.status === 'inactive' || w.status === 'deactivated');
            let statusClass = 'operational', statusText = 'Operational', barColor = 'var(--green-main)';
            if (isInactive)                       { statusClass = 'stopped';       statusText = 'Stopped';       barColor = 'var(--text-muted)'; }
            else if (w.utilizationPercentage > 85){ statusClass = 'near-capacity'; statusText = 'Near Capacity'; barColor = 'var(--red)'; }
            else if (w.utilizationPercentage > 70){ statusClass = 'high-load';     statusText = 'High Load';     barColor = 'var(--amber)'; }

            const util = Math.min(Number(w.utilizationPercentage) || 0, 100);

            return `
            <div class="wh-card ${isInactive ? 'inactive' : ''}">
                <div class="wh-header">
                    <div>
                        <div class="wh-name">${escHtml(w.name)}</div>
                        <div class="wh-id">ID #${w.id}${w.region ? ' · ' + escHtml(w.region) : ''}</div>
                    </div>
                    <span class="wh-status ${statusClass}">${statusText}</span>
                </div>
                <div class="wh-body">
                    <div><div class="wh-label">STATE</div>    <div class="wh-val">${escHtml(w.region) || '—'}</div></div>
                    <div><div class="wh-label">DISTRICT</div> <div class="wh-val">${escHtml(w.type)   || '—'}</div></div>
                    <div><div class="wh-label">CAPACITY</div> <div class="wh-val">${Number(w.capacityMt).toLocaleString('en-IN')} MT</div></div>
                    <div><div class="wh-label">AVAILABLE</div><div class="wh-val">${Number(w.availableMt).toLocaleString('en-IN')} MT</div></div>
                </div>
                <div class="progress-sec">
                    <div class="progress-text">
                        <span>Utilization — ${Number(w.usedMt).toLocaleString('en-IN')} MT used</span>
                        <span style="color:${barColor};font-weight:800;">${w.utilizationPercentage}%</span>
                    </div>
                    <div class="progress-bar-bg">
                        <div class="progress-bar-fill" style="width:${util}%;background:${barColor};"></div>
                    </div>
                </div>
                <div class="card-actions">
                    <button class="btn-outline btn-edit" title="Edit Warehouse" onclick="openEditModal(${w.id})">
                        <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                    </button>
                    <button class="btn-outline btn-manage"
                        ${isInactive ? 'disabled title="Warehouse is stopped"' : `onclick="openManageModal(${w.id})"`}>
                        <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
                        ${isInactive ? 'Stock Locked' : 'Manage Stock'}
                    </button>
                </div>
            </div>`;
        }).join('');
    }

    function renderEmpty(msg) {
        document.getElementById('wh-grid').innerHTML = `<div class="empty-state"><p>${escHtml(msg)}</p></div>`;
    }

    // ── MANAGE STOCK MODAL ─────────────────────────────
    async function openManageModal(id) {
        const w = allWarehouses.find(x => x.id === id);
        if (!w) return;

        document.getElementById('m-title').textContent    = w.name;
        document.getElementById('m-subtitle').textContent = `ID #${w.id}${w.region ? ' · ' + w.region : ''}${w.type ? ' · ' + w.type : ''}`;
        
        // Show temporary loading dots
        document.getElementById('m-cap').textContent   = '...';
        document.getElementById('m-used').textContent  = '...';
        document.getElementById('m-avail').textContent = '...';
        document.getElementById('m-util').textContent  = '...';

        document.getElementById('tab-stock').innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:24px;color:var(--text-muted);">Loading stock…</div>';
        document.getElementById('tab-info').innerHTML  = '<div style="text-align:center;padding:24px;color:var(--text-muted);">Loading info…</div>';
        switchTab('tab-stock', document.getElementById('tab-btn-stock'));
        
        document.getElementById('whModalOverlay').classList.add('open');

        try {
            // FIX: Using the newly created API endpoint for BOTH KPIs and Stock!
            const [invRes, infoRes] = await Promise.all([
                fetch(`${WAREHOUSE_API_BASE}/Admin/${id}/inventory`),
                fetch(`${WAREHOUSE_API_BASE}/Admin/${id}/Info`)
            ]);

            if (invRes.ok) {
                const invData = await invRes.json();
                if (invData.success) {
                    const data = invData.data || invData.Data || {};

                    // 1. Safely map KPI data (Case-Insensitive)
                    const totalCap = data.totalCapacity ?? data.TotalCapacity ?? 0;
                    const usedCap  = data.used ?? data.Used ?? 0;
                    const availCap = data.available ?? data.Available ?? 0;
                    const utilPct  = data.utilization ?? data.Utilization ?? 0;

                    // 2. Bind to the 4 Top KPI Cards inside the Modal
                    document.getElementById('m-cap').textContent   = Number(totalCap).toLocaleString('en-IN') + ' MT';
                    document.getElementById('m-used').textContent  = Number(usedCap).toLocaleString('en-IN') + ' MT';
                    document.getElementById('m-avail').textContent = Number(availCap).toLocaleString('en-IN') + ' MT';
                    document.getElementById('m-util').textContent  = utilPct + '%';

                    // 3. Bind Stock Grid with the new schema mapping
                    const stock = data.stock ?? data.Stock ?? [];
                    
                    // ---> BIND THE PDF DOWNLOAD BUTTON <---
                    document.getElementById('btnDownloadInv').onclick = () => downloadInventoryPDF(w.name, stock);
                    
                    document.getElementById('tab-stock').innerHTML = stock.length
                        ? stock.map(s => {
                            // Extract values mapping safely to new C# names
                            const cropName = s.cropName ?? s.CropName ?? 'Unknown Crop';
                            const variety  = s.variety ?? s.Variety ?? '—';
                            const grade    = s.grade ?? s.Grade ?? '—';
                            const qty      = Number(s.quantity ?? s.Quantity ?? 0);
                            const unit     = s.unit ?? s.Unit ?? 'MT';
                            const dtAdded  = new Date(s.dateAdded ?? s.DateAdded).toLocaleDateString('en-IN');
                            
                            // Calculate percentage manually since it was removed from backend
                            const pct = totalCap > 0 ? Math.min((qty / totalCap) * 100, 100).toFixed(1) : 0;

                            return `
                            <div class="stock-card">
                                <div class="stock-head">
                                    <div><div class="stock-name">${escHtml(cropName)}</div><div class="stock-cat">${escHtml(variety)}</div></div>
                                    <div class="stock-grade ${grade.toUpperCase().startsWith('B') ? 'grade-b' : ''}">${escHtml(grade)}</div>
                                </div>
                                <div class="stock-qty">${qty.toLocaleString('en-IN')} <span>${escHtml(unit)}</span></div>
                                <div class="progress-sec" style="margin-top:12px;">
                                    <div class="progress-bar-bg" style="height:4px;"><div class="progress-bar-fill" style="width:${pct}%;background:var(--green-main);"></div></div>
                                    <div class="progress-text" style="font-weight:500;font-size:10px;">
                                        <span>${pct}% of capacity</span>
                                        <span>Updated: ${dtAdded}</span>
                                    </div>
                                </div>
                            </div>`;
                        }).join('')
                        : '<div style="grid-column:1/-1;text-align:center;color:var(--text-muted);padding:24px;">No active stock in this warehouse.</div>';
                }
            }

            if (infoRes.ok) {
                const infoData = await infoRes.json();
                const info = infoData.data || infoData.Data || {};
                document.getElementById('tab-info').innerHTML = `
                    <div class="info-box"><div class="info-box-lbl">NAME</div>    <div class="info-box-val">${escHtml(info.name || info.Name || '—')}</div></div>
                    <div class="info-box"><div class="info-box-lbl">STATUS</div>  <div class="info-box-val">${(info.isActive ?? info.IsActive) ? '✅ Active' : '🔴 Inactive'}</div></div>
                    <div class="info-box"><div class="info-box-lbl">STATE</div>   <div class="info-box-val">${escHtml(info.state || info.State || '—')}</div></div>
                    <div class="info-box"><div class="info-box-lbl">DISTRICT</div><div class="info-box-val">${escHtml(info.district || info.District || '—')}</div></div>
                    <div class="info-box" style="grid-column:1/-1;"><div class="info-box-lbl">ADDRESS</div><div class="info-box-val">${escHtml(info.location || info.Location || '—')}</div></div>`;
            }
        } catch (e) {
            document.getElementById('tab-stock').innerHTML =
                '<div style="grid-column:1/-1;text-align:center;color:var(--red);padding:24px;">Failed to load data.</div>';
        }
    }

    // ── ADD MODAL ──────────────────────────────────────
    function openAddModal() {
        document.getElementById('addWhForm').reset();
        document.getElementById('addWhModalOverlay').classList.add('open');
    }

    // ── EDIT MODAL ─────────────────────────────────────
    async function openEditModal(id) {
        const w = allWarehouses.find(x => x.id === id);
        if (!w) return;

        // Fill immediately from cached data
        document.getElementById('editWhId').value               = w.id;
        document.getElementById('edit-wh-id-label').textContent = `Warehouse ID #${w.id}`;
        document.getElementById('eName').value   = w.name       || '';
        document.getElementById('eRegion').value = w.region     || '';
        document.getElementById('eType').value   = w.type       || '';
        document.getElementById('eCap').value    = w.capacityMt || '';
        document.getElementById('eStatus').value = (w.status === 'inactive') ? 'Deactivated' : 'Operational';
        document.getElementById('eLoc').value    = w.location;
        document.getElementById('eMgr').value    = w.managerName;
        document.getElementById('eTemp').value   = w.temperature;
        document.getElementById('eCert').value   = w.certification;

        document.getElementById('editWhModalOverlay').classList.add('open');

        // Fetch extra detail fields in background
        try {
            const infoRes = await fetch(`${WAREHOUSE_API_BASE}/admin/${id}/Info`);
            if (infoRes.ok) {
                const info = (await infoRes.json()).data;
                // Guard: only update if modal is still open for the same warehouse
                if (document.getElementById('editWhModalOverlay').classList.contains('open')
                    && String(document.getElementById('editWhId').value) === String(id)) {
                    document.getElementById('eLoc').value  = info.location || info.Location || '';
                    document.getElementById('eMgr').value  = info.managerName || info.ManagerName || '';
                    document.getElementById('eTemp').value = info.temperature || info.Temperature || '';
                    document.getElementById('eCert').value = info.certification || info.Certification || '';
                }
            }
        } catch (e) { /* non-critical, form still works */ }
    }

    // ── CLOSE MODAL ────────────────────────────────────
    function closeModal(modalId) {
        document.getElementById(modalId).classList.remove('open');
    }

    // ── SUBMIT (POST = add, PUT = edit) ────────────────
    async function submitWarehouse(e, method) {
        e.preventDefault();
        const form = e.target;
        const btn  = form.querySelector('button[type="submit"]');
        const orig = btn.textContent;
        btn.disabled = true;
        btn.textContent = 'Saving…';

        // Build clean payload — no FormData leakage
        const raw = Object.fromEntries(new FormData(form).entries());

        const payload = {
            Name:             raw.Name             || '',
            Region:           raw.Region           || null,
            Type:             raw.Type             || null,
            CapacityMt:       parseInt(raw.CapacityMt, 10) || 0,
            LocationAddress:  raw.LocationAddress  || null,
            ManagerName:      raw.ManagerName      || null,
            TemperatureRange: raw.TemperatureRange || null,
            Certification:    raw.Certification    || null,
        };

        // PUT extras
        if (method === 'PUT') {
            payload.Id       = parseInt(raw.Id, 10);
            payload.IsActive = (raw.Status !== 'Deactivated');  // convert to bool
        }

        const url = method === 'POST'
            ? `${WAREHOUSE_API_BASE}/admin/warehouse`
            : `${WAREHOUSE_API_BASE}/admin/warehouse/${payload.Id}`;

        try {
            const res = await fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json' },
                body:    JSON.stringify(payload)
            });

            if (!res.ok) {
                const body = await res.json().catch(() => ({}));
                throw new Error(body.message || `Server error ${res.status}`);
            }

            showToast(`Warehouse ${method === 'POST' ? 'created' : 'updated'} successfully!`);
            closeModal(method === 'POST' ? 'addWhModalOverlay' : 'editWhModalOverlay');
            await loadData();

        } catch (err) {
            showToast(err.message || 'Failed to save. Please try again.', true);
        } finally {
            btn.disabled    = false;
            btn.textContent = orig;
        }
    }

    // ── TAB SWITCH ─────────────────────────────────────
    function switchTab(tabId, element) {
        document.querySelectorAll('.tab-item').forEach(t => t.classList.remove('active'));
        if (element) element.classList.add('active');
        document.getElementById('tab-stock').style.display = tabId === 'tab-stock' ? 'grid' : 'none';
        document.getElementById('tab-info').style.display  = tabId === 'tab-info'  ? 'grid' : 'none';
    }

    // ── FILTER ─────────────────────────────────────────
    function filterData() {
        const q      = document.getElementById('search-input').value.toLowerCase();
        const status = document.getElementById('filter-status').value;
        renderGrid(allWarehouses.filter(w => {
            const txt = (w.name||'').toLowerCase().includes(q)
                     || (w.region||'').toLowerCase().includes(q)
                     || (w.type||'').toLowerCase().includes(q);
            return txt && (!status || w.status === status);
        }));
    }

    // ── GENERATE & DOWNLOAD PDF (Using Kendo UI) ───────────────────────
    function downloadInventoryPDF(warehouseName, stockData) {
        const btn = document.getElementById('btnDownloadInv');
        const origText = btn.textContent;
        btn.textContent = 'Generating PDF...';
        btn.disabled = true;

        // 1. Clean the data to handle Case-Sensitivity safely
        const cleanData = stockData.map(s => ({
            Crop: s.cropName ?? s.CropName ?? 'Unknown',
            Variety: s.variety ?? s.Variety ?? '—',
            Grade: s.grade ?? s.Grade ?? '—',
            Qty: Number(s.quantity ?? s.Quantity ?? 0).toLocaleString('en-IN'),
            Unit: s.unit ?? s.Unit ?? 'MT',
            DateAdded: new Date(s.dateAdded ?? s.DateAdded).toLocaleDateString('en-IN')
        }));

        // 2. Create the hidden div ON-SCREEN so Chrome actually calculates the text!
        const tempDiv = document.createElement('div');
        tempDiv.style.position = 'absolute';
        tempDiv.style.top = '0px';
        tempDiv.style.left = '0px';
        tempDiv.style.width = '800px';
        
        // CRITICAL FIX: Make it technically on-screen but invisible to the user
        tempDiv.style.opacity = '0.01'; 
        tempDiv.style.zIndex = '-1000'; 
        tempDiv.style.pointerEvents = 'none'; 
        
        // Force standard black text so Kendo doesn't lose the font
        tempDiv.style.color = '#000000';
        tempDiv.style.fontFamily = 'Helvetica, Arial, sans-serif';
        document.body.appendChild(tempDiv);

        // 3. Initialize the Grid normally
        const pdfGrid = $(tempDiv).kendoGrid({
            dataSource: { data: cleanData },
            pdf: {
                allPages: true,
                avoidLinks: true,
                paperSize: "A4",
                margin: { top: "2cm", left: "1cm", right: "1cm", bottom: "1cm" },
                landscape: false,
                repeatHeaders: true,
                fileName: warehouseName.replace(/\s+/g, '_') + "_Inventory.pdf",
                title: warehouseName + " - Active Inventory Report"
            },
            columns: [
                { field: "Crop", title: "Crop Name", width: "120px" },
                { field: "Variety", title: "Variety", width: "120px" },
                { field: "Grade", title: "Grade", width: "80px" },
                { field: "Qty", title: "Quantity", width: "100px" },
                { field: "Unit", title: "Unit", width: "70px" },
                { field: "DateAdded", title: "Date Stored", width: "100px" }
            ]
        }).data("kendoGrid");

        // 4. Give Chrome 300ms to finish painting the text before taking the PDF snapshot!
        setTimeout(() => {
            pdfGrid.saveAsPDF().done(function() {
                // Clean up memory after download completes
                pdfGrid.destroy();
                tempDiv.remove();
                
                // Restore the UI button
                btn.textContent = origText;
                btn.disabled = false;
                showToast("PDF downloaded successfully!");
            });
        }, 300); 
    }

    // ── HELPERS ────────────────────────────────────────
    function escHtml(s) {
        if (s === null || s === undefined) return '';
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
    }

    function showToast(msg, isError = false) {
        const t = document.getElementById('toast');
        t.textContent      = msg;
        t.style.background = isError ? '#991B1B' : '#14532D';
        t.classList.add('show');
        setTimeout(() => t.classList.remove('show'), 3500);
    }

    window.openManageModal = openManageModal;
    window.openAddModal = openAddModal;
    window.openEditModal = openEditModal;
    window.closeModal = closeModal;
    window.submitWarehouse = submitWarehouse;
    window.switchTab = switchTab;
    window.filterData = filterData;
    })();
</script>
