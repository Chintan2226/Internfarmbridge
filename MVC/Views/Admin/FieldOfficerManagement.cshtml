@{
    ViewBag.Title = "Field Officer Management";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="~/css/pages/admin/fieldofficermanagement.css" asp-append-version="true" />

<div class="dashboard-header mb-4 p-4 bg-white shadow-sm rounded-4 border-0">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h4 class="m-0 text-dark fw-bold tracking-tight">Field Officer Management</h4>
            <p class="text-muted small mb-0 mt-1">Monitor performance and manage field staff access levels.</p>
        </div>
        <button class="btn btn-success px-4 py-2 fw-bold shadow-sm rounded-3 d-flex align-items-center gap-2" onclick="openFOModal()">
            <lord-icon src="https://cdn.lordicon.com/evwvpsbg.json" trigger="hover" colors="primary:#ffffff" style="width:20px;height:20px"></lord-icon>
            Create FO Account
        </button>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div id="foGrid"></div>
    </div>
</div>

<div class="modal fade" id="foModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-bold text-dark">New Field Officer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="foForm" class="row g-3">
                    <div class="col-12">
                        <label class="form-label small fw-bold text-muted">FULL NAME</label>
                        <input type="text" id="fo_name" class="form-control rounded-3 py-2" required placeholder="Enter officer name">
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-bold text-muted">EMAIL (USERNAME)</label>
                        <input type="email" id="fo_email" class="form-control rounded-3 py-2" required placeholder="name@farmbridge.in">
                        <div class="form-text x-small text-info mt-1">
                            <i class="fa fa-info-circle me-1"></i> A secure password will be auto-generated.
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted">PHONE NUMBER</label>
                        <input type="text" id="fo_phone" class="form-control rounded-3 py-2" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted">WAREHOUSE</label>
                        <select id="fo_warehouse" class="form-select rounded-3 py-2" required></select>
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-bold text-muted">ASSIGNED REGION</label>
                        <input type="text" id="fo_region" class="form-control rounded-3 py-2" required placeholder="e.g., Bhavnagar South">
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 p-4 pt-0">
                <button class="btn btn-light rounded-3 px-4" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-success rounded-3 px-4 fw-bold" onclick="saveFO()">Generate Account</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/admin/fieldofficer_management.js" asp-append-version="true"></script>
}
