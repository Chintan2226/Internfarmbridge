@{
    ViewData["Title"] = "Vendor Management";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="~/css/pages/admin/vendor.css" asp-append-version="true" />

<div class="page">
    <div class="page-title">Vendor Management</div>
    <div class="page-sub">Monitor and approve platform vendors</div>

    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-strip" style="background:var(--green-main)"></div>
            <div class="stat-label">Total Vendors</div>
            <div class="stat-value" id="stat-total"><div class="fb-skeleton fb-skeleton-text" style="width:60%; height:24px;"></div></div>
        </div>
        <div class="stat-card">
            <div class="stat-strip" style="background:var(--green-main)"></div>
            <div class="stat-label">Total Volume</div>
            <div class="stat-value" id="stat-value"><div class="fb-skeleton fb-skeleton-text" style="width:60%; height:24px;"></div></div>
        </div>
        <div class="stat-card">
            <div class="stat-strip" style="background:#3B82F6"></div>
            <div class="stat-label">Orders Placed</div>
            <div class="stat-value" id="stat-orders"><div class="fb-skeleton fb-skeleton-text" style="width:60%; height:24px;"></div></div>
        </div>
        <div class="stat-card">
            <div class="stat-strip" style="background:var(--amber)"></div>
            <div class="stat-label">Fulfillment</div>
            <div class="stat-value" id="stat-rate"><div class="fb-skeleton fb-skeleton-text" style="width:60%; height:24px;"></div></div>
        </div>
    </div>

    <div id="vendor-grid" class="vendor-grid">
        <div style="grid-column:1/-1; text-align:center; padding:40px; color:var(--text-muted);">Loading vendors...</div>
    </div>
</div>

<!-- Vendor Detail Modal (Restored) -->
<div class="modal-overlay" id="vendorModalOverlay" onclick="closeModal()">
    <div class="modal" onclick="event.stopPropagation()">
        <div class="modal-header">
            <span style="font-weight:700;">Vendor Details</span>
            <button class="close-btn" onclick="closeModal()">&times;</button>
        </div>
        <div class="modal-body" id="modalBody"></div>
    </div>
</div>

<div class="toast" id="toast">
    <span id="toastIcon"></span> <span id="toastMsg"></span>
</div>

<script src="~/js/pages/admin/vendor.js" asp-append-version="true"></script>
