@model List<GoogleSearchViewModel>
@{
    ViewData["Title"] = "Agricultural News & Market Updates";
    ViewData["UserRole"] = "Admin";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="~/css/pages/admin/news.css" asp-append-version="true" />

<div class="news-page">
    <div class="pg-header">
        <div class="pg-header-content">
            <h1 class="pg-title">Agricultural News & Market Updates</h1>
            <p class="pg-subtitle">Stay informed with the latest trends, government policies, and market intelligence curated from global sources.</p>
        </div>
        
        <div class="search-wrapper">
            <form method="get" class="search-form">
                <input type="text" name="query" class="search-input" placeholder="Search topics (e.g., 'Wheat price India', 'MSP updates')..." value="@Context.Request.Query["query"]" />
                <button type="submit" class="search-btn">
                    <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                    </svg>
                    Search
                </button>
            </form>
        </div>
    </div>

    <div class="news-grid">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <a href="@item.Link" target="_blank" class="news-card">
                    <div class="news-img-wrapper">
                        @if (!string.IsNullOrEmpty(item.Source))
                        {
                            <span class="news-source-badge">@item.Source</span>
                        }
                        
                        @if (!string.IsNullOrEmpty(item.Thumbnail))
                        {
                            <img src="@item.Thumbnail" alt="News Thumbnail" class="news-img-inner" loading="lazy" />
                        }
                        else
                        {
                            <div class="news-no-img">
                                <svg width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                                </svg>
                            </div>
                        }
                    </div>
                    
                    <div class="news-content">
                        <h3 class="news-title">@Html.Raw(item.Title)</h3>
                        <div class="news-snippet">@Html.Raw(item.Snippet)</div>
                        
                        <div class="news-footer">
                            <span class="read-more">
                                Read Full Article 
                                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                                </svg>
                            </span>
                        </div>
                    </div>
                </a>
            }
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <svg width="40" height="40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                    </svg>
                </div>
                <h3 style="font-family: var(--sans); color: var(--ink); margin-bottom: 8px;">No news found</h3>
                <p style="color: var(--muted);">Try adjusting your search terms to find the latest updates.</p>
            </div>
        }
    </div>
</div>