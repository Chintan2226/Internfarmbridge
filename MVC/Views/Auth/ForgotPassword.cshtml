@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FarmBridge | Reset Your Password</title>
    <meta name="description" content="Reset your FarmBridge account password securely via email OTP." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=Baloo+2:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel='stylesheet' href='https://cdn-uicons.flaticon.com/2.6.0/uicons-regular-rounded/css/uicons-regular-rounded.css' />
    <link rel="stylesheet" href="~/lib/kendo/kendo.default-v2.min.css" />
    <link rel="stylesheet" href="~/css/layouts/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/auth/ForgotPassword.css" asp-append-version="true" />
</head>
<body class="fp-body">

    <!-- Language switcher -->
    <div class="fp-page-lang">
        <button class="fp-lang-btn" id="fpLangBtn" title="Change Language">
            <i class="fi fi-rr-globe"></i>
        </button>
        <div class="fp-lang-dropdown" id="fpLangMenu">
            <button onclick="changeLanguage('en')">🇬🇧 English</button>
            <button onclick="changeLanguage('hi')">🇮🇳 हिन्दी</button>
            <button onclick="changeLanguage('gu')">🇮🇳 ગુજરાતી</button>
        </div>
    </div>

    <div class="fp-card">
        <div class="fp-accent-bar"></div>

        <a href="/" class="fp-logo">
            <img src="/Logo/Logo_Without_Bg.png" alt="FarmBridge" class="fp-logo-img" onerror="this.style.display='none'" />
            <span class="fp-logo-text">Farm<span>Bridge</span></span>
        </a>

        <!-- Step indicator -->
        <div class="fp-steps-indicator">
            <div class="fp-si-step active" id="si1">
                <div class="fp-si-dot"><span>1</span></div>
                <span class="fp-si-label" data-i18n="fp_label_email">Email</span>
            </div>
            <div class="fp-si-line" id="siLine1"></div>
            <div class="fp-si-step" id="si2">
                <div class="fp-si-dot"><span>2</span></div>
                <span class="fp-si-label">OTP</span>
            </div>
            <div class="fp-si-line" id="siLine2"></div>
            <div class="fp-si-step" id="si3">
                <div class="fp-si-dot"><span>3</span></div>
                <span class="fp-si-label" data-i18n="fp_title_password">Password</span>
            </div>
        </div>

        <hr class="fp-divider" />

        <!-- Step 1: Email -->
        <div class="fp-step fp-step-active" id="step1">
            <h1 class="fp-title" data-i18n="fp_title_email">Forgot Password?</h1>
            <p class="fp-subtitle" data-i18n="fp_sub_email">Enter your registered email. We'll send a 6-digit code.</p>

            <div class="fp-field">
                <label for="txtEmail" data-i18n="fp_label_email">Email Address</label>
                <input id="txtEmail" type="email" placeholder="e.g. farmer@example.com" data-i18n-placeholder="fp_ph_email" />
                <span class="fp-hint" data-i18n="fp_hint_email">We'll send a verification code to this email</span>
                <span class="fp-error" id="emailError"></span>
            </div>

            <button id="btnSendOtp" type="button" data-i18n="fp_btn_send_otp">Send OTP</button>
        </div>

        <!-- Step 2: OTP -->
        <div class="fp-step" id="step2">
            <h1 class="fp-title" data-i18n="fp_title_otp">Verify OTP</h1>
            <p class="fp-subtitle"><span data-i18n="fp_sub_otp">Enter the 6-digit code sent to</span> <strong id="emailDisplay"></strong></p>

            <div class="fp-field">
                <label data-i18n="fp_label_otp">Verification Code</label>
                <div class="fp-otp-boxes">
                    <input type="text" maxlength="1" class="fp-otp-input" data-index="0" inputmode="numeric" autocomplete="one-time-code" />
                    <input type="text" maxlength="1" class="fp-otp-input" data-index="1" inputmode="numeric" />
                    <input type="text" maxlength="1" class="fp-otp-input" data-index="2" inputmode="numeric" />
                    <span class="fp-otp-dash">–</span>
                    <input type="text" maxlength="1" class="fp-otp-input" data-index="3" inputmode="numeric" />
                    <input type="text" maxlength="1" class="fp-otp-input" data-index="4" inputmode="numeric" />
                    <input type="text" maxlength="1" class="fp-otp-input" data-index="5" inputmode="numeric" />
                </div>
                <span class="fp-error" id="otpError"></span>
            </div>

            <div class="fp-otp-meta">
                <div class="fp-timer">
                    <i class="fi fi-rr-clock"></i>
                    <span data-i18n="fp_otp_expires">Code expires in</span>&nbsp;<strong id="otpTimer">05:00</strong>
                </div>
                <button id="btnResendOtp" type="button" class="fp-link-btn" disabled>
                    <span data-i18n="fp_btn_resend">Resend Code</span>
                </button>
            </div>

            <div class="fp-actions">
                <button id="btnBackStep1" type="button" class="fp-btn-outline" data-i18n="fp_btn_back">Back</button>
                <button id="btnVerifyOtp" type="button" class="fp-btn-primary" data-i18n="fp_btn_verify">Verify Code</button>
            </div>
        </div>

        <!-- Step 3: New Password -->
        <div class="fp-step" id="step3">
            <h1 class="fp-title" data-i18n="fp_title_password">Set New Password</h1>
            <p class="fp-subtitle" data-i18n="fp_sub_password">Create a strong password for your account.</p>

            <div class="fp-field">
                <label for="txtNewPassword" data-i18n="fp_label_new_pw">New Password</label>
                <div class="fp-input-icon-wrap">
                    <input id="txtNewPassword" type="password" placeholder="Enter new password" data-i18n-placeholder="fp_ph_new_pw" />
                    <button type="button" class="fp-eye-btn" id="toggleNewPw"><i class="fi fi-rr-eye"></i></button>
                </div>
                <div class="fp-strength-row">
                    <div class="fp-strength-bars">
                        <div class="fp-sbar" id="bar1"></div>
                        <div class="fp-sbar" id="bar2"></div>
                        <div class="fp-sbar" id="bar3"></div>
                        <div class="fp-sbar" id="bar4"></div>
                    </div>
                    <span class="fp-strength-text" id="pwStrengthLabel"></span>
                </div>
                <div class="fp-rules">
                    <span class="fp-rule" id="ruleLength"><i class="fi fi-rr-circle"></i> <span data-i18n="fp_rule_length">Min 8 chars</span></span>
                    <span class="fp-rule" id="ruleLetter"><i class="fi fi-rr-circle"></i> <span data-i18n="fp_rule_letter">Letters (a-z)</span></span>
                    <span class="fp-rule" id="ruleNumber"><i class="fi fi-rr-circle"></i> <span data-i18n="fp_rule_number">Number (0-9)</span></span>
                    <span class="fp-rule" id="ruleSpecial"><i class="fi fi-rr-circle"></i> <span data-i18n="fp_rule_special">Special (!@@#$)</span></span>
                </div>
                <span class="fp-error" id="newPwError"></span>
            </div>

            <div class="fp-field">
                <label for="txtConfirmPassword" data-i18n="fp_label_confirm_pw">Confirm Password</label>
                <div class="fp-input-icon-wrap">
                    <input id="txtConfirmPassword" type="password" placeholder="Re-enter password" data-i18n-placeholder="fp_ph_confirm_pw" />
                    <button type="button" class="fp-eye-btn" id="toggleConfirmPw"><i class="fi fi-rr-eye"></i></button>
                </div>
                <span class="fp-error" id="confirmPwError"></span>
            </div>

            <div class="fp-actions">
                <button id="btnBackStep2" type="button" class="fp-btn-outline" data-i18n="fp_btn_back">Back</button>
                <button id="btnResetPassword" type="button" class="fp-btn-primary" data-i18n="fp_btn_reset">Reset Password</button>
            </div>
        </div>

        <!-- Loader -->
        <div class="fp-loader-overlay" id="fpLoaderOverlay" style="display:none;">
            <div id="fpLoader"></div>
            <span data-i18n="fp_please_wait">Please wait...</span>
        </div>

        <a href="/" class="fp-footer-link">
            <i class="fi fi-rr-arrow-left"></i> <span data-i18n="fp_back_login">Back to Login</span>
        </a>
    </div>

    <span id="fpNotification"></span>
    <div id="fpSuccessDialog"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/kendo/kendo.all.min.js"></script>
    <script src="~/js/layouts/site.js" asp-append-version="true"></script>
    <script src="~/js/pages/auth/ForgotPassword.js" asp-append-version="true"></script>
</body>
</html>

