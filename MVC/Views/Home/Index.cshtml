@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FarmBridge | Kisan se Vendor tak — Seedha, Saaf, Sacha</title>
    <link rel="icon" type="image/png" href="~/Logo/Logo_Without_Bg.png" />

    <!-- Meta Tags -->
    <meta name="description" content="Centralized procurement platform connecting farmers and vendors in India." />
    <meta name="keywords" content="Agriculture, India, Farmers, Vendors, Supply Chain, AI, Procurement" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=Baloo+2:wght@400;600;700;800&display=swap"
    rel="stylesheet" />

    <!-- Icons -->
    <link rel='stylesheet'
          href='https://cdn-uicons.flaticon.com/2.6.0/uicons-regular-rounded/css/uicons-regular-rounded.css' />
    <link rel='stylesheet' href='https://cdn-uicons.flaticon.com/2.6.0/uicons-brands/css/uicons-brands.css' />

    <!-- Animation -->
    <script type="module" src="https://unpkg.com/@@lottiefiles/dotlottie-wc@latest/dist/dotlottie-wc.js"></script>

    <!-- CSS -->
    <link rel="stylesheet" href="~/css/layouts/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/home/landing.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/home/intro.css" asp-append-version="true" />
</head>

<body class="bg-surface selection:bg-primary-fixed selection:text-on-primary-fixed">
    <!-- Intro Animation Overlay -->
    <div id="intro-overlay"></div>
    <dotlottie-wc id="intro-logo" src="https://lottie.host/8d264ca0-2216-4373-8c7d-bf2a7f686a0e/iwSvPfj0NA.lottie"
                  autoplay></dotlottie-wc>

    <!-- Animated background -->
    <div class="page-bg" aria-hidden="true">
        <div class="bg-orb bg-orb-1"></div>
        <div class="bg-orb bg-orb-2"></div>
        <div class="bg-orb bg-orb-3"></div>
        <div class="bg-orb bg-orb-4"></div>
    </div>

    <!-- Navbar -->
    <nav class="navbar" id="navbar">
        <div class="nav-inner">
            <a href="#" class="nav-logo">
                <img id="nav-logo-target" src="/Logo/Logo_Without_Bg.png" alt="FarmBridge"
                     onerror="this.style.display='none'" />
                <span class="nav-logo-text">Farm<span>Bridge</span></span>
            </a>

            <div class="nav-links">
                <div class="nav-indicator"></div>
                <a href="#" class="nav-link active">
                    <i class="fi fi-rr-home"></i>
                    <span data-i18n="nav_home">Home</span>
                </a>
                <a href="#how-it-works" class="nav-link">
                    <i class="fi fi-rr-settings"></i>
                    <span data-i18n="nav_how">How It Works</span>
                </a>
                <a href="#modules" class="nav-link">
                    <i class="fi fi-rr-users"></i>
                    <span data-i18n="nav_who">Who It's For</span>
                </a>
                <a href="#ai-features" class="nav-link">
                    <i class="fi fi-rr-microchip"></i>
                    <span data-i18n="nav_ai">AI Features</span>
                </a>
                <a href="#why" class="nav-link">
                    <i class="fi fi-rr-star"></i>
                    <span data-i18n="nav_why">Why FarmBridge</span>
                </a>
            </div>

            <div class="nav-actions">
                <div class="lang-selector">
                    <button class="btn-lang" onclick="toggleLangMenu(event)" id="langBtn" title="Change Language">
                        <i class="fi fi-rr-globe"></i>
                    </button>
                    <div class="lang-dropdown" id="langMenu">
                        <button onclick="changeLanguage('en')">English</button>
                        <button onclick="changeLanguage('hi')">हिन्दी (Hindi)</button>
                        <button onclick="changeLanguage('gu')">ગુજરાતી (Gujarati)</button>
                    </div>
                </div>
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <span
                        style="font-family: var(--font-display); font-weight:600; color:var(--text-primary); white-space:nowrap;">Dashboard
                        (@Context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)</span>
                        <a href="/Account/Logout" class="btn-ghost" data-i18n="logout">Logout</a>
                    }
                else
                    {
                        <a href="#cta" class="btn-ghost" data-i18n="btn_login">Login</a>
                        <a href="#footer" class="btn-primary" data-i18n="btn_contact">Contact Us</a>
                    }
                </div>

                <button class="hamburger" onclick="toggleMenu()" aria-label="Menu">
                    <i class="fi fi-rr-menu-burger" style="color:var(--text-secondary);font-size:24px;"></i>
                </button>
            </div>
        </nav>

        <!-- Mobile Menu -->
        <div class="mobile-menu" id="mobileMenu">
            <a href="#" class="mobile-nav-link active" onclick="toggleMenu()">
                <i class="fi fi-rr-home"></i>
                <span data-i18n="nav_home">Home</span>
            </a>
            <a href="#how-it-works" class="mobile-nav-link" onclick="toggleMenu()">
                <i class="fi fi-rr-settings"></i>
                <span data-i18n="nav_how">How It Works</span>
            </a>
            <a href="#modules" class="mobile-nav-link" onclick="toggleMenu()">
                <i class="fi fi-rr-users"></i>
                <span data-i18n="nav_who">Who It's For</span>
            </a>
            <a href="#ai-features" class="mobile-nav-link" onclick="toggleMenu()">
                <i class="fi fi-rr-microchip"></i>
                <span data-i18n="nav_ai">AI Features</span>
            </a>
            <a href="#why" class="mobile-nav-link" onclick="toggleMenu()">
                <i class="fi fi-rr-star"></i>
                <span data-i18n="nav_why">Why FarmBridge</span>
            </a>
            <div class="mobile-lang-row">
                <i class="fi fi-rr-globe"></i>
                <select onchange="changeLanguage(this.value); toggleMenu()" id="mobileLangSelect">
                    <option value="en">English</option>
                    <option value="hi">हिन्दी (Hindi)</option>
                    <option value="gu">ગુજરાતી (Gujarati)</option>
                </select>
            </div>
        </div>

        <!-- Hero -->
        <section id="hero">
            <div class="hero-slider-bg">
                <div class="hero-slider">
                    <img class="active" src="~/images/sliders/hero_1.png" alt="Indian farmers working in lush green fields"
                         loading="eager" style="object-position: center 30%;" />
                    <img src="https://images.unsplash.com/photo-1499529112087-3cb3b73cec95?w=1920&q=80&fm=jpg"
                         alt="Golden wheat field at sunset" loading="lazy" />
                    <img src="https://images.unsplash.com/photo-1464226184884-fa280b87c399?w=1920&q=80&fm=jpg"
                         alt="Lush green terraced farmland" loading="lazy" />
                    <img src="https://images.unsplash.com/photo-1625246333195-78d9c38ad449?w=1920&q=80&fm=jpg"
                         alt="Rice paddy field at golden hour" loading="lazy" />
                    <img src="~/images/sliders/hero_5.png" alt="Indian rural agriculture and farmer landscape"
                         loading="lazy" style="object-position: center;" />

                </div>
                <div class="hero-image-overlay"></div>
            </div>

            <div class="container hero-content-container">
                <div class="hero-content-inner">
                    <div class="hero-eyebrow">
                        <span class="hero-hindi-tag" data-i18n="hero_hindi_tag"><i class="fi fi-rr-leaf"></i> किसान से वेंडर
                            तक — सीधा</span>
                            <div class="dot"></div>
                            <span class="section-badge badge-green">
                                <i class="fi fi-rr-badge-check hero-icon-small"></i>
                                <span data-i18n="hero_badge">India's Trusted Agri B2B</span>
                            </span>
                        </div>

                        <h1 class="hero-h1" id="hero-title">
                            <span id="typewriter-line1" class="typewriter-line"></span><br /><span id="typewriter-line2"
                                                                                                   class="typewriter-line accent-green"></span><span class="typewriter-cursor">|</span>
                        </h1>

                        <p class="hero-sub" data-i18n="hero_sub">
                            Transforming India's agricultural supply chain with AI-driven procurement.<br />
                            One platform connecting farmers, vendors, and field officers seamlessly.
                        </p>

                        <div class="hero-ctas">
                            <a href="#cta" class="btn-hero-primary">
                                <i class="fi fi-rr-rocket"></i>
                                <span data-i18n="btn_start">अभी शुरू करें</span>
                            </a>

                        </div>

                        <div class="hero-trust">
                            <div class="trust-avatars">
                                <div class="trust-avatar">R</div>
                                <div class="trust-avatar trust-avatar-green">M</div>
                                <div class="trust-avatar trust-avatar-blue">P</div>
                                <div class="trust-avatar trust-avatar-saffron">A</div>
                            </div>
                            <div class="trust-text" data-i18n="hero_trust"><strong>12,000+</strong> farmers already onboarded
                            </div>
                            <div class="trust-divider"></div>
                            <div class="trust-item">
                                <i class="fi fi-rr-shield-check"></i>
                                <span data-i18n="hero_quality">Quality Assured</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Scroll Indicator like the reference image -->
                <div class="scroll-indicator">
                    <div class="mouse">
                        <div class="wheel"></div>
                    </div>
                    <span class="scroll-text">SCROLL TO EXPLORE</span>
                </div>
            </section>

            <!-- Stats -->
            <section id="stats">
                <div class="container">
                    <div class="stats-band reveal">
                        <div class="stat-item">
                            <div class="stat-num">12<span class="stat-unit">k+</span></div>
                            <div class="stat-label" data-i18n="stat_farmers">Registered Farmers</div>
                            <div class="stat-sublabel" data-i18n="stat_farmers_hi">पंजीकृत किसान</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-num">98<span class="stat-unit">%</span></div>
                            <div class="stat-label" data-i18n="stat_delivery">On-time Delivery</div>
                            <div class="stat-sublabel" data-i18n="stat_delivery_hi">समय पर डिलीवरी</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-num">₹4<span class="stat-unit">Cr+</span></div>
                            <div class="stat-label" data-i18n="stat_trans">Transactions Processed</div>
                            <div class="stat-sublabel" data-i18n="stat_trans_hi">प्रोसेस किए गए लेनदेन</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-num">18<span class="stat-unit">+</span></div>
                            <div class="stat-label" data-i18n="stat_states">States Connected</div>
                            <div class="stat-sublabel" data-i18n="stat_states_hi">जुड़े हुए राज्य</div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- How It Works -->
            <section id="how-it-works">
                <div class="container">
                    <div class="section-header reveal">
                        <span class="section-badge badge-green" data-i18n="how_badge">Process</span>
                        <h2 class="section-title" data-i18n="how_title">Simple, Fast, Transparent<br />Supply Chain Flow</h2>
                        <p class="section-sub" data-i18n="how_sub">From harvest to delivery — every step is tracked, verified,
                            and
                            transparent. Ek hi platform, poora supply chain.</p>
                        </div>

                        <div style="position:relative;">
                            <div class="how-connector"></div>
                            <div class="how-grid">
                                <div class="how-step reveal" style="transition-delay:0.1s">
                                    <div class="how-step-num">
                                        <i class="fi fi-rr-leaf how-step-icon"></i>
                                    </div>
                                    <div class="how-step-title" data-i18n="step1_title">Farmer Lists Produce</div>
                                    <div class="how-step-desc" data-i18n="step1_desc">Farmers upload crop details, quantities &
                                        harvest dates
                                        via web dashboard. AI predicts best price.</div>
                                        <span class="how-step-badge"><span data-i18n="step_n">Step</span> 1</span>
                                    </div>
                                    <div class="how-step reveal" style="transition-delay:0.3s">
                                        <div class="how-step-num">
                                            <i class="fi fi-rr-list-check how-step-icon"></i>
                                        </div>
                                        <div class="how-step-title" data-i18n="step2_title">Warehouse Verification</div>
                                        <div class="how-step-desc" data-i18n="step2_desc">Farmers deliver produce to the nearest warehouse. Field Officers verify quality and generate digital grading reports on-site.</div>
                                            <span class="how-step-badge"><span data-i18n="step_n">Step</span> 2</span>
                                        </div>
                                        <div class="how-step reveal" style="transition-delay:0.2s">
                                            <div class="how-step-num">
                                                <i class="fi fi-rr-shopping-cart how-step-icon"></i>
                                            </div>
                                            <div class="how-step-title" data-i18n="step3_title">Vendor Places Order</div>
                                            <div class="how-step-desc" data-i18n="step3_desc">Vendors browse the live catalog, add to cart,
                                                and place
                                                bulk purchase orders with transparent pricing.</div>
                                                <span class="how-step-badge"><span data-i18n="step_n">Step</span> 3</span>
                                            </div>
                                            <div class="how-step reveal" style="transition-delay:0.4s">
                                                <div class="how-step-num">
                                                    <i class="fi fi-rr-truck-side how-step-icon"></i>
                                                </div>
                                                <div class="how-step-title" data-i18n="step4_title">Deliver & Pay</div>
                                                <div class="how-step-desc" data-i18n="step4_desc">Logistics picks up, real-time tracking begins.
                                                    Payment is
                                                    auto-released to platform upon delivery confirmation.</div>
                                                    <span class="how-step-badge"><span data-i18n="step_n">Step</span> 4</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </section>

                                <!-- Modules -->
                                <section id="modules">
                                    <div class="container">
                                        <div class="section-header reveal">
                                            <span class="section-badge badge-saffron" data-i18n="mod_badge">Platform Modules</span>
                                            <h2 class="section-title" data-i18n="mod_title">Built for Everyone<br />in the Supply Chain</h2>
                                            <p class="section-sub" data-i18n="mod_sub">4 dedicated modules — each tailored to the specific needs of
                                                every
                                                stakeholder in India's agricultural ecosystem.</p>
                                            </div>

                                            <div class="modules-grid">
                                                <!-- Farmer -->
                                                <div class="module-card farmer reveal">
                                                    <div class="module-icon-wrap">
                                                        <i class="fi fi-rr-tractor" style="font-size: 32px;"></i>
                                                    </div>
                                                    <div class="module-title" data-i18n="farmer_mod_title">Farmer Module</div>
                                                    <div class="module-subtitle" data-i18n="farmer_mod_sub"><i class="fi fi-rr-leaf"></i> किसान — Kisan
                                                        Portal</div>
                                                        <p class="module-desc" data-i18n="farmer_mod_desc">Empowers farmers to manage produce, compare
                                                            market prices
                                                            using AI, and track orders & payments — all in one simple dashboard designed for ease of use.
                                                        </p>
                                                        <div class="module-features">
                                                            <div class="feature-item">
                                                                <div class="feature-dot"><i class="fi fi-rr-check"></i></div><span
                                                                data-i18n="mod_feat_ai">AI-powered Market Price Comparison</span>
                                                            </div>
                                                            <div class="feature-item">
                                                                <div class="feature-dot"><i class="fi fi-rr-check"></i></div><span
                                                                data-i18n="mod_feat_listing">Crop Listing & Order History Dashboard</span>
                                                            </div>
                                                            <div class="feature-item">
                                                                <div class="feature-dot"><i class="fi fi-rr-check"></i></div><span
                                                                data-i18n="mod_feat_payment">Payment Status & Analytics Tracking</span>
                                                            </div>
                                                            <div class="feature-item">
                                                                <div class="feature-dot"><i class="fi fi-rr-check"></i></div><span
                                                                data-i18n="mod_feat_weather">Weather Forecaster Integration</span>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- Vendor -->
                                                    <div class="module-card vendor reveal" style="transition-delay:0.1s">
                                                        <div class="module-icon-wrap">
                                                            <i class="fi fi-rr-shop" style="font-size: 32px;"></i>
                                                        </div>
                                                        <div class="module-title" data-i18n="vendor_mod_title">Vendor Module</div>
                                                        <div class="module-subtitle" data-i18n="vendor_mod_sub"><i class="fi fi-rr-shop"></i> व्यापारी —
                                                            Vyapari Portal</div>
                                                            <p class="module-desc" data-i18n="vendor_mod_desc">E-commerce-style experience for vendors to browse
                                                                quality-assured produce, place bulk orders, repeat past orders, and track every delivery in real
                                                                time.</p>
                                                                <div class="module-features">
                                                                    <div class="feature-item">
                                                                        <div class="feature-dot"><i class="fi fi-rr-check"></i></div><span
                                                                        data-i18n="mod_feat_catalog">Browse Catalog with Product Specifications</span>
                                                                    </div>
                                                                    <div class="feature-item">
                                                                        <div class="feature-dot"><i class="fi fi-rr-check"></i></div><span
                                                                        data-i18n="mod_feat_bulk">Bulk Order Cart & Quick Repeat Order</span>
                                                                    </div>
                                                                    <div class="feature-item">
                                                                        <div class="feature-dot"><i class="fi fi-rr-check"></i></div><span
                                                                        data-i18n="mod_feat_tracking">Real-time Delivery Tracking (Live)</span>
                                                                    </div>
                                                                    <div class="feature-item">
                                                                        <div class="feature-dot"><i class="fi fi-rr-check"></i></div><span
                                                                        data-i18n="mod_feat_billing">Integrated Payment Gateway & Billing</span>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </section>

                                                <!-- AI Features -->
                                                <section id="ai-features">
                                                    <div class="container">
                                                        <div class="ai-grid">
                                                            <!-- Visual Mock Dashboard -->
                                                            <div class="ai-visual reveal-left">
                                                                <div class="ai-dashboard-mock">
                                                                    <div class="ai-dash-header">
                                                                        <div class="ai-dash-title" data-i18n="ai_dash_title"><i class="fi fi-rr-bot"></i> AI Price
                                                                            Intelligence Dashboard</div>
                                                                            <div class="ai-dash-live">
                                                                                <div class="status-dot"></div>
                                                                                <span data-i18n="ai_dash_live">Live Data</span>
                                                                            </div>
                                                                        </div>

                                                                        <!-- Sparkline Chart -->
                                                                        <div class="ai-chart-area">
                                                                            <svg class="chart-svg" viewBox="0 0 400 130" preserveAspectRatio="none">
                                                                                <defs>
                                                                                    <linearGradient id="chartGrad" x1="0" y1="0" x2="0" y2="1">
                                                                                        <stop offset="0%" stop-color="#3b9434" stop-opacity="0.3" />
                                                                                        <stop offset="100%" stop-color="#3b9434" stop-opacity="0" />
                                                                                    </linearGradient>
                                                                                </defs>
                                                                                <path
                                                                                d="M0,100 C30,90 60,70 100,60 C130,52 160,80 200,55 C240,30 270,20 310,35 C340,46 370,30 400,20"
                                                                                fill="none" stroke="#3b9434" stroke-width="2.5" stroke-linecap="round" />
                                                                                <path
                                                                                d="M0,100 C30,90 60,70 100,60 C130,52 160,80 200,55 C240,30 270,20 310,35 C340,46 370,30 400,20 L400,130 L0,130 Z"
                                                                                fill="url(#chartGrad)" />
                                                                                <!-- Dots -->
                                                                                <circle cx="200" cy="55" r="5" fill="#3b9434" stroke="white" stroke-width="2" />
                                                                                <circle cx="310" cy="35" r="5" fill="#3b9434" stroke="white" stroke-width="2" />
                                                                                <circle cx="400" cy="20" r="5" fill="#52b34a" stroke="white" stroke-width="2" />
                                                                            </svg>
                                                                        </div>

                                                                        <!-- Crop Prices -->
                                                                        <div class="ai-crop-list">
                                                                            <div class="crop-row">
                                                                                <span class="crop-emoji">🍅</span>
                                                                                <span class="crop-name"><span data-i18n="ai_crop_tomato">Tomato</span> — <span
                                                                                    style="font-family:var(--font-hindi);font-weight:400;">टमाटर</span></span>
                                                                                    <span class="crop-trend up"><i class="fi fi-rr-stats"></i>+8.2%</span>
                                                                                    <span class="crop-price">₹24/kg</span>
                                                                                </div>
                                                                                <div class="crop-row">
                                                                                    <span class="crop-emoji">🧅</span>
                                                                                    <span class="crop-name"><span data-i18n="ai_crop_onion">Onion</span> — <span
                                                                                        style="font-family:var(--font-hindi);font-weight:400;">प्याज</span></span>
                                                                                        <span class="crop-trend down"><i class="fi fi-rr-arrow-trend-down"></i>-2.1%</span>
                                                                                        <span class="crop-price">₹18/kg</span>
                                                                                    </div>
                                                                                    <div class="crop-row">
                                                                                        <span class="crop-emoji">🥔</span>
                                                                                        <span class="crop-name"><span data-i18n="ai_crop_potato">Potato</span> — <span
                                                                                            style="font-family:var(--font-hindi);font-weight:400;">आलू</span></span>
                                                                                            <span class="crop-trend up"><i class="fi fi-rr-stats"></i>+3.5%</span>
                                                                                            <span class="crop-price">₹12/kg</span>
                                                                                        </div>
                                                                                        <div class="crop-row">
                                                                                            <span class="crop-emoji">🌽</span>
                                                                                            <span class="crop-name"><span data-i18n="ai_crop_maize">Maize</span> — <span
                                                                                                style="font-family:var(--font-hindi);font-weight:400;">मक्का</span></span>
                                                                                                <span class="crop-trend up"><i class="fi fi-rr-stats"></i>+5.7%</span>
                                                                                                <span class="crop-price">₹21/kg</span>
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>

                                                                                <!-- Content -->
                                                                                <div class="ai-content reveal-right">
                                                                                    <span class="section-badge badge-blue" data-i18n="ai_badge">AI Powered</span>
                                                                                    <h2 class="section-title" style="text-align:left;margin:12px 0 14px;" data-i18n="ai_title">Smart
                                                                                        Intelligence<br />for Every Decision</h2>
                                                                                        <p class="section-sub" style="text-align:left;max-width:100%;" data-i18n="ai_sub">FarmBridge uses AI
                                                                                            to
                                                                                            eliminate guesswork — whether it's pricing, demand forecasting, or discount optimization.
                                                                                            Data-driven
                                                                                            decisions for every farmer and vendor.</p>

                                                                                            <div class="ai-features-list">
                                                                                                <div class="ai-feat-item">
                                                                                                    <div class="ai-feat-icon green">
                                                                                                        <i class="fi fi-rr-chart-pie-alt"></i>
                                                                                                    </div>
                                                                                                    <div>
                                                                                                        <div class="ai-feat-title" data-i18n="ai_feat1_title">AI Market Price Prediction</div>
