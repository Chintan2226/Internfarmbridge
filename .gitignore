## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/

# Rider / VS Code
.idea/
.vscode/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# ASP.NET Core
appsettings.Development.json
appsettings.json

# Secrets
secrets.json

# IIS Express
iisexpress/
.vs/
*.dbmdl

# Entity Framework
*.edmx.diagram
*.edmx.sql

# SQL Server files
*.mdf
*.ldf

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# npm / node (if frontend assets used)
node_modules/
wwwroot/lib/

# Yarn
yarn.lock

# Package managers
packages/
*.nupkg
*.snupkg

# NuGet
project.lock.json
project.fragment.lock.json
artifacts/

# DotNet CLI
*.runtimeconfig.dev.json

# Publish output
publish/
*.publishproj

# Temporary files
*.tmp
*.temp

# Coverage reports
coverage/
*.coverage
*.coveragexml

# Resharper
_ReSharper*/
*.DotSettings.user

# Backup & old files
*.bak
*.backup
*.old

# Global JSON (optional)
global.json

# Docker
docker-compose.override.yml

# Certificates
*.pfx
*.cer

# JetBrains Rider
.idea/

# Mac files
*.DS_Store

# Windows files
ehthumbs.db
Desktop.ini*.pkl
